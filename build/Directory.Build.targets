<Project>
  <!-- cTrader.Automate derives the .algo file name from the parent directory of the
       project. With our flat build/<Name>/<Name>.csproj layout that would collide, so
       force the .algo name to match each project name instead. -->
  <PropertyGroup>
    <_AlgoRootDirectoryName>$(MSBuildProjectName)</_AlgoRootDirectoryName>
    <_AlgoFileName>$(MSBuildProjectName).algo</_AlgoFileName>
    <_AlgoFilePath>$(OutDir)$(_AlgoFileName)</_AlgoFilePath>
    <_AlgoMetadataFileName>$(_AlgoFileName).metadata</_AlgoMetadataFileName>
    <_AlgoMetadataFilePath>$(OutDir)$(_AlgoMetadataFileName)</_AlgoMetadataFilePath>
  </PropertyGroup>
</Project>
