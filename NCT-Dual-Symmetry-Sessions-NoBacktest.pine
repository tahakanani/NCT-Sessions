indicator("NCT - Dual Symmetry + Sessions (No Backtest)", shorttitle = "NCT+Sessions+FVG+MAP", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, dynamic_requests = true)

// ================================================================================================
// بخش الف: موتور NCT Dual Symmetry (سیمتری نودها + تارگت‌ها)
// ================================================================================================

// ================================================================================================
// بخش ۱: تعریف Structs و Types
// ================================================================================================
//#region ———————————————————— STRUCTS & TYPES

type Settings
    int    startPoint       = 5000
    int    endPoint         = 0
    bool   swCalcSymmetry   = true
    bool   swCalcLogarithm  = true
    string text_node_size   = "Normal"
    color  c1 = color.white
    color  c2 = color.yellow
    color  c3 = color.aqua
    color  c4 = color.lime
    color  c5 = color.orange
    color  c6 = color.fuchsia
    color  c7 = color.blue
    color  c8 = color.red
    bool   draw             = true

type Node
    int     indexPreNode
    int     indexNode
    int     indexCorrection
    int     numberNode
    float   lowPreNode
    float   highNode
    float   lowCorrection
    float   amountCorrection
    float   log_amountCorrection = 0.0
    bool    isSymmetrySetup      = false

type FvgGap
    float max = na
    float min = na
    bool  isbull = false
    int   t = na
    int   createdBar = 0

type Color
    color   labelColor

type NDS
    Settings     settings
    array<Node>  nodes
    array<Node>  nodesUp
    array<Node>  nodesDown
    array<Color> colors

    bool         swFirst              = true

    float        priceLowest_up       = 999999.0
    int          indexLowest_up       = 0
    float        priceHighest_up      = 0.0
    int          indexHighest_up      = 0

    float        priceLowest_down     = 999999.0
    int          indexLowest_down     = 0
    float        priceHighest_down    = 0.0
    int          indexHighest_down    = 0

//#endregion

// ================================================================================================
// بخش ۲: متدهای محاسبات سیمتری
// ================================================================================================
//#region ———————————————————— INTERNAL CORE METHODS

corrMag(Node n, bool useLog) => useLog ? n.log_amountCorrection : n.amountCorrection

method calcSymmetryNodesDown(series NDS this, int i, bool useLog) =>
    sizeNodes = this.nodesDown.size()
    output = false
    if i >= 3 and i < sizeNodes
        node          = this.nodesDown.get(i)
        prePreNode    = this.nodesDown.get(i-2)
        prePrePreNode = this.nodesDown.get(i-3)

        if prePreNode.numberNode == 2
            if corrMag(node, useLog) >= corrMag(prePreNode, useLog)
                if useLog
                    amountSymmetry = math.log(prePrePreNode.lowPreNode) - math.log(prePreNode.highNode)
                    minPrice       = math.log(prePreNode.lowCorrection) - amountSymmetry
                    if math.log(node.highNode) <= minPrice
                        output := true
                else
                    amountSymmetry = prePrePreNode.lowPreNode - prePreNode.highNode
                    minPrice       = prePreNode.lowCorrection - amountSymmetry
                    if node.highNode <= minPrice
                        output := true
    output

method calcSymmetryNodesUp(series NDS this, int i, bool useLog) =>
    sizeNodes = this.nodesUp.size()
    output = false
    if i >= 3 and i < sizeNodes
        node          = this.nodesUp.get(i)
        prePreNode    = this.nodesUp.get(i-2)
        prePrePreNode = this.nodesUp.get(i-3)

        if prePreNode.numberNode == 2
            if corrMag(node, useLog) >= corrMag(prePreNode, useLog)
                if useLog
                    amountSymmetry = math.log(prePreNode.highNode)   - math.log(prePrePreNode.lowPreNode)
                    maxPrice       = math.log(prePreNode.lowCorrection) + amountSymmetry
                    if math.log(node.highNode) >= maxPrice
                        output := true
                else
                    amountSymmetry = prePreNode.highNode      - prePrePreNode.lowPreNode
                    maxPrice       = prePreNode.lowCorrection + amountSymmetry
                    if node.highNode >= maxPrice
                        output := true
    output

//#endregion

// ================================================================================================
// بخش ۳: متدهای مرتب‌سازی گره‌ها
// ================================================================================================
//#region ———————————————————— SORT METHODS

method sortNodesDownTrend(series NDS this, bool useLog) =>
    i = this.nodesDown.size() - 1
    sw = false
    if this.nodesDown.size() > 0
        sw := true
    while sw
        node = this.nodesDown.get(i)
        if this.nodesDown.size() <= 1
            if node.lowCorrection >= node.lowPreNode
                this.nodesDown.remove(0)
            break
        preNode = this.nodesDown.get(i - 1)
        if node.lowCorrection < preNode.lowCorrection
            if corrMag(node, useLog) < corrMag(preNode, useLog)
                node.numberNode := 1
                this.nodesDown.set(i , node)
                break
            if corrMag(node, useLog) >= corrMag(preNode, useLog)
                if preNode.numberNode == 1
                    if this.settings.swCalcSymmetry == true
                        isSymmetry = this.calcSymmetryNodesDown(i, useLog)
                        if isSymmetry
                            prePrePreNode      = this.nodesDown.get(i - 3)
                            node.indexPreNode := prePrePreNode.indexPreNode
                            node.lowPreNode   := prePrePreNode.lowPreNode
                            node.numberNode   := 1
                            node.isSymmetrySetup := true
                            this.nodesDown.set(i , node)
                            this.nodesDown.remove(i - 1)
                            this.nodesDown.remove(i - 2)
                            this.nodesDown.remove(i - 3)
                            i := i - 3
                            continue
                    node.numberNode := 2
                    this.nodesDown.set(i , node)
                    break
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesDown.get(i - 2).indexPreNode
                    node.lowPreNode := this.nodesDown.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesDown.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    this.nodesDown.remove(i - 2)
                    i := i - 2
                    continue
        else if node.lowCorrection >= preNode.lowCorrection
            if node.highNode > preNode.highNode
                node.indexPreNode     := preNode.indexPreNode
                node.indexNode        := preNode.indexNode
                node.highNode         := preNode.highNode
                node.lowPreNode       := preNode.lowPreNode
                amountCorrection       = node.lowCorrection - node.highNode
                node.amountCorrection := amountCorrection
                if useLog
                    node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
                node.numberNode       := preNode.numberNode
                node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                this.nodesDown.set(i , node)
                this.nodesDown.remove(i - 1)
                i := i - 1
                continue
            if node.highNode <= preNode.highNode
                if preNode.numberNode == 1
                    node.numberNode      := 1
                    node.indexPreNode    := preNode.indexPreNode
                    node.lowPreNode      := preNode.lowPreNode
                    node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    i := i - 1
                    continue
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesDown.get(i - 2).indexPreNode
                    node.lowPreNode   := this.nodesDown.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesDown.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    this.nodesDown.remove(i - 2)
                    i := i - 2
                    continue

method sortNodesUpTrend(series NDS this, bool useLog) =>
    i = this.nodesUp.size() - 1
    sw = false
    if this.nodesUp.size() > 0
        sw := true
    while sw
        node = this.nodesUp.get(i)
        if this.nodesUp.size() <= 1
            if node.lowCorrection <= node.lowPreNode
                this.nodesUp.remove(0)
            break
        preNode = this.nodesUp.get(i - 1)
        if node.lowCorrection > preNode.lowCorrection
            if corrMag(node, useLog) < corrMag(preNode, useLog)
                node.numberNode := 1
                this.nodesUp.set(i , node)
                break
            if corrMag(node, useLog) >= corrMag(preNode, useLog)
                if preNode.numberNode == 1
                    if this.settings.swCalcSymmetry == true
                        isSymmetry = this.calcSymmetryNodesUp(i, useLog)
                        if isSymmetry
                            prePrePreNode      = this.nodesUp.get(i - 3)
                            node.indexPreNode := prePrePreNode.indexPreNode
                            node.lowPreNode   := prePrePreNode.lowPreNode
                            node.numberNode   := 1
                            node.isSymmetrySetup := true
                            this.nodesUp.set(i , node)
                            this.nodesUp.remove(i - 1)
                            this.nodesUp.remove(i - 2)
                            this.nodesUp.remove(i - 3)
                            i := i - 3
                            continue
                    node.numberNode := 2
                    this.nodesUp.set(i , node)
                    break
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesUp.get(i - 2).indexPreNode
                    node.lowPreNode := this.nodesUp.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesUp.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    this.nodesUp.remove(i - 2)
                    i := i - 2
                    continue
        else if node.lowCorrection <= preNode.lowCorrection
            if node.highNode < preNode.highNode
                node.indexPreNode     := preNode.indexPreNode
                node.indexNode        := preNode.indexNode
                node.highNode         := preNode.highNode
                node.lowPreNode       := preNode.lowPreNode
                node.amountCorrection := node.highNode - node.lowCorrection
                if useLog
                    node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
                node.numberNode       := preNode.numberNode
                node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                this.nodesUp.set(i , node)
                this.nodesUp.remove(i - 1)
                i := i - 1
                continue
            if node.highNode >= preNode.highNode
                if preNode.numberNode == 1
                    node.numberNode      := 1
                    node.indexPreNode    := preNode.indexPreNode
                    node.lowPreNode      := preNode.lowPreNode
                    node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    i := i - 1
                    continue
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesUp.get(i - 2).indexPreNode
                    node.lowPreNode   := this.nodesUp.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesUp.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    this.nodesUp.remove(i - 2)
                    i := i - 2
                    continue

//#endregion

// ================================================================================================
// بخش ۴: متدهای ایجاد و به‌روزرسانی گره‌ها
// ================================================================================================
//#region ———————————————————— NODE CREATION & UPDATE

method SetNode_UpTrend(series NDS this) =>
    numberNode       = 1
    indexPreNode     = this.indexLowest_up
    indexNode        = this.indexHighest_up
    indexCorrection  = bar_index
    lowPreNode       = this.priceLowest_up
    highNode         = this.priceHighest_up
    lowCorrection    = low[0]
    amountCorrection = highNode - lowCorrection
    log_amountCorrection = math.log(highNode) - math.log(lowCorrection)
    Node node = Node.new(indexPreNode, indexNode, indexCorrection, numberNode, lowPreNode, highNode, lowCorrection, amountCorrection, log_amountCorrection, false)
    this.nodesUp.push(node)

    this.sortNodesUpTrend(this.settings.swCalcLogarithm)
    this.priceHighest_up := low[0]
    this.indexHighest_up := bar_index

method SetNode_DownTrend(series NDS this) =>
    numberNode       = 1
    indexPreNode     = this.indexHighest_down
    indexNode        = this.indexLowest_down
    indexCorrection  = bar_index
    lowPreNode       = this.priceHighest_down
    highNode         = this.priceLowest_down
    lowCorrection    = high[0]
    amountCorrection = lowCorrection - highNode
    log_amountCorrection = math.log(lowCorrection) - math.log(highNode)
    Node node = Node.new(indexPreNode, indexNode, indexCorrection, numberNode, lowPreNode, highNode, lowCorrection, amountCorrection, log_amountCorrection, false)
    this.nodesDown.push(node)

    this.sortNodesDownTrend(this.settings.swCalcLogarithm)
    this.priceLowest_down := high[0]
    this.indexLowest_down := bar_index

method CalcNode_UpTrend(series NDS this) =>
    if low[0] < this.priceLowest_up
        this.priceLowest_up := low[0]
        this.indexLowest_up := bar_index
    if high[0] > this.priceHighest_up
        this.priceHighest_up := high[0]
        this.indexHighest_up := bar_index

    sizeNodes = this.nodesUp.size()
    if sizeNodes > 0
        node = this.nodesUp.last()
        if low[0] <= node.lowCorrection
            node.lowCorrection    := low[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.highNode - node.lowCorrection
            node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
            this.nodesUp.set(sizeNodes-1 , node)
            this.sortNodesUpTrend(this.settings.swCalcLogarithm)
        else if open[0] > close[0] and open[1] > close[1]
            if high[0] >= node.highNode
                node.highNode  := high[0]
                node.indexNode := bar_index
            if low[0] < low[1]
                node.lowCorrection    := low[0]
                node.indexCorrection  := bar_index
            node.amountCorrection := node.highNode - node.lowCorrection
            node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
            this.nodesUp.set(sizeNodes-1 , node)
            this.sortNodesUpTrend(this.settings.swCalcLogarithm)
            this.indexLowest_up     := this.nodesUp.last().indexCorrection
            this.priceLowest_up     := low[bar_index - this.indexLowest_up]

    isNode = false
    if open[0] > close[0]
        isNode := true
    if isNode
        sizeNodes := this.nodesUp.size()
        if sizeNodes == 0
            this.SetNode_UpTrend()
        else if sizeNodes > 0
            this.indexLowest_up     := this.nodesUp.last().indexCorrection
            this.priceLowest_up     := low[bar_index - this.indexLowest_up]
            this.SetNode_UpTrend()

method CalcNode_DownTrend(series NDS this) =>
    if low[0] < this.priceLowest_down
        this.priceLowest_down := low[0]
        this.indexLowest_down := bar_index
    if high[0] > this.priceHighest_down
        this.priceHighest_down := high[0]
        this.indexHighest_down := bar_index

    sizeNodes = this.nodesDown.size()
    if sizeNodes > 0
        node = this.nodesDown.last()
        if high[0] >= node.lowCorrection
            node.lowCorrection    := high[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.lowCorrection - node.highNode
            node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
            this.nodesDown.set(sizeNodes-1 , node)
            this.sortNodesDownTrend(this.settings.swCalcLogarithm)
        else if open[0] < close[0] and open[1] < close[1]
            if low[0] <= node.highNode
                node.highNode  := low[0]
                node.indexNode := bar_index
            node.lowCorrection    := high[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.lowCorrection - node.highNode
            node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
            this.nodesDown.set(sizeNodes-1 , node)
            this.sortNodesDownTrend(this.settings.swCalcLogarithm)

    isNode = false
    if open[0] < close[0]
        isNode := true
    if isNode
        sizeNodes := this.nodesDown.size()
        if sizeNodes == 0
            this.SetNode_DownTrend()
        else if sizeNodes > 0
            this.indexHighest_down     := this.nodesDown.last().indexCorrection
            this.priceHighest_down     := high[bar_index - this.indexHighest_down]
            this.SetNode_DownTrend()

//#endregion

// ================================================================================================
// بخش ۵: متدهای رسم و نمایش
// ================================================================================================
//#region ———————————————————— DRAWING METHODS

var g_labels = array.new<label>()
var g_lines  = array.new<line>()
var g_boxes  = array.new<box>()

// Leave headroom under TradingView hard caps (500)
MAX_DRAW_LINES   = 480
MAX_DRAW_LABELS  = 480
MAX_DRAW_BOXES   = 480
MAX_HIT_LOOKBACK = 2000
MAX_ROUND_LEVELS = 40

// Hit-check cache: build once per redraw, then O(1) per target
var array<float> g_hitSufMaxHigh = array.new<float>()
var array<float> g_hitSufMinLow = array.new<float>()
var array<int> g_hitWin = array.from(0, -1)  // [start, end]

prepareHitWindow(int hitGraceBars) =>
    g_hitSufMaxHigh.clear()
    g_hitSufMinLow.clear()
    g_hitWin.set(0, 0)
    g_hitWin.set(1, -1)
    int lastCheckBar = bar_index - hitGraceBars - 1
    if lastCheckBar >= 0
        int fromBar = math.max(0, lastCheckBar - MAX_HIT_LOOKBACK + 1)
        int n = lastCheckBar - fromBar + 1
        if n > 0
            g_hitWin.set(0, fromBar)
            g_hitWin.set(1, lastCheckBar)
            array<float> highs = array.new<float>(n)
            array<float> lows = array.new<float>(n)
            for i = 0 to n - 1
                int off = bar_index - (fromBar + i)
                highs.set(i, high[off])
                lows.set(i, low[off])
            float runMax = na
            float runMin = na
            array<float> sufMax = array.new<float>(n)
            array<float> sufMin = array.new<float>(n)
            for i = n - 1 to 0
                float h = highs.get(i)
                float l = lows.get(i)
                runMax := na(runMax) ? h : math.max(runMax, h)
                runMin := na(runMin) ? l : math.min(runMin, l)
                sufMax.set(i, runMax)
                sufMin.set(i, runMin)
            for i = 0 to n - 1
                g_hitSufMaxHigh.push(sufMax.get(i))
                g_hitSufMinLow.push(sufMin.get(i))

canDrawLine() =>
    g_lines.size() < MAX_DRAW_LINES

canDrawLabel() =>
    g_labels.size() < MAX_DRAW_LABELS

canDrawBox() =>
    g_boxes.size() < MAX_DRAW_BOXES

trackLabel(label lbl) =>
    if canDrawLabel()
        g_labels.push(lbl)
    else
        label.delete(lbl)

trackLine(line ln) =>
    if canDrawLine()
        g_lines.push(ln)
    else
        line.delete(ln)

trackBox(box b) =>
    if canDrawBox()
        g_boxes.push(b)
    else
        box.delete(b)


clearDrawings() =>
    while g_labels.size() > 0
        label.delete(g_labels.pop())
    while g_lines.size() > 0
        line.delete(g_lines.pop())
    while g_boxes.size() > 0
        box.delete(g_boxes.pop())

// Fast hit check using prebuilt suffix max/min (same result as old per-target loop)
shouldDeleteHitTarget(float price, int startIdx, bool isUp, bool deleteHit, int hitGraceBars) =>
    bool result = false
    int winStart = g_hitWin.get(0)
    int winEnd = g_hitWin.get(1)
    if deleteHit and not na(price) and startIdx <= bar_index and winEnd >= winStart and g_hitSufMaxHigh.size() > 0
        if winEnd >= startIdx
            int fromBar = math.max(startIdx, winStart)
            int idx = fromBar - winStart
            if idx >= 0 and idx < g_hitSufMaxHigh.size()
                result := isUp ? g_hitSufMaxHigh.get(idx) >= price : g_hitSufMinLow.get(idx) <= price
    result

// --- آرایه‌های جلوگیری از تداخل لیبل‌ها: صعود / نزول / سایر جدا هستند ---
var g_stagUpPrice = array.new<float>()
var g_stagUpX     = array.new<int>()
var g_stagDnPrice = array.new<float>()
var g_stagDnX     = array.new<int>()
var g_stagOtPrice = array.new<float>()
var g_stagOtX     = array.new<int>()

// --- ورودی‌های تنظیم تداخل لیبل‌ها ---
var GRP_LBL = "Target Label Anti-Overlap"
targetLabelPriceTolerancePct = input.float(1.5, 'Label Collision Tolerance (%)', minval = 0.001, maxval = 10, step = 0.05, group = GRP_LBL, tooltip = 'اگر دو لیبل هم‌مسیر (صعود یا نزول) از نظر قیمت نزدیک باشند، یکی به راست جابه‌جا می‌شود')
targetLabelStaggerStep = input.int(40, 'Label Stagger Step (bars)', minval = 4, maxval = 200, group = GRP_LBL, tooltip = 'فاصلهٔ افقی هر لیبل متداخل به سمت راست')
targetLabelYOffsetPct = input.float(0.01, 'Label Height Above Line (%)', minval = 0.0, maxval = 2.0, step = 0.01, group = GRP_LBL, tooltip = 'فاصلهٔ عمودی نوشته بالای خط؛ با گام ۰.۰۱ قابل تنظیم است (مثلاً ۰.۰۱ یا ۰.۰۲)')
targetLabelSize = input.string('Small', 'Target Label Font Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP_LBL, tooltip = 'اندازه فونت نوشته روی همه تارگت‌ها (نود، زوج، رند، سشن، Day OC، MAP Weekly)')

// lane: 0 = صعود (H)، 1 = نزول (L)، 2 = سایر (سشن/MAP/Day)
getStaggerX(float price, int baseX, int lane) =>
    array<float> prices = lane == 0 ? g_stagUpPrice : lane == 1 ? g_stagDnPrice : g_stagOtPrice
    array<int> xs = lane == 0 ? g_stagUpX : lane == 1 ? g_stagDnX : g_stagOtX
    int maxX = bar_index + 490
    int x = math.min(math.max(baseX, bar_index), maxX)
    bool collision = true
    int guard = 0
    while collision and guard < 80
        collision := false
        n = xs.size()
        if n > 0
            for i = 0 to n - 1
                int ox = xs.get(i)
                if math.abs(ox - x) < targetLabelStaggerStep
                    p = prices.get(i)
                    refP = math.max(math.abs(p), 0.0000001)
                    diffPct = math.abs(p - price) / refP * 100.0
                    // فقط لیبل‌های هم‌مسیر با قیمت نزدیک جابه‌جا می‌شوند
                    if diffPct <= targetLabelPriceTolerancePct
                        collision := true
                        break
        if collision
            x := math.min(x + targetLabelStaggerStep, maxX)
        guard += 1
    prices.push(price)
    xs.push(x)
    x

resetLabelStagger() =>
    g_stagUpPrice.clear()
    g_stagUpX.clear()
    g_stagDnPrice.clear()
    g_stagDnX.clear()
    g_stagOtPrice.clear()
    g_stagOtX.clear()

method initColor(series NDS this) =>
    this.colors.push(Color.new(this.settings.c1))
    this.colors.push(Color.new(this.settings.c2))
    this.colors.push(Color.new(this.settings.c3))
    this.colors.push(Color.new(this.settings.c4))
    this.colors.push(Color.new(this.settings.c5))
    this.colors.push(Color.new(this.settings.c6))
    this.colors.push(Color.new(this.settings.c7))
    this.colors.push(Color.new(this.settings.c8))

textSizeFromString(string s) =>
    switch s
        'Auto'   => size.auto
        'Huge'   => size.huge
        'Large'  => size.large
        'Normal' => size.normal
        'Small'  => size.small
        => size.tiny

// نقطهٔ شروع لیبل = وسطِ بازه از کندل جاری تا انتهای خط
targetLabelBaseX(int gapBars) =>
    int(bar_index + math.max(gapBars / 2, 8))

// Y لیبل کمی بالاتر از قیمت خط؛ دقیقاً بر اساس درصد تنظیم‌شده (گام ۰.۰۱)
labelYAboveLine(float price) =>
    price + math.abs(price) * targetLabelYOffsetPct / 100.0

styleFromString(string s) =>
    s == 'Solid' ? line.style_solid : s == 'Dashed' ? line.style_dashed : line.style_dotted

// lane: 0 صعود، 1 نزول، 2 سایر — خط تا محل لیبل ادامه دارد؛ نوشته بالای خط
drawTargetLineLabel(int startIdx, float price, color lineCol, int width, string styleStr, int transp, string txt, int gapBars, int lane) =>
    if not na(price) and canDrawLine()
        int baseX = targetLabelBaseX(gapBars)
        int lblX = getStaggerX(price, baseX, lane)
        int endIdx = math.max(bar_index + gapBars, lblX)
        trackLine(line.new(chart.point.from_index(startIdx, price), chart.point.from_index(endIdx, price), color = color.new(lineCol, transp), width = width, style = styleFromString(styleStr)))
        if canDrawLabel()
            trackLabel(label.new(x = lblX, y = labelYAboveLine(price), text = txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lineCol, size = textSizeFromString(targetLabelSize)))

method drawingNumberNodes(series NDS this, bool swUptrendType, string suffix, int extraGapLines, bool showRegularNodes, bool showDoubleStarNodes) =>
    array<Node> nodesRef = array.new<Node>()
    var locText = yloc.belowbar
    if swUptrendType
        locText := yloc.abovebar
        nodesRef := this.nodesUp
    else
        nodesRef := this.nodesDown

    text_node_size_opt = this.settings.text_node_size
    indexColor = 0
    countNodes = nodesRef.size()

    gapPrefix = ""
    if extraGapLines > 0
        for g = 1 to extraGapLines
            gapPrefix := gapPrefix + "\n"

    if countNodes > 0
        for i = 0 to countNodes - 1
            node = nodesRef.get(i)
            index = node.indexNode
            numberNode  = node.numberNode
            textColor = this.colors.get(indexColor).labelColor
            // Symmetry nodes display as single-star (*)
            string baseText = str.tostring(numberNode) + suffix
            string newText = baseText
            if i > 0
                if nodesRef.get(i - 1).indexNode == node.indexNode
                    newText := '     ' + newText
            if node.isSymmetrySetup
                newText := gapPrefix + newText

            shouldDraw = node.isSymmetrySetup ? showDoubleStarNodes : showRegularNodes
            if shouldDraw and canDrawLabel()
                lbl = label.new(x = index, y = na, text = newText, yloc = locText, style = label.style_none, color = color.new(color.white, 100), textcolor = textColor, size = textSizeFromString(text_node_size_opt))
                trackLabel(lbl)

            if i == countNodes - 1
                break
            nextNumberNode = nodesRef.get(i+1).numberNode
            if nextNumberNode == 1
                indexColor := indexColor + 1
            if indexColor == 8
                indexColor := 1

method computeNodeColors(series NDS this, array<Node> nodesRef) =>
    countNodes = nodesRef.size()
    array<color> result = array.new<color>(countNodes)
    indexColor = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            result.set(i, this.colors.get(indexColor).labelColor)
            if i == countNodes - 1
                break
            nextNumberNode = nodesRef.get(i+1).numberNode
            if nextNumberNode == 1
                indexColor := indexColor + 1
            if indexColor == 8
                indexColor := 1
    result

method drawingLineNodes(series NDS this) =>
    lineWidth  = 2

    sizeNodesUp = this.nodesUp.size()
    if sizeNodesUp > 0
        colorsUp = this.computeNodeColors(this.nodesUp)
        for i= 0 to sizeNodesUp - 1
            node = this.nodesUp.get(i)
            lineColor = colorsUp.get(i)
            firstPoint  = chart.point.from_index(node.indexPreNode ,node.lowPreNode)
            secondPoint = chart.point.from_index(node.indexNode    ,node.highNode)
            thirdPoint  = chart.point.from_index(node.indexCorrection ,node.lowCorrection)
            trackLine(line.new(firstPoint, secondPoint ,color = lineColor  ,width = lineWidth ))
            trackLine(line.new(secondPoint, thirdPoint ,color = lineColor ,width = lineWidth ))

    sizeNodesDown = this.nodesDown.size()
    if sizeNodesDown > 0
        colorsDown = this.computeNodeColors(this.nodesDown)
        for i= 0 to sizeNodesDown - 1
            node = this.nodesDown.get(i)
            lineColor = colorsDown.get(i)
            firstPoint  = chart.point.from_index(node.indexPreNode ,node.lowPreNode)
            secondPoint = chart.point.from_index(node.indexNode    ,node.highNode)
            thirdPoint  = chart.point.from_index(node.indexCorrection ,node.lowCorrection)
            trackLine(line.new(firstPoint, secondPoint ,color = lineColor  ,width = lineWidth ))
            trackLine(line.new(secondPoint, thirdPoint ,color = lineColor ,width = lineWidth ))

// ================================================================================================
// تارگت‌های نود ۱ (Double + Double0.86 + Min + Correction)
// ================================================================================================
method drawingTargetsNode1(series NDS this, bool swUptrendType, bool showDouble, bool showDouble15, bool showDouble086, bool showMin, bool showCorrection, int doubleWidth, int double15Width, int double086Width, int minWidth, int correctionWidth, string doubleStyle, string double15Style, string double086Style, string minStyle, string correctionStyle, int maxCount, int gapBars, bool deleteHit, int hitGraceBars, int lineTransparency, float double086Ratio, float double15Ratio) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    trendPrefix = swUptrendType ? "H " : "L "
    int lane = swUptrendType ? 0 : 1
    countNodes = nodesRef.size()

    colorPerIndex = this.computeNodeColors(nodesRef)

    array<bool> qualifies = array.new<bool>(countNodes)
    qualifyingTotal = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            node = nodesRef.get(i)
            isQualified = node.numberNode == 1
            qualifies.set(i, isQualified)
            if isQualified
                qualifyingTotal += 1

    skipCount = math.max(qualifyingTotal - maxCount, 0)
    seen = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            if qualifies.get(i)
                seen += 1
                if seen > skipCount
                    if not canDrawLine() or not canDrawLabel()
                        break
                    node = nodesRef.get(i)
                    lineColor = colorPerIndex.get(i)
                    moveSizeLog       = math.abs(math.log(node.highNode) - math.log(node.lowPreNode))
                    correctionSizeLog = math.abs(math.log(node.highNode) - math.log(node.lowCorrection))

                    if showDouble
                        targetDoublePrice = swUptrendType ? math.exp(math.log(node.highNode) + moveSizeLog) : math.exp(math.log(node.highNode) - moveSizeLog)
                        bool shouldDelete = shouldDeleteHitTarget(targetDoublePrice, node.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node.indexNode, targetDoublePrice, lineColor, doubleWidth, doubleStyle, lineTransparency, trendPrefix + "Double 1", gapBars, lane)

                    // اگر برای این نود ۱، نود ۲ تشکیل شده باشد، تارگت‌های 1.5 و 0.86 لازم نیستند
                    bool hasNode2 = i + 1 < countNodes and nodesRef.get(i + 1).numberNode == 2

                    if showDouble15 and not hasNode2
                        targetDouble15Price = swUptrendType ? math.exp(math.log(node.highNode) + moveSizeLog * double15Ratio) : math.exp(math.log(node.highNode) - moveSizeLog * double15Ratio)
                        bool shouldDelete15 = shouldDeleteHitTarget(targetDouble15Price, node.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete15
                            drawTargetLineLabel(node.indexNode, targetDouble15Price, lineColor, double15Width, double15Style, lineTransparency, trendPrefix + "1.5DOUBLE1", gapBars, lane)

                    if showDouble086 and not hasNode2
                        float startNode1 = node.lowPreNode
                        float doubleEnd = swUptrendType ? math.exp(math.log(node.highNode) + moveSizeLog) : math.exp(math.log(node.highNode) - moveSizeLog)
                        targetDouble086Price = math.exp(math.log(startNode1) + double086Ratio * (math.log(doubleEnd) - math.log(startNode1)))
                        bool shouldDelete086 = shouldDeleteHitTarget(targetDouble086Price, node.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete086
                            drawTargetLineLabel(node.indexPreNode, targetDouble086Price, lineColor, double086Width, double086Style, lineTransparency, trendPrefix + "D " + str.tostring(double086Ratio, "#.##"), gapBars, lane)

                    if showMin
                        targetMinPrice = swUptrendType ? math.exp(math.log(node.lowCorrection) + moveSizeLog) : math.exp(math.log(node.lowCorrection) - moveSizeLog)
                        bool shouldDelete = shouldDeleteHitTarget(targetMinPrice, node.indexCorrection, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node.indexNode, targetMinPrice, lineColor, minWidth, minStyle, lineTransparency, trendPrefix + "Min 1", gapBars, lane)

                    if showCorrection
                        targetCorrectionPrice = swUptrendType ? math.exp(math.log(node.highNode) + correctionSizeLog) : math.exp(math.log(node.highNode) - correctionSizeLog)
                        bool shouldDelete = shouldDeleteHitTarget(targetCorrectionPrice, node.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node.indexNode, targetCorrectionPrice, lineColor, correctionWidth, correctionStyle, lineTransparency, trendPrefix + "Correction 1", gapBars, lane)

// ================================================================================================
// تارگت نود ۲ (Node 2 Target): اندازه حرکت نود ۲ از انتهای اصلاح همان نود
// ================================================================================================
method drawingTargetsNode2(series NDS this, bool swUptrendType, bool showNode2, int node2Width, string node2Style, int maxCount, int gapBars, bool deleteHit, int hitGraceBars, int lineTransparency) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    trendPrefix = swUptrendType ? "H " : "L "
    int lane = swUptrendType ? 0 : 1
    countNodes = nodesRef.size()

    colorPerIndex = this.computeNodeColors(nodesRef)

    array<bool> qualifies = array.new<bool>(countNodes)
    qualifyingTotal = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            node = nodesRef.get(i)
            isQualified = node.numberNode == 2
            qualifies.set(i, isQualified)
            if isQualified
                qualifyingTotal += 1

    skipCount = math.max(qualifyingTotal - maxCount, 0)
    seen = 0
    if countNodes > 0 and showNode2
        for i = 0 to countNodes - 1
            if qualifies.get(i)
                seen += 1
                if seen > skipCount
                    if not canDrawLine() or not canDrawLabel()
                        break
                    node = nodesRef.get(i)
                    lineColor = colorPerIndex.get(i)
                    moveSizeLog2 = math.abs(math.log(node.highNode) - math.log(node.lowPreNode))
                    targetNode2Price = swUptrendType ? math.exp(math.log(node.lowCorrection) + moveSizeLog2) : math.exp(math.log(node.lowCorrection) - moveSizeLog2)
                    bool shouldDelete = shouldDeleteHitTarget(targetNode2Price, node.indexCorrection, swUptrendType, deleteHit, hitGraceBars)
                    if not shouldDelete
                        drawTargetLineLabel(node.indexNode, targetNode2Price, lineColor, node2Width, node2Style, lineTransparency, trendPrefix + "Node 2", gapBars, lane)

// ================================================================================================
// تارگت‌های زوج نود ۱ و ۲ مرتبط به هم (Node1+Node2 Pair Targets)
// ================================================================================================
method drawingPairTargetsNode12(series NDS this, bool swUptrendType, bool showMin, bool showMax, bool showDouble, bool showCorrection, int minWidth, int maxWidth, int doubleWidth, int correctionWidth, string minStyle, string maxStyle, string doubleStyle, string correctionStyle, int maxCount, int gapBars, bool deleteHit, int hitGraceBars, int lineTransparency) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    trendPrefix = swUptrendType ? "H " : "L "
    int lane = swUptrendType ? 0 : 1
    countNodes = nodesRef.size()

    colorPerIndex = this.computeNodeColors(nodesRef)

    array<bool> isPairStart = array.new<bool>(countNodes)
    pairTotal = 0
    if countNodes > 1
        for i = 0 to countNodes - 2
            node1c = nodesRef.get(i)
            node2c = nodesRef.get(i+1)
            valid  = node1c.numberNode == 1 and node2c.numberNode == 2
            isPairStart.set(i, valid)
            if valid
                pairTotal += 1

    skipCount = math.max(pairTotal - maxCount, 0)
    seen = 0
    if countNodes > 1
        for i = 0 to countNodes - 2
            if isPairStart.get(i)
                seen += 1
                if seen > skipCount
                    if not canDrawLine() or not canDrawLabel()
                        break
                    node1 = nodesRef.get(i)
                    node2 = nodesRef.get(i+1)
                    lineColor = colorPerIndex.get(i)
                    totalMoveLog = math.abs(math.log(node2.highNode) - math.log(node1.lowPreNode))

                    if showMin
                        minPrice = swUptrendType ? math.exp(math.log(node1.lowCorrection) + totalMoveLog) : math.exp(math.log(node1.lowCorrection) - totalMoveLog)
                        bool shouldDelete = shouldDeleteHitTarget(minPrice, node1.indexCorrection, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node1.indexNode, minPrice, lineColor, minWidth, minStyle, lineTransparency, trendPrefix + "Min 12", gapBars, lane)

                    if showMax
                        maxPrice = swUptrendType ? math.exp(math.log(node2.lowCorrection) + totalMoveLog) : math.exp(math.log(node2.lowCorrection) - totalMoveLog)
                        bool shouldDelete = shouldDeleteHitTarget(maxPrice, node2.indexCorrection, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node2.indexNode, maxPrice, lineColor, maxWidth, maxStyle, lineTransparency, trendPrefix + "Max 12", gapBars, lane)

                    if showDouble
                        dblPrice = swUptrendType ? math.exp(math.log(node2.highNode) + totalMoveLog) : math.exp(math.log(node2.highNode) - totalMoveLog)
                        bool shouldDelete = shouldDeleteHitTarget(dblPrice, node2.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node2.indexNode, dblPrice, lineColor, doubleWidth, doubleStyle, lineTransparency, trendPrefix + "Double 12", gapBars, lane)

                    if showCorrection
                        correctionSizeLog2 = math.abs(math.log(node2.highNode) - math.log(node2.lowCorrection))
                        corrPrice12 = swUptrendType ? math.exp(math.log(node2.highNode) + correctionSizeLog2) : math.exp(math.log(node2.highNode) - correctionSizeLog2)
                        bool shouldDelete = shouldDeleteHitTarget(corrPrice12, node2.indexNode, swUptrendType, deleteHit, hitGraceBars)
                        if not shouldDelete
                            drawTargetLineLabel(node2.indexNode, corrPrice12, lineColor, correctionWidth, correctionStyle, lineTransparency, trendPrefix + "Correction 2", gapBars, lane)

//#endregion

// ================================================================================================
// بخش ۵-ج: تارگت‌های قیمت رند (Round Number / Psychological Levels)
// ================================================================================================
//#region ———————————————————— ROUND NUMBER TARGETS

drawRoundNumberTargets(float basePrice, bool isUp, int gapBars, bool deleteHit, int hitGraceBars, int lineWidth, string lineStyleStr, int lineTransparency, color lineColor, float minVisiblePrice, int historyBars, bool drawVisual) =>
    if basePrice > 0
        int lookback = math.min(historyBars, bar_index)
        float chartLow  = lookback > 0 ? ta.lowest(low, lookback + 1) : low[0]
        float chartHigh = lookback > 0 ? ta.highest(high, lookback + 1) : high[0]
        float effectiveMin = minVisiblePrice > 0 ? math.max(minVisiblePrice, chartLow) : chartLow
        float effectiveMax = chartHigh

        int startMult = math.floor(effectiveMin / basePrice)
        int endMult   = math.ceil(effectiveMax / basePrice)
        if startMult < 1
            startMult := 1

        lnStyle = lineStyleStr == 'Solid' ? line.style_solid : lineStyleStr == 'Dashed' ? line.style_dashed : line.style_dotted
        trendPrefix = isUp ? "H " : "L "
        // مثل بقیه تارگت‌ها: خط از کندل جاری به جلو (نه به تاریخ گذشته)
        int lineStartIdx = bar_index
        int lineEndIdx = bar_index + gapBars

        if endMult >= startMult
            int totalLevels = endMult - startMult + 1
            if totalLevels > MAX_ROUND_LEVELS
                int mid = int((startMult + endMult) / 2)
                int half = int(MAX_ROUND_LEVELS / 2)
                startMult := math.max(1, mid - half)
                endMult := startMult + MAX_ROUND_LEVELS - 1
            for mult = startMult to endMult
                if not canDrawLine() or not canDrawLabel()
                    break
                float roundPrice = basePrice * mult
                int roundStartIdx = math.max(bar_index - lookback, 0)
                bool shouldDelete = shouldDeleteHitTarget(roundPrice, roundStartIdx, isUp, deleteHit, hitGraceBars)

                if not shouldDelete
                    if drawVisual
                        drawTargetLineLabel(lineStartIdx, roundPrice, lineColor, lineWidth, lineStyleStr, lineTransparency, trendPrefix + "RN " + str.tostring(roundPrice, "#.####"), gapBars, isUp ? 0 : 1)

//#endregion

//#region ———————————————————— INIT & ENGINE

method initFirst(series NDS this) =>
    if this.swFirst == true
        this.initColor()
        this.swFirst := false

method calc(series NDS this) =>
    min = last_bar_index - this.settings.startPoint
    max = last_bar_index - this.settings.endPoint + 1

    if bar_index > min and bar_index <= max and bar_index > 1
        this.initFirst()
        this.CalcNode_UpTrend()
        this.CalcNode_DownTrend()

newInstance(Settings settings) =>
    NDS result = NDS.new(settings, array.new<Node>(), array.new<Node>(), array.new<Node>(), colors = array.new<Color>())
    result

//#endregion

// ================================================================================================
// بخش ۷: ورودی‌های کاربر
// ================================================================================================
//#region ———————————————————— INPUTS

var GRP2 = "Nodal Calculation Settings"
startPointInput = input.int(5000, 'Starting Point Candles', minval = 1 , maxval = 5000 , inline = "12", group = GRP2)
endPointInput   = input.int(0, 'End Point (Final)', group = GRP2, minval = 0 , maxval = 5000)

var GRP1 = "Strategy Config"
swCalcLogarithm = input.bool(true, 'Calc Nodes with Logarithm' , group = GRP1, tooltip = 'فقط روی محاسبه‌ی خودِ نودها و سیمتری اثر دارد. تارگت‌ها همیشه بر حسب لگاریتم محاسبه می‌شوند.')
nodeDisplayMode = input.string('Starred', 'Node Display Mode', options = ['Starred', 'Starless'], group = GRP1, tooltip = 'Starred = فقط موتور سیمتری (cNodeSym). Starless = فقط موتور بدون سیمتری (cNodeNoSym). هم‌زمان اجرا نمی‌شوند.')
verticalGapInput = input.int(0, 'Vertical Gap: Symmetry vs No-Symmetry (lines)', minval = 0, maxval = 15, group = GRP1, tooltip = "تعداد خط خالی فاصله عمودی بین عدد ستاره‌دار (سیمتری) و عدد بدون ستاره")
showRegularStarredNodes = input.bool(true, 'Show Regular Starred Nodes ( * )', group = GRP1)
showDoubleStarNodesInput = input.bool(true, 'Show Symmetry Nodes (as single-star *)', group = GRP1, tooltip = 'نودهای سیمتری دیگر به‌صورت ** نمایش داده نمی‌شوند و مثل تک‌ستاره (*) دیده می‌شوند')

var GRP5 = "Node Targets — Master Switches"
enableSingleNode1Targets = input.bool(true, 'Show Node 1 Targets (Double + 1.5DOUBLE1 + Double0.86 + Min + Correction)', group = GRP5)
enableSingleNode2Targets = input.bool(true, 'Show Node 2 Target (move size from Node2 correction end)', group = GRP5, tooltip = 'اندازه حرکت نود ۲ از انتهای اصلاح همان نود، در جهت نود ۲')
enablePairNode12Targets  = input.bool(true, 'Show Node 1+2 Pair Targets (Min + Max + Double + Correction)', group = GRP5)
showTargetNode1Up   = input.bool(true, 'Apply to Up Trend', inline = "trend1", group = GRP5)
showTargetNode1Down = input.bool(true, 'Apply to Down Trend', inline = "trend1", group = GRP5)
targetLabelGapBars = input.int(200, 'Line-to-Label Gap (bars into future)', minval = 3, maxval = 490, group = GRP5, tooltip = 'تردینگ‌ویو اجازه رسم بیش از ۵۰۰ کندل جلوتر را نمی‌دهد؛ این مقدار حداکثر ۴۹۰ است تا جای کافی برای جابجایی نوشته‌های متداخل باقی بماند')
deleteHitTargets = input.bool(true, 'Delete Hit Targets (auto-remove when price reaches target)', group = GRP5)

hitGraceBarsInput = input.int(2, 'Hit Target Grace Period (bars)', minval = 0, maxval = 500, group = GRP5, tooltip = 'تارگت‌هایی که قیمت به آنها رسیده باشد، حداقل به مدت این تعداد کندل دیگر نمایش داده می‌شوند و سپس حذف می‌شوند')
targetLineTransparency = input.int(60, 'Target Lines Transparency (0=Opaque, 100=Invisible)', minval = 0, maxval = 100, group = GRP5)

var GRP10 = "Round Number Targets (Psychological Levels)"
enableRoundTargets      = input.bool(false, 'Show Round Number Targets', group = GRP10)
roundBasePrice          = input.float(10.0, 'Round Number Base Price', minval = 0.0001, step = 0.1, group = GRP10)
roundApplyUp            = input.bool(true, 'Apply Round Numbers to Up Trend', inline = 'rnd1', group = GRP10)
roundApplyDown          = input.bool(true, 'Apply Round Numbers to Down Trend', inline = 'rnd1', group = GRP10)
// Round targets are never auto-deleted on hit
roundDeleteHit          = false
roundHitGraceBars       = 0
roundLineWidth          = input.int(1, 'Round Number Line Width', minval = 1, maxval = 4, group = GRP10)
roundLineStyle          = input.string('Dashed', 'Round Number Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP10)
