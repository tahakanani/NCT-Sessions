roundLineColor          = input.color(color.new(color.gray, 30), 'Round Number Line Color', group = GRP10)
roundMinVisiblePrice    = input.float(3000.0, 'Round Min Visible Price (0=auto)', minval = 0.0, group = GRP10)

var GRP6 = "Node 1 Targets (Single)"
showTargetDoubleInput     = input.bool(true, 'Show Target Double (100% from node peak)', group = GRP6)
showTargetDouble15Input   = input.bool(true, 'Show Target 1.5DOUBLE1 (150% from node peak)', group = GRP6, tooltip = 'همان Double نود ۱ با نسبت ۱.۵ از قله؛ وقتی نود ۲ تشکیل شود خودکار حذف می‌شود')
double15Ratio             = input.float(1.5, '1.5DOUBLE1 Ratio', minval = 0.01, maxval = 5.0, step = 0.01, group = GRP6, tooltip = 'ضریب حرکت از قله نود ۱؛ پیش‌فرض ۱.۵ (= ۱۵۰٪)')
showTargetDouble086Input  = input.bool(true, 'Show Target Double 0.86 (start→Double)', group = GRP6, tooltip = 'از ابتدای نود ۱ تا تارگت Double؛ وقتی نود ۲ برای همان نود ۱ تشکیل شود خودکار حذف می‌شود')
double086Ratio            = input.float(0.86, 'Start→Double Ratio', minval = 0.01, maxval = 2.0, step = 0.01, group = GRP6, tooltip = 'نسبت مسیر از ابتدای نود ۱ تا Double؛ پیش‌فرض ۰.۸۶')
showTargetMinInput        = input.bool(true, 'Show Target Min (from correction end)', group = GRP6)
showTargetCorrectionInput = input.bool(true, 'Show Target Correction (from node peak, correction size)', group = GRP6)
targetDoubleWidth     = input.int(1, 'Target Double Line Width', minval = 1, maxval = 4, group = GRP6)
targetDouble15Width   = input.int(1, 'Target 1.5DOUBLE1 Line Width', minval = 1, maxval = 4, group = GRP6)
targetDouble086Width  = input.int(1, 'Target Double 0.86 Line Width', minval = 1, maxval = 4, group = GRP6)
targetMinWidth        = input.int(3, 'Target Min Line Width', minval = 1, maxval = 4, group = GRP6)
targetCorrectionWidth = input.int(1, 'Target Correction Line Width', minval = 1, maxval = 4, group = GRP6)
targetDoubleStyle     = input.string('Dashed', 'Target Double Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6)
targetDouble15Style   = input.string('Dashed', 'Target 1.5DOUBLE1 Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6)
targetDouble086Style  = input.string('Dotted', 'Target Double 0.86 Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6)
targetMinStyle        = input.string('Solid', 'Target Min Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6)
targetCorrectionStyle = input.string('Dashed', 'Target Correction Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6)
targetNode1MaxCount = input.int(20, 'Number of Last Nodes to Target', minval = 1, maxval = 500, group = GRP6)

var GRP6B = "Node 2 Target (Single)"
showTargetNode2Input = input.bool(true, 'Show Target Node 2 (move from correction end)', group = GRP6B, tooltip = 'اندازه حرکت نود ۲ را بگیر؛ از انتهای اصلاح نود ۲ به اندازه همان حرکت در جهت نود ۲ برو')
targetNode2Width = input.int(2, 'Target Node 2 Line Width', minval = 1, maxval = 4, group = GRP6B)
targetNode2Style = input.string('Solid', 'Target Node 2 Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP6B)
targetNode2MaxCount = input.int(20, 'Number of Last Node 2 to Target', minval = 1, maxval = 500, group = GRP6B)

var GRP7 = "Node 1+2 Pair Targets (Min / Max / Double / Correction)"
showPairMinInput    = input.bool(true, 'Show Target Min (from Node1 correction end)', group = GRP7)
showPairMaxInput    = input.bool(true, 'Show Target Max (from Node2 correction end)', group = GRP7)
showPairDoubleInput = input.bool(true, 'Show Target Double (from Node2 own peak)', group = GRP7)
showPairCorrectionInput = input.bool(true, 'Show Target Correction (from Node2 peak, Node2 own correction size)', group = GRP7)
pairMinWidth    = input.int(3, 'Pair Target Min Line Width', minval = 1, maxval = 4, group = GRP7)
pairMaxWidth    = input.int(3, 'Pair Target Max Line Width', minval = 1, maxval = 4, group = GRP7)
pairDoubleWidth = input.int(1, 'Pair Target Double Line Width', minval = 1, maxval = 4, group = GRP7)
pairCorrectionWidth = input.int(1, 'Pair Target Correction Line Width', minval = 1, maxval = 4, group = GRP7)
pairMinStyle    = input.string('Solid', 'Pair Target Min Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP7)
pairMaxStyle    = input.string('Solid', 'Pair Target Max Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP7)
pairDoubleStyle = input.string('Dashed', 'Pair Target Double Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP7)
pairCorrectionStyle = input.string('Dashed', 'Pair Target Correction Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP7)
pairTargetMaxCount = input.int(20, 'Number of Last Pairs to Target', minval = 1, maxval = 500, group = GRP7)

var GRP3 = "Visual Customization"
text_node_size_sym   = input.string('Large', title='Font Size (With Symmetry)', group= GRP3, options=['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'])
text_node_size_nosym = input.string('Small', title='Font Size (Without Symmetry)', group= GRP3, options=['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'])
c1 = input.color(defval = color.white, inline = "13", group = GRP3)
c2 = input.color(defval = color.yellow, inline = "13", group = GRP3)
c3 = input.color(defval = color.aqua, inline = "13", group = GRP3)
c4 = input.color(defval = color.lime, inline = "13", group = GRP3)
c5 = input.color(defval = color.orange, inline = "14", group = GRP3)
c6 = input.color(defval = color.fuchsia, inline = "14", group = GRP3)
c7 = input.color(defval = color.blue, inline = "14", group = GRP3)
c8 = input.color(defval = color.red, inline = "14", group = GRP3)

var GRP4 = "No-Symmetry Colors (offset set)"
n1 = input.color(defval = color.white, inline = "15", group = GRP4)
n2 = input.color(defval = color.yellow, inline = "15", group = GRP4)
n3 = input.color(defval = color.aqua, inline = "15", group = GRP4)
n4 = input.color(defval = color.lime, inline = "15", group = GRP4)
n5 = input.color(defval = color.orange, inline = "16", group = GRP4)
n6 = input.color(defval = color.fuchsia, inline = "16", group = GRP4)
n7 = input.color(defval = color.blue, inline = "16", group = GRP4)
n8 = input.color(defval = color.red, inline = "16", group = GRP4)

//#endregion

// ================================================================================================
// بخش ۸: اجرای اصلی و نمایش نهایی
// ================================================================================================
//#region ———————————————————— EXECUTION


var Settings settingsSym = Settings.new(
     startPointInput, endPointInput,
     true,
     swCalcLogarithm,
     text_node_size_sym,
     c1, c2, c3, c4, c5, c6, c7, c8,
     true
 )

var Settings settingsNoSym = Settings.new(
     startPointInput, endPointInput,
     false,
     swCalcLogarithm,
     text_node_size_nosym,
     n1, n2, n3, n4, n5, n6, n7, n8,
     true
 )

var NDS cNodeSym   = newInstance(settingsSym)
var NDS cNodeNoSym = newInstance(settingsNoSym)

// فقط یک موتور در هر لحظه — پیش‌فرض Starred = cNodeSym
if nodeDisplayMode == 'Starred'
    cNodeSym.calc()
else
    cNodeNoSym.calc()

method countStarlessNode1(series NDS this, bool swUptrendType) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    cnt = 0
    if nodesRef.size() > 0
        for i = 0 to nodesRef.size() - 1
            n = nodesRef.get(i)
            if n.numberNode == 1 and not n.isSymmetrySetup
                cnt += 1
    cnt

if bar_index == last_bar_index
    clearDrawings()
    resetLabelStagger()

    // یک‌بار کل پنجره hit را آماده کن؛ بعد هر تارگت O(1) چک می‌شود
    if deleteHitTargets
        prepareHitWindow(hitGraceBarsInput)

    bool showStarred  = nodeDisplayMode == 'Starred'
    bool showStarless = nodeDisplayMode == 'Starless'

    if showStarred
        if cNodeSym.nodesUp.size() > 0
            cNodeSym.drawingNumberNodes(true,  "*", verticalGapInput, showRegularStarredNodes, showDoubleStarNodesInput)
        if cNodeSym.nodesDown.size() > 0
            cNodeSym.drawingNumberNodes(false, "*", verticalGapInput, showRegularStarredNodes, showDoubleStarNodesInput)
    if showStarless
        if cNodeNoSym.nodesUp.size() > 0
            cNodeNoSym.drawingNumberNodes(true,  "", 0, true, false)
        if cNodeNoSym.nodesDown.size() > 0
            cNodeNoSym.drawingNumberNodes(false, "", 0, true, false)

    NDS cTarget = showStarred ? cNodeSym : cNodeNoSym

    if enableSingleNode1Targets
        if showTargetNode1Up
            cTarget.drawingTargetsNode1(true,  showTargetDoubleInput, showTargetDouble15Input, showTargetDouble086Input, showTargetMinInput, showTargetCorrectionInput, targetDoubleWidth, targetDouble15Width, targetDouble086Width, targetMinWidth, targetCorrectionWidth, targetDoubleStyle, targetDouble15Style, targetDouble086Style, targetMinStyle, targetCorrectionStyle, targetNode1MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency, double086Ratio, double15Ratio)
        if showTargetNode1Down
            cTarget.drawingTargetsNode1(false, showTargetDoubleInput, showTargetDouble15Input, showTargetDouble086Input, showTargetMinInput, showTargetCorrectionInput, targetDoubleWidth, targetDouble15Width, targetDouble086Width, targetMinWidth, targetCorrectionWidth, targetDoubleStyle, targetDouble15Style, targetDouble086Style, targetMinStyle, targetCorrectionStyle, targetNode1MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency, double086Ratio, double15Ratio)

    if enableSingleNode2Targets
        if showTargetNode1Up
            cTarget.drawingTargetsNode2(true,  showTargetNode2Input, targetNode2Width, targetNode2Style, targetNode2MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)
        if showTargetNode1Down
            cTarget.drawingTargetsNode2(false, showTargetNode2Input, targetNode2Width, targetNode2Style, targetNode2MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)

    if enablePairNode12Targets
        if showTargetNode1Up
            cTarget.drawingPairTargetsNode12(true,  showPairMinInput, showPairMaxInput, showPairDoubleInput, showPairCorrectionInput, pairMinWidth, pairMaxWidth, pairDoubleWidth, pairCorrectionWidth, pairMinStyle, pairMaxStyle, pairDoubleStyle, pairCorrectionStyle, pairTargetMaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)
        if showTargetNode1Down
            cTarget.drawingPairTargetsNode12(false, showPairMinInput, showPairMaxInput, showPairDoubleInput, showPairCorrectionInput, pairMinWidth, pairMaxWidth, pairDoubleWidth, pairCorrectionWidth, pairMinStyle, pairMaxStyle, pairDoubleStyle, pairCorrectionStyle, pairTargetMaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)

    if enableRoundTargets
        if roundApplyUp
            drawRoundNumberTargets(roundBasePrice, true,  targetLabelGapBars, roundDeleteHit, roundHitGraceBars, roundLineWidth, roundLineStyle, roundLineTransparency, roundLineColor, roundMinVisiblePrice, startPointInput, true)
        if roundApplyDown
            drawRoundNumberTargets(roundBasePrice, false, targetLabelGapBars, roundDeleteHit, roundHitGraceBars, roundLineWidth, roundLineStyle, roundLineTransparency, roundLineColor, roundMinVisiblePrice, startPointInput, not roundApplyUp)


//#endregion

// ================================================================================================
// بخش ب: موتور Sessions (سشن‌های معاملاتی + رنج‌ها + خط اپن/کلوز روزانه)
// ================================================================================================
//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
// === تغییر ۱: ورودی تعداد روزهای نمایش سشن ===
sessionDisplayDays = input.int(2, 'Session Display Days', minval = 1, maxval = 10, group = 'Session Display', tooltip = 'تعداد روزهایی که سشن‌ها نمایش داده می‌شوند. مثلاً ۲ یعنی امروز و دیروز. فقط باکس Range، خط مرزی و Midline محدود می‌شوند.')

//Session A
show_sesa = input.bool(false, '', inline = 'sesa', group = 'Session A')
sesa_txt = input.string('New York', '', inline = 'sesa', group = 'Session A')
sesa_ses = input.session('1300-2200', '', inline = 'sesa', group = 'Session A')
sesa_css = input.color(#ff5d00, '', inline = 'sesa', group = 'Session A')

