sesb_range = input.bool(true, 'Range', inline = 'sesb_overlays', group = 'Session B')
sesb_tl = input.bool(false, 'Trendline', inline = 'sesb_overlays', group = 'Session B')
sesb_avg = input.bool(false, 'Mean', inline = 'sesb_overlays', group = 'Session B')
sesb_vwap = input.bool(false, 'VWAP', inline = 'sesb_overlays', group = 'Session B')
sesb_maxmin = input.bool(false, 'Max/Min', inline = 'sesb_overlays', group = 'Session B')
sesb_midline = input.bool(true, 'Middle Line', inline = 'sesb_overlays', group = 'Session B')
sesb_midline_length = input.int(10, 'Middle Line Extension (Bars)', minval=0, group = 'Session B')

//Session C
show_sesc = input.bool(true, '', inline = 'sesc', group = 'Session C')
sesc_txt = input.string('Tokyo', '', inline = 'sesc', group = 'Session C')
sesc_ses = input.session('0000-0600', '', inline = 'sesc', group = 'Session C')
sesc_css = input.color(#ffeb3b, '', inline = 'sesc', group = 'Session C')

sesc_range = input.bool(true, 'Range', inline = 'sesc_overlays', group = 'Session C')
sesc_tl = input.bool(false, 'Trendline', inline = 'sesc_overlays', group = 'Session C')
sesc_avg = input.bool(true, 'Mean', inline = 'sesc_overlays', group = 'Session C')
sesc_vwap = input.bool(false, 'VWAP', inline = 'sesc_overlays', group = 'Session C')
sesc_maxmin = input.bool(false, 'Max/Min', inline = 'sesc_overlays', group = 'Session C')
sesc_midline = input.bool(true, 'Middle Line', inline = 'sesc_overlays', group = 'Session C')
sesc_midline_length = input.int(100, 'Middle Line Extension (Bars)', minval=0, group = 'Session C')

//Session D
show_sesd = input.bool(false, '', inline = 'sesd', group = 'Session D')
sesd_txt = input.string('Sydney', '', inline = 'sesd', group = 'Session D')
sesd_ses = input.session('2100-0600', '', inline = 'sesd', group = 'Session D')
sesd_css = input.color(#ffeb3b, '', inline = 'sesd', group = 'Session D')

sesd_range = input.bool(true, 'Range', inline = 'sesd_overlays', group = 'Session D')
sesd_tl = input.bool(false, 'Trendline', inline = 'sesd_overlays', group = 'Session D')
sesd_avg = input.bool(false, 'Mean', inline = 'sesd_overlays', group = 'Session D')
sesd_vwap = input.bool(false, 'VWAP', inline = 'sesd_overlays', group = 'Session D')
sesd_maxmin = input.bool(false, 'Max/Min', inline = 'sesd_overlays', group = 'Session D')
sesd_midline = input.bool(true, 'Middle Line', inline = 'sesd_overlays', group = 'Session D')
sesd_midline_length = input.int(10, 'Middle Line Extension (Bars)', minval=0, group = 'Session D')

//Timezones
tz_incr = input.int(0, 'UTC (+/-)', group = 'Timezone')
use_exchange = input.bool(false, 'Use Exchange Timezone', group = 'Timezone')

//Ranges Options
bg_transp = input.float(90, 'Range Area Transparency', group = 'Ranges Settings')
show_outline = input.bool(true, 'Range Outline', group = 'Ranges Settings')
outline_width = input.int(1, 'Outline Width', minval=1, maxval=5, group = 'Ranges Settings')
outline_style = input.string(line.style_dotted, "Outline Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = 'Ranges Settings')
outline_transp = input.int(0, 'Outline Transparency', minval=0, maxval=100, group = 'Ranges Settings')
show_txt = input.bool(true, 'Range Label', group = 'Ranges Settings')
midline_style = input.string(line.style_dashed, "Middle Line Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = 'Ranges Settings')
midline_width = input.int(1, 'Middle Line Width', minval=1, maxval=5, group = 'Ranges Settings')
midline_transp = input.int(0, 'Middle Line Transparency', minval=0, maxval=100, group = 'Ranges Settings')

// Session target line settings
var GRP_SESTGT = "Session Targets"
enableSessionTargets = input.bool(true, 'Show Session High/Low/Midline as Targets', group = GRP_SESTGT, tooltip = 'سقف، کف و میدلاین هر سشن به‌عنوان تارگت رسم می‌شود')
applySessionHigh = input.bool(true, 'Include Session High (Top)', inline = 'sestgt1', group = GRP_SESTGT)
applySessionLow  = input.bool(true, 'Include Session Low (Bottom)', inline = 'sestgt1', group = GRP_SESTGT)
applySessionMid  = input.bool(true, 'Include Session Midline', inline = 'sestgt1', group = GRP_SESTGT)
sessionHighLineWidth = input.int(1, 'Session High Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionLowLineWidth  = input.int(1, 'Session Low Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionMidLineWidth  = input.int(1, 'Session Mid Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionTargetLineStyle  = input.string('Dotted', 'Session Target Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP_SESTGT)
sessionTargetLineTransparency = input.int(60, 'Session Target Line Transparency (0=Opaque, 100=Invisible)', minval = 0, maxval = 100, group = GRP_SESTGT)

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
nBar = bar_index

//Get session average
get_avg(session)=>
    var len = 1
    var float csma = na
    var float sma = na

    if session > session[1]
        len := 1
        csma := close
    
    if session != 0 and session == session[1]
        len += 1    
        csma += close
        sma := csma / len
    
    sma

//Get trendline coordinates
get_linreg(session)=>
    var len = 1
    var float cwma  = na
    var float csma  = na
    var float csma2 = na

    var float y1 = na
    var float y2 = na
    var float stdev = na 
    var float r2    = na 

    if session > session[1]
        len   := 1
        cwma  := close
        csma  := close
        csma2 := close * close
    
    if session != 0 and session == session[1]
        len   += 1    
        csma  += close
        csma2 += close * close
        cwma  += close * len

        sma = csma / len
        wma = cwma / (len * (len + 1) / 2)

        cov   = (wma - sma) * (len+1)/2
        stdev := math.sqrt(csma2 / len - sma * sma)
        r2    := cov / (stdev * (math.sqrt(len*len - 1) / (2 * math.sqrt(3))))

        y1 := 4 * sma - 3 * wma
        y2 := 3 * wma - 2 * sma

    [y1 , y2, stdev, r2]

//Set line
set_line(session, y1, y2, session_css)=>
    var line tl = na

    if session > session[1]
        tl := line.new(nBar, close, nBar, close, color = session_css)

    if session != 0 and session == session[1]
        line.set_y1(tl, y1)
        line.set_xy2(tl, nBar, y2)

// === تغییر ۱: get_range — نمایش فقط N سشن اخیر ===
get_range(session, session_name, session_css, show_midline, midline_length, displayDays, extendMidToLast)=>
    var t = 0 
    var max = high
    var min = low
    var box bx = na
    var label lbl = na 
    var line mid_line = na
    var int start_bar = na
    var int end_bar = na
    
    var array<box>   boxHistory = array.new<box>()
    var array<label> lblHistory = array.new<label>()
    var array<line>  midHistory = array.new<line>()

    if session > session[1]
        t := time
        max := high
        min := low
        start_bar := nBar

        border_color_transparent = color.new(session_css, outline_transp)
        
        bx := box.new(nBar, max, nBar, min
          , bgcolor = color.new(session_css, bg_transp)
          , border_color = show_outline ? border_color_transparent : na
          , border_width = outline_width
          , border_style = outline_style
          )
        boxHistory.push(bx)

        if show_midline
            midline_color_transparent = color.new(session_css, midline_transp)
            mid_line := line.new(
                 start_bar, (max + min) / 2, 
                 nBar, (max + min) / 2, 
                 color = midline_color_transparent, 
                 style = line.style_dotted,
                 width = midline_width
             )
            midHistory.push(mid_line)

        if show_txt
            lbl := label.new(t, max, session_name
              , xloc = xloc.bar_time
              , textcolor = session_css
              , style = label.style_label_down
              , color = color.new(color.white, 100)
              , size = size.tiny)
            lblHistory.push(lbl)
        
        while boxHistory.size() > displayDays
            oldBox = boxHistory.shift()
            box.delete(oldBox)
        while lblHistory.size() > displayDays
            oldLbl = lblHistory.shift()
            label.delete(oldLbl)
        while midHistory.size() > displayDays
            oldMid = midHistory.shift()
            line.delete(oldMid)

    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        end_bar := nBar

        if not na(bx)
            box.set_top(bx, max)
            box.set_rightbottom(bx, nBar, min)

        if show_midline and not na(mid_line) and not na(start_bar)
            line.set_xy1(mid_line, start_bar, (max + min) / 2)
            line.set_xy2(mid_line, end_bar + midline_length, (max + min) / 2)
    
        if show_txt and not na(lbl)
            label.set_xy(lbl, int(math.avg(t, time)), max)
    
    if extendMidToLast and show_midline and not na(mid_line) and not na(start_bar) and session == 0
        line.set_xy2(mid_line, nBar, (max + min) / 2)
    
    [session != 0 ? na : max, session != 0 ? na : min, max, min]
//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{
tf = timeframe.period

var tz = use_exchange ? syminfo.timezone :
  str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

is_sesa = math.sign(nz(time(tf, sesa_ses, tz)))
is_sesb = math.sign(nz(time(tf, sesb_ses, tz)))
is_sesc = math.sign(nz(time(tf, sesc_ses, tz)))
is_sesd = math.sign(nz(time(tf, sesd_ses, tz)))

//-----------------------------------------------------------------------------}
//Overlays
//-----------------------------------------------------------------------------{
var float max_sesa = na
var float min_sesa = na
var float max_sesb = na
var float min_sesb = na
var float max_sesc = na
var float min_sesc = na
var float max_sesd = na
var float min_sesd = na

var float curmax_sesa = na
var float curmin_sesa = na
var float curmax_sesb = na
var float curmin_sesb = na
var float curmax_sesc = na
var float curmin_sesc = na
var float curmax_sesd = na
var float curmin_sesd = na

if show_sesa and sesa_range
    [max, min, curmax, curmin] = get_range(is_sesa, sesa_txt, sesa_css, sesa_midline, sesa_midline_length, sessionDisplayDays, false)
    max_sesa := max
    min_sesa := min
    curmax_sesa := curmax
    curmin_sesa := curmin

if show_sesb and sesb_range
    [max, min, curmax, curmin] = get_range(is_sesb, sesb_txt, sesb_css, sesb_midline, sesb_midline_length, sessionDisplayDays, false)
    max_sesb := max
    min_sesb := min
    curmax_sesb := curmax
    curmin_sesb := curmin

if show_sesc and sesc_range
    [max, min, curmax, curmin] = get_range(is_sesc, sesc_txt, sesc_css, sesc_midline, sesc_midline_length, sessionDisplayDays, true)
    max_sesc := max
    min_sesc := min
    curmax_sesc := curmax
    curmin_sesc := curmin

if show_sesd and sesd_range
    [max, min, curmax, curmin] = get_range(is_sesd, sesd_txt, sesd_css, sesd_midline, sesd_midline_length, sessionDisplayDays, false)
    max_sesd := max
    min_sesd := min
    curmax_sesd := curmax
    curmin_sesd := curmin

//Mean
if show_sesa and sesa_avg
    avg = get_avg(is_sesa)
    set_line(is_sesa, avg, avg, sesa_css)

if show_sesb and sesb_avg
    avg = get_avg(is_sesb)
    set_line(is_sesb, avg, avg, sesb_css)

if show_sesc and sesc_avg
    avg = get_avg(is_sesc)
    set_line(is_sesc, avg, avg, sesc_css)

if show_sesd and sesd_avg
    avg = get_avg(is_sesd)
    set_line(is_sesd, avg, avg, sesd_css)

//-----------------------------------------------------------------------------

var GRP_DAYOC = "Day Open/Close"
showDayOpenLine = input.bool(true, 'Show Day Open Line', inline = 'dayoc_show', group = GRP_DAYOC)
showDayCloseLine = input.bool(true, 'Show Day Close Line', inline = 'dayoc_show', group = GRP_DAYOC)
open_line_color = input.color(color.green, 'Open Line Color', inline = 'dayoc_col', group = GRP_DAYOC)
close_line_color = input.color(color.red, 'Close Line Color', inline = 'dayoc_col', group = GRP_DAYOC)
openLineWidth = input.int(2, 'Open Line Width', minval = 1, maxval = 5, inline = 'dayoc_w', group = GRP_DAYOC)
closeLineWidth = input.int(2, 'Close Line Width', minval = 1, maxval = 5, inline = 'dayoc_w', group = GRP_DAYOC)
openLineStyle = input.string('Solid', 'Open Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'dayoc_st', group = GRP_DAYOC)
closeLineStyle = input.string('Dotted', 'Close Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'dayoc_st', group = GRP_DAYOC)
openLineTransparency = input.int(0, 'Open Line Transparency', minval = 0, maxval = 100, inline = 'dayoc_tr', group = GRP_DAYOC)
closeLineTransparency = input.int(0, 'Close Line Transparency', minval = 0, maxval = 100, inline = 'dayoc_tr', group = GRP_DAYOC)
line_length_factor_1m = input.int(130, 'Line Length Factor (1m)', minval = 1, group = GRP_DAYOC)
line_length_factor_5m = input.int(24, 'Line Length Factor (5m)', minval = 1, group = GRP_DAYOC)
line_length_factor_15m = input.int(7, 'Line Length Factor (15m)', minval = 1, group = GRP_DAYOC)
line_length_factor_other = input.int(10, 'Line Length Factor (Other TF)', minval = 1, group = GRP_DAYOC)
showDayOCBox = input.bool(true, 'Show Day Open/Close Panel', group = GRP_DAYOC, tooltip = 'یک باکس در سمت راست نمودار که قیمت اپن امروز و کلوز دیروز را نشان می‌دهد')
dayOCBoxBgColor = input.color(color.new(color.blue, 85), 'Panel Background Color', group = GRP_DAYOC)

var GRP_TIMETGT = "Time Targets (Vertical)"
enableTimeTargets = input.bool(true, 'Show Time Targets', group = GRP_TIMETGT, tooltip = 'خطوط عمودی تایم‌ها بر اساس تایم‌زون سشن‌ها')
timeTargetDisplayDays = input.int(1, 'Display Days', minval = 1, maxval = 10, group = GRP_TIMETGT, tooltip = 'تعداد روزهای نمایش: ۱ = فقط امروز، ۲ = امروز + دیروز، و همین‌طور بیشتر')
timeTargetsCsv = input.string('01:30,02:30,03:00,04:00,07:00,08:00,09:00,10:00,12:00,13:00,15:30,16:30,18:00,20:00,21:00,23:00', 'Times (HH:MM, comma-separated)', group = GRP_TIMETGT, tooltip = 'لیست تایم‌ها با کاما؛ برای هر روز در بازهٔ Display Days رسم می‌شود')
timeTargetColor = input.color(color.new(#78909c, 0), 'Line Color', inline = 'tt_col', group = GRP_TIMETGT)
timeTargetWidth = input.int(1, 'Line Width', minval = 1, maxval = 5, inline = 'tt_col', group = GRP_TIMETGT)
timeTargetStyle = input.string('Dashed', 'Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'tt_st', group = GRP_TIMETGT)
timeTargetTransparency = input.int(40, 'Line Transparency', minval = 0, maxval = 100, inline = 'tt_st', group = GRP_TIMETGT)
showTimeTargetLabels = input.bool(true, 'Show Time Labels', group = GRP_TIMETGT)
timeTargetLabelSize = input.string('Tiny', 'Label Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP_TIMETGT)

// MAP Weekly — سطوح هفتهٔ قبل (مانند MAPWeekly.cs)
var GRP_MAPW = "MAP Weekly Targets"
enableMapWeekly = input.bool(true, 'Show MAP Weekly Targets', group = GRP_MAPW, tooltip = 'بر اساس High/Low هفتهٔ قبلِ بسته‌شده (مثل MAPWeekly). خطوط از شروع هفتهٔ جاری رسم می‌شوند.')
mapShowHigh = input.bool(true, 'Show Weekly High', inline = 'map_key', group = GRP_MAPW)
mapShowLow  = input.bool(true, 'Show Weekly Low', inline = 'map_key', group = GRP_MAPW)
mapShowMid  = input.bool(true, 'Show 50% Mid', inline = 'map_mid', group = GRP_MAPW)
mapShow25   = input.bool(true, 'Show 25%', inline = 'map_mid', group = GRP_MAPW)
mapShow75   = input.bool(true, 'Show 75%', inline = 'map_mid', group = GRP_MAPW)
mapShowExtAbove = input.bool(true, 'Extensions Above High', inline = 'map_ext', group = GRP_MAPW)
mapShowExtBelow = input.bool(true, 'Extensions Below Low', inline = 'map_ext', group = GRP_MAPW)
mapShow1125 = input.bool(false, '1.125x', inline = 'map_x1', group = GRP_MAPW)
mapShow125  = input.bool(true, '1.25x', inline = 'map_x1', group = GRP_MAPW)
mapShow1375 = input.bool(false, '1.375x', inline = 'map_x1', group = GRP_MAPW)
mapShow150  = input.bool(true, '1.5x', inline = 'map_x2', group = GRP_MAPW)
mapShow175  = input.bool(true, '1.75x', inline = 'map_x2', group = GRP_MAPW)
mapShow200  = input.bool(true, '2x', inline = 'map_x2', group = GRP_MAPW)
mapExtendBars = input.int(150, 'Extend Lines (Bars)', minval = 0, maxval = 490, group = GRP_MAPW)
mapShowLabels = input.bool(true, 'Show Labels', group = GRP_MAPW)
mapLineTransparency = input.int(30, 'Line Transparency', minval = 0, maxval = 100, group = GRP_MAPW)
mapKeyLineWidth = input.int(2, 'Key Line Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapMidLineWidth = input.int(1, 'Mid/Retrace Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapExtLineWidth = input.int(1, 'Extension Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapKeyLineStyle = input.string('Solid', 'Key Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapMidLineStyle = input.string('Dashed', 'Mid Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapExtLineStyle = input.string('Dotted', 'Extension Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapHighColor = input.color(#FF4D6D, 'High Color', inline = 'map_c1', group = GRP_MAPW)
mapLowColor  = input.color(#7CFF47, 'Low Color', inline = 'map_c1', group = GRP_MAPW)
mapMidColor  = input.color(#FFE566, 'Mid Color', inline = 'map_c2', group = GRP_MAPW)
mapRetraceColor = input.color(#7AA2FF, '25/75% Color', inline = 'map_c2', group = GRP_MAPW)
mapExtColor = input.color(#C084FC, 'Extension Color', group = GRP_MAPW)

dayOcStyleFromString(string s) =>
    s == 'Solid' ? line.style_solid : s == 'Dashed' ? line.style_dashed : line.style_dotted

line_length_factor = switch
    timeframe.isminutes and timeframe.period == "1" => line_length_factor_1m
    timeframe.isminutes and timeframe.period == "5" => line_length_factor_5m
    timeframe.isminutes and timeframe.period == "15" => line_length_factor_15m
    => line_length_factor_other

line_length = math.round(line_length_factor * 10)

is_new_day = ta.change(time("D")) != 0

// هفتهٔ قبلِ کامل‌شده (مثل MAPWeekly.cs: کندل هفتگی یکی قبل از هفتهٔ جاری)
// lookahead_on + high[1] = مقدار هفتهٔ بسته‌شده از ابتدای هفتهٔ جدید در دسترس است (بدون نشت آینده)
[mapPwHighRaw, mapPwLowRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// قفل روی شروع هفته تا وسط هفته جابه‌جا نشود
var float mapPwHigh = na
var float mapPwLow = na
if barstate.isfirst or ta.change(time("W")) != 0
    mapPwHigh := mapPwHighRaw
    mapPwLow := mapPwLowRaw
else if na(mapPwHigh) or na(mapPwLow)
    mapPwHigh := mapPwHighRaw
    mapPwLow := mapPwLowRaw

drawMapWeeklyLevel(float price, string labelText, color col, int width, string styleStr, int startTime, int endTime, int labelBarX) =>
    if not na(price) and not na(startTime) and not na(time) and canDrawLine()
        lnStyle = styleFromString(styleStr)
        int baseX = targetLabelBaseX(mapExtendBars)
        int lblX = mapShowLabels ? getStaggerX(price, baseX, 2) : math.max(bar_index + mapExtendBars, baseX)
        int endIdx = math.max(bar_index + mapExtendBars, lblX)
        int tfMs = math.max(timeframe.in_seconds() * 1000, 1000)
        int lineEndTime = math.max(nz(endTime, time), time + (endIdx - bar_index) * tfMs)
        chart.point p1 = chart.point.from_time(startTime, price)
        chart.point p2 = chart.point.from_time(lineEndTime, price)
        trackLine(line.new(p1, p2, color = color.new(col, mapLineTransparency), width = width, style = lnStyle))
        if mapShowLabels and canDrawLabel()
            trackLabel(label.new(x = lblX, y = labelYAboveLine(price), text = "W.L", style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = textSizeFromString(targetLabelSize)))

[open_1m, close_1m] = request.security(syminfo.tickerid, "1", [open, close], lookahead=barmerge.lookahead_off)

var float open_today_price = na
var float close_yesterday_price = na

var int dayCountOpenClose = 0

if is_new_day
    open_today_price := open_1m
    close_yesterday_price := close_1m[1]
    dayCountOpenClose += 1

// Reuse 2 var lines — avoid creating a new line on every bar
var line dayOpenHistLine = na
var line dayCloseHistLine = na
openLnStyle = dayOcStyleFromString(openLineStyle)
closeLnStyle = dayOcStyleFromString(closeLineStyle)
if dayCountOpenClose <= 2
    if showDayOpenLine and not na(open_today_price)
        if na(dayOpenHistLine)
            dayOpenHistLine := line.new(bar_index, open_today_price, bar_index - line_length, open_today_price, color = color.new(open_line_color, openLineTransparency), width = openLineWidth, style = openLnStyle)
        else
            line.set_xy1(dayOpenHistLine, bar_index, open_today_price)
            line.set_xy2(dayOpenHistLine, bar_index - line_length, open_today_price)
            line.set_color(dayOpenHistLine, color.new(open_line_color, openLineTransparency))
            line.set_width(dayOpenHistLine, openLineWidth)
            line.set_style(dayOpenHistLine, openLnStyle)
    if showDayCloseLine and not na(close_yesterday_price)
        if na(dayCloseHistLine)
            dayCloseHistLine := line.new(bar_index, close_yesterday_price, bar_index - line_length, close_yesterday_price, color = color.new(close_line_color, closeLineTransparency), width = closeLineWidth, style = closeLnStyle)
        else
            line.set_xy1(dayCloseHistLine, bar_index, close_yesterday_price)
            line.set_xy2(dayCloseHistLine, bar_index - line_length, close_yesterday_price)
            line.set_color(dayCloseHistLine, color.new(close_line_color, closeLineTransparency))
            line.set_width(dayCloseHistLine, closeLineWidth)
            line.set_style(dayCloseHistLine, closeLnStyle)

// ================================================================================================
// بخش ج: ثبت سقف/کف/میدلاین هر سشن به‌عنوان تارگت + اپن/کلوز روزانه + پنل
// ================================================================================================
//#region ———————————————————— SESSION TARGETS


// ================================================================================================
// بخش FVG: Fair Value Gap
// Adapted from LuxAlgo Fair Value Gap (CC BY-NC-SA 4.0) — © LuxAlgo
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// ================================================================================================
//#region ———————————————————— FAIR VALUE GAP (LuxAlgo-adapted)

enableFvg = input.bool(true, 'Enable Fair Value Gap', group = 'Fair Value Gap')
fvgThresholdPer = input.float(0.0, 'Threshold %', minval = 0, maxval = 100, step = 0.1, inline = 'fvg_thr', group = 'Fair Value Gap')
fvgAutoThreshold = input.bool(false, 'Auto', inline = 'fvg_thr', group = 'Fair Value Gap')
fvgShowLast = input.int(0, 'Unmitigated Levels', minval = 0, group = 'Fair Value Gap')
fvgMitigationLevels = input.bool(false, 'Mitigation Levels', group = 'Fair Value Gap')
fvgTf = input.timeframe('', 'Timeframe', group = 'Fair Value Gap')
fvgExtend = input.int(20, 'Extend', minval = 0, inline = 'fvg_ext', group = 'Fair Value Gap')
fvgDynamic = input.bool(false, 'Dynamic', inline = 'fvg_ext', group = 'Fair Value Gap')
fvgBullCss = input.color(color.new(#089981, 70), 'Bullish FVG', group = 'Fair Value Gap')
fvgBearCss = input.color(color.new(#f23645, 70), 'Bearish FVG', group = 'Fair Value Gap')
fvgShowDash = input.bool(false, 'Show Dashboard', group = 'Fair Value Gap')
fvgDashLoc = input.string('Top Right', 'Dashboard Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = 'Fair Value Gap')
fvgTextSize = input.string('Small', 'Dashboard Size', options = ['Tiny', 'Small', 'Normal'], group = 'Fair Value Gap')

fvgToSolid(color id) =>
    color.rgb(color.r(id), color.g(id), color.b(id))

// Chart-native detect (no UDT through security — that broke mitigation)
fvgDetectRaw() =>
    float thr = fvgAutoThreshold ? ta.cum((high - low) / low) / math.max(bar_index, 1) : fvgThresholdPer / 100.0
    bool bull_fvg = bar_index > 2 and low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > thr
    bool bear_fvg = bar_index > 2 and high < low[2] and close[1] < low[2] and (low[2] - high) / high > thr
    float mx = bull_fvg ? low : bear_fvg ? low[2] : na
    float mn = bull_fvg ? high[2] : bear_fvg ? high : na
    [bull_fvg, bear_fvg, mx, mn]

var float fvg_max_bull = na
var float fvg_min_bull = na
var float fvg_max_bear = na
var float fvg_min_bear = na
var int fvg_bull_count = 0
var int fvg_bear_count = 0
var int fvg_bull_mitigated = 0
var int fvg_bear_mitigated = 0
var int fvg_last_sig_bar = -1

// Parallel arrays (reliable; box tied 1:1 with levels)
var array<float> fvg_max_arr = array.new<float>()
var array<float> fvg_min_arr = array.new<float>()
var array<bool> fvg_bull_arr = array.new<bool>()
var array<int> fvg_born_arr = array.new<int>()
var array<box> fvg_box_arr = array.new<box>()
var array<line> fvg_unmitigated = array.new<line>()

[fvg_bull_c, fvg_bear_c, fvg_mx_c, fvg_mn_c] = fvgDetectRaw()
[fvg_bull_htf, fvg_bear_htf, fvg_mx_htf, fvg_mn_htf] = request.security(syminfo.tickerid, fvgTf == '' ? timeframe.period : fvgTf, fvgDetectRaw(), lookahead = barmerge.lookahead_off)
bool fvg_on_chart = fvgTf == '' or fvgTf == timeframe.period
bool fvg_bull = fvg_on_chart ? fvg_bull_c : fvg_bull_htf
bool fvg_bear = fvg_on_chart ? fvg_bear_c : fvg_bear_htf
float fvg_mx = fvg_on_chart ? fvg_mx_c : fvg_mx_htf
float fvg_mn = fvg_on_chart ? fvg_mn_c : fvg_mn_htf
// Rising edge only — prevents re-creating the same HTF gap every chart bar
bool fvg_bull_new = fvg_bull and not fvg_bull[1]
bool fvg_bear_new = fvg_bear and not fvg_bear[1]

if enableFvg and fvg_bull_new and not na(fvg_mx) and not na(fvg_mn) and fvg_mx >= fvg_mn
    if fvgDynamic
        fvg_max_bull := fvg_mx
        fvg_min_bull := fvg_mn
    if not fvgDynamic
        fvg_box_arr.unshift(box.new(bar_index - 2, fvg_mx, math.max(bar_index + fvgExtend, bar_index), fvg_mn, border_color = na, bgcolor = fvgBullCss))
    else
        fvg_box_arr.unshift(na)
    fvg_max_arr.unshift(fvg_mx)
    fvg_min_arr.unshift(fvg_mn)
    fvg_bull_arr.unshift(true)
    fvg_born_arr.unshift(bar_index)
    fvg_bull_count += 1
    fvg_last_sig_bar := bar_index
else if enableFvg and fvgDynamic
    fvg_max_bull := math.max(math.min(close, fvg_max_bull), fvg_min_bull)

if enableFvg and fvg_bear_new and not na(fvg_mx) and not na(fvg_mn) and fvg_mx >= fvg_mn
    if fvgDynamic
        fvg_max_bear := fvg_mx
        fvg_min_bear := fvg_mn
    if not fvgDynamic
        fvg_box_arr.unshift(box.new(bar_index - 2, fvg_mx, math.max(bar_index + fvgExtend, bar_index), fvg_mn, border_color = na, bgcolor = fvgBearCss))
    else
        fvg_box_arr.unshift(na)
    fvg_max_arr.unshift(fvg_mx)
    fvg_min_arr.unshift(fvg_mn)
    fvg_bull_arr.unshift(false)
    fvg_born_arr.unshift(bar_index)
    fvg_bear_count += 1
    fvg_last_sig_bar := bar_index
else if enableFvg and fvgDynamic
    fvg_min_bear := math.min(math.max(close, fvg_min_bear), fvg_max_bear)

// Mitigate: after birth bar, any overlap of candle range with FVG zone deletes it
if enableFvg and fvg_max_arr.size() > 0
    for i = fvg_max_arr.size() - 1 to 0
        int born = fvg_born_arr.get(i)
        float mx = fvg_max_arr.get(i)
        float mn = fvg_min_arr.get(i)
        bool isBull = fvg_bull_arr.get(i)
        // Keep box growing to the right while alive
        box bx = fvg_box_arr.get(i)
        if not na(bx)
            box.set_right(bx, math.max(bar_index, born + fvgExtend))
        if bar_index > born and not na(mx) and not na(mn)
            bool touched = high >= mn and low <= mx
            if touched
                if fvgMitigationLevels
                    float y = isBull ? mn : mx
                    line.new(born, y, bar_index, y, xloc.bar_index, color = isBull ? fvgBullCss : fvgBearCss, style = line.style_dashed)
                if not na(bx)
                    box.delete(bx)
                fvg_box_arr.remove(i)
                fvg_max_arr.remove(i)
                fvg_min_arr.remove(i)
                fvg_bull_arr.remove(i)
                fvg_born_arr.remove(i)
                if isBull
                    fvg_bull_mitigated += 1
                else
                    fvg_bear_mitigated += 1

if enableFvg and fvgDynamic
    if fvg_born_arr.size() == 0 or bar_index > fvg_born_arr.get(0)
        if not na(fvg_max_bull) and not na(fvg_min_bull) and high >= fvg_min_bull and low <= fvg_max_bull
            fvg_max_bull := na
            fvg_min_bull := na
        if not na(fvg_max_bear) and not na(fvg_min_bear) and high >= fvg_min_bear and low <= fvg_max_bear
            fvg_max_bear := na
            fvg_min_bear := na

if enableFvg and barstate.islast and fvgShowLast > 0 and fvg_max_arr.size() > 0
    if fvg_unmitigated.size() > 0
        for element in fvg_unmitigated
            line.delete(element)
        fvg_unmitigated.clear()
    for i = 0 to math.min(fvgShowLast - 1, fvg_max_arr.size() - 1)
        bool isBull = fvg_bull_arr.get(i)
        float lvl = isBull ? fvg_min_arr.get(i) : fvg_max_arr.get(i)
        int born = fvg_born_arr.get(i)
        fvg_unmitigated.push(line.new(born, lvl, bar_index, lvl, xloc.bar_index, color = isBull ? fvgBullCss : fvgBearCss))

var table fvg_tb = na

fvg_table_size = fvgTextSize == 'Tiny' ? size.tiny : fvgTextSize == 'Small' ? size.small : size.normal

if enableFvg and fvgShowDash
    if na(fvg_tb)
        fvg_tb := table.new(
             fvgDashLoc == 'Bottom Left' ? position.bottom_left : fvgDashLoc == 'Top Right' ? position.top_right : position.bottom_right,
             3, 3, bgcolor = #1e222d, border_color = #373a46, border_width = 1, frame_color = #373a46, frame_width = 1)
    if barstate.isfirst or barstate.islast
        table.cell(fvg_tb, 1, 0, 'Bullish', text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 0, 'Bearish', text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 0, 1, 'Count', text_size = fvg_table_size, text_color = color.white)
        table.cell(fvg_tb, 0, 2, 'Mitigated', text_size = fvg_table_size, text_color = color.white)
    if barstate.islast
        table.cell(fvg_tb, 1, 1, str.tostring(fvg_bull_count), text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 1, str.tostring(fvg_bear_count), text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)
        float bullMitPct = fvg_bull_count > 0 ? fvg_bull_mitigated / fvg_bull_count * 100.0 : 0.0
        float bearMitPct = fvg_bear_count > 0 ? fvg_bear_mitigated / fvg_bear_count * 100.0 : 0.0
        table.cell(fvg_tb, 1, 2, str.tostring(bullMitPct, '#.##') + '%', text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 2, str.tostring(bearMitPct, '#.##') + '%', text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)

fvg_max_bull_plot = plot(enableFvg and fvgDynamic ? fvg_max_bull : na, color = na, display = display.none)
fvg_min_bull_plot = plot(enableFvg and fvgDynamic ? fvg_min_bull : na, color = na, display = display.none)
fill(fvg_max_bull_plot, fvg_min_bull_plot, color = enableFvg and fvgDynamic ? fvgBullCss : na)
fvg_max_bear_plot = plot(enableFvg and fvgDynamic ? fvg_max_bear : na, color = na, display = display.none)
fvg_min_bear_plot = plot(enableFvg and fvgDynamic ? fvg_min_bear : na, color = na, display = display.none)
fill(fvg_max_bear_plot, fvg_min_bear_plot, color = enableFvg and fvgDynamic ? fvgBearCss : na)

alertcondition(enableFvg and fvg_bull_count > fvg_bull_count[1], 'Bullish FVG', 'Bullish FVG detected')
alertcondition(enableFvg and fvg_bear_count > fvg_bear_count[1], 'Bearish FVG', 'Bearish FVG detected')
alertcondition(enableFvg and fvg_bull_mitigated > fvg_bull_mitigated[1], 'Bullish FVG Mitigation', 'Bullish FVG mitigated')
alertcondition(enableFvg and fvg_bear_mitigated > fvg_bear_mitigated[1], 'Bearish FVG Mitigation', 'Bearish FVG mitigated')


//#endregion




registerSessionTargetEx(float price, color col, string labelText, int lineWidth) =>
    if not na(price) and canDrawLine() and canDrawLabel()
        drawTargetLineLabel(bar_index, price, col, lineWidth, sessionTargetLineStyle, sessionTargetLineTransparency, labelText, targetLabelGapBars, 2)

if bar_index == last_bar_index
    if enableSessionTargets
        if show_sesa and sesa_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesa, sesa_css, sesa_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesa, sesa_css, sesa_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesa) and not na(curmin_sesa)
                midA = (curmax_sesa + curmin_sesa) / 2
                registerSessionTargetEx(midA, sesa_css, sesa_txt + " Mid", sessionMidLineWidth)
        if show_sesb and sesb_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesb, sesb_css, sesb_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesb, sesb_css, sesb_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesb) and not na(curmin_sesb)
                midB = (curmax_sesb + curmin_sesb) / 2
                registerSessionTargetEx(midB, sesb_css, sesb_txt + " Mid", sessionMidLineWidth)
        if show_sesc and sesc_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesc, sesc_css, sesc_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesc, sesc_css, sesc_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesc) and not na(curmin_sesc)
                midC = (curmax_sesc + curmin_sesc) / 2
                registerSessionTargetEx(midC, sesc_css, sesc_txt + " Mid", sessionMidLineWidth)
        if show_sesd and sesd_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesd, sesd_css, sesd_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesd, sesd_css, sesd_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesd) and not na(curmin_sesd)
                midD = (curmax_sesd + curmin_sesd) / 2
                registerSessionTargetEx(midD, sesd_css, sesd_txt + " Mid", sessionMidLineWidth)

    if showDayOpenLine and not na(open_today_price)
        drawTargetLineLabel(bar_index, open_today_price, open_line_color, openLineWidth, openLineStyle, openLineTransparency, "H Day Open", targetLabelGapBars, 2)

    if showDayCloseLine and not na(close_yesterday_price)
        drawTargetLineLabel(bar_index, close_yesterday_price, close_line_color, closeLineWidth, closeLineStyle, closeLineTransparency, "L Day Close", targetLabelGapBars, 2)

    if showDayOCBox and not na(open_today_price) and not na(close_yesterday_price)
        boxTop = math.max(open_today_price, close_yesterday_price)
        boxBot = math.min(open_today_price, close_yesterday_price)
        ocBox = box.new(left = bar_index, top = boxTop, right = bar_index + targetLabelGapBars, bottom = boxBot, bgcolor = dayOCBoxBgColor, border_color = color.new(color.white, 70), border_width = 1, border_style = line.style_solid)
        trackBox(ocBox)
        ocLbl = label.new(x = getStaggerX(boxTop, bar_index + targetLabelGapBars, 2), y = boxTop, text = "OC Panel", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.white, 0), size = size.tiny)
        trackLabel(ocLbl)

    // تارگت‌های زمانی عمودی — امروز + روزهای قبلی (Display Days)
    if enableTimeTargets
        int yToday = year(timenow, tz)
        int mToday = month(timenow, tz)
        int dToday = dayofmonth(timenow, tz)
        // ظهر امروز؛ عقب‌رفتن با روز کامل تا اثر DST کمتر شود
        int noonToday = timestamp(tz, yToday, mToday, dToday, 12, 0, 0)
        ttLnStyle = dayOcStyleFromString(timeTargetStyle)
        color ttCol = color.new(timeTargetColor, timeTargetTransparency)
        float ttLabelY = high
        array<string> ttParts = str.split(timeTargetsCsv, ',')
        if ttParts.size() > 0
            for dayOffset = 0 to timeTargetDisplayDays - 1
                int dayAnchor = noonToday - dayOffset * 86400000
                int yDay = year(dayAnchor, tz)
                int mDay = month(dayAnchor, tz)
                int dDay = dayofmonth(dayAnchor, tz)
                for ti = 0 to ttParts.size() - 1
                    string rawT = str.replace_all(str.trim(ttParts.get(ti)), ' ', '')
                    if str.length(rawT) >= 4
                        array<string> hm = str.split(rawT, ':')
                        if hm.size() >= 2
                            float hhF = str.tonumber(hm.get(0))
                            float mmF = str.tonumber(hm.get(1))
                            if not na(hhF) and not na(mmF)
                                int hh = int(hhF)
                                int mm = int(mmF)
                                if hh >= 0 and hh <= 23 and mm >= 0 and mm <= 59
                                    int ts = timestamp(tz, yDay, mDay, dDay, hh, mm, 0)
                                    if not na(ts) and canDrawLine()
                                        line ttLn = line.new(x1 = ts, y1 = ttLabelY, x2 = ts, y2 = ttLabelY * 0.999, xloc = xloc.bar_time, extend = extend.both, color = ttCol, width = timeTargetWidth, style = ttLnStyle)
                                        trackLine(ttLn)
                                        if showTimeTargetLabels and canDrawLabel()
                                            string lblTxt = (hh < 10 ? '0' : '') + str.tostring(hh) + ':' + (mm < 10 ? '0' : '') + str.tostring(mm)
                                            label ttLbl = label.new(x = ts, y = ttLabelY, text = lblTxt, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = ttCol, size = textSizeFromString(timeTargetLabelSize))
                                            trackLabel(ttLbl)

    // MAP Weekly Targets — High/Low هفتهٔ قبل + ریتریس و اکستنشن (مانند MAPWeekly.cs)
    if enableMapWeekly and not na(mapPwHigh) and not na(mapPwLow)
        float mapRange = mapPwHigh - mapPwLow
        if mapRange > 0
            // شروع هفتهٔ جاری (مثل MAPWeekly.cs) تا انتهای امتداد
            int mapStartTime = time("W")
            int tfMs = math.max(timeframe.in_seconds() * 1000, 1000)
            int mapEndTime = time + mapExtendBars * tfMs
            int mapLabelBarX = bar_index + mapExtendBars
            float mapMid = (mapPwHigh + mapPwLow) / 2.0
            float map25 = mapPwLow + mapRange * 0.25
            float map75 = mapPwLow + mapRange * 0.75

            if mapShowHigh
                drawMapWeeklyLevel(mapPwHigh, "PW High", mapHighColor, mapKeyLineWidth, mapKeyLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
            if mapShowLow
                drawMapWeeklyLevel(mapPwLow, "PW Low", mapLowColor, mapKeyLineWidth, mapKeyLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
            if mapShowMid
                drawMapWeeklyLevel(mapMid, "50%", mapMidColor, mapMidLineWidth, mapMidLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
            if mapShow25
                drawMapWeeklyLevel(map25, "25%", mapRetraceColor, mapMidLineWidth, mapMidLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
            if mapShow75
                drawMapWeeklyLevel(map75, "75%", mapRetraceColor, mapMidLineWidth, mapMidLineStyle, mapStartTime, mapEndTime, mapLabelBarX)

            if mapShowExtAbove
                if mapShow1125
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.125, "1.125x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow125
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.25, "1.25x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow1375
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.375, "1.375x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow150
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.50, "1.5x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow175
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.75, "1.75x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow200
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 1.00, "2x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)

            if mapShowExtBelow
                if mapShow1125
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.125, "1.125x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow125
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.25, "1.25x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow1375
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.375, "1.375x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow150
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.50, "1.5x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow175
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.75, "1.75x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)
                if mapShow200
                    drawMapWeeklyLevel(mapPwLow - mapRange * 1.00, "2x", mapExtColor, mapExtLineWidth, mapExtLineStyle, mapStartTime, mapEndTime, mapLabelBarX)


//#endregion
