sesd_midline_length = input.int(10, 'Middle Line Extension (Bars)', minval=0, group = 'Session D')

//Timezones
tz_incr = input.int(0, 'UTC (+/-)', group = 'Timezone')
use_exchange = input.bool(false, 'Use Exchange Timezone', group = 'Timezone')

//Ranges Options
bg_transp = input.float(90, 'Range Area Transparency', group = 'Ranges Settings')
show_outline = input.bool(true, 'Range Outline', group = 'Ranges Settings')
outline_width = input.int(1, 'Outline Width', minval=1, maxval=5, group = 'Ranges Settings')
outline_style = input.string(line.style_dotted, "Outline Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = 'Ranges Settings')
outline_transp = input.int(0, 'Outline Transparency', minval=0, maxval=100, group = 'Ranges Settings')
show_txt = input.bool(true, 'Range Label', group = 'Ranges Settings')
midline_style = input.string(line.style_dashed, "Middle Line Style", options = [line.style_solid, line.style_dashed, line.style_dotted], group = 'Ranges Settings')
midline_width = input.int(1, 'Middle Line Width', minval=1, maxval=5, group = 'Ranges Settings')
midline_transp = input.int(0, 'Middle Line Transparency', minval=0, maxval=100, group = 'Ranges Settings')

// Session target line settings
var GRP_SESTGT = "Session Targets"
enableSessionTargets = input.bool(true, 'Show Session High/Low/Midline as Targets', group = GRP_SESTGT, tooltip = 'سقف، کف و میدلاین هر سشن به‌عنوان تارگت رسم می‌شود')
applySessionHigh = input.bool(true, 'Include Session High (Top)', inline = 'sestgt1', group = GRP_SESTGT)
applySessionLow  = input.bool(true, 'Include Session Low (Bottom)', inline = 'sestgt1', group = GRP_SESTGT)
applySessionMid  = input.bool(true, 'Include Session Midline', inline = 'sestgt1', group = GRP_SESTGT)
sessionHighLineWidth = input.int(1, 'Session High Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionLowLineWidth  = input.int(1, 'Session Low Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionMidLineWidth  = input.int(1, 'Session Mid Line Width', minval = 1, maxval = 4, inline = 'sestgt_w', group = GRP_SESTGT)
sessionTargetLineStyle  = input.string('Dotted', 'Session Target Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP_SESTGT)
sessionTargetLineTransparency = input.int(60, 'Session Target Line Transparency (0=Opaque, 100=Invisible)', minval = 0, maxval = 100, group = GRP_SESTGT)

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
nBar = bar_index

//Get session average
get_avg(session)=>
    var len = 1
    var float csma = na
    var float sma = na

    if session > session[1]
        len := 1
        csma := close
    
    if session != 0 and session == session[1]
        len += 1    
        csma += close
        sma := csma / len
    
    sma

//Get trendline coordinates
get_linreg(session)=>
    var len = 1
    var float cwma  = na
    var float csma  = na
    var float csma2 = na

    var float y1 = na
    var float y2 = na
    var float stdev = na 
    var float r2    = na 

    if session > session[1]
        len   := 1
        cwma  := close
        csma  := close
        csma2 := close * close
    
    if session != 0 and session == session[1]
        len   += 1    
        csma  += close
        csma2 += close * close
        cwma  += close * len

        sma = csma / len
        wma = cwma / (len * (len + 1) / 2)

        cov   = (wma - sma) * (len+1)/2
        stdev := math.sqrt(csma2 / len - sma * sma)
        r2    := cov / (stdev * (math.sqrt(len*len - 1) / (2 * math.sqrt(3))))

        y1 := 4 * sma - 3 * wma
        y2 := 3 * wma - 2 * sma

    [y1 , y2, stdev, r2]

//Set line
set_line(session, y1, y2, session_css)=>
    var line tl = na

    if session > session[1]
        tl := line.new(time, close, time, close, xloc = xloc.bar_time, color = session_css)

    if session != 0 and session == session[1]
        line.set_y1(tl, y1)
        line.set_xy2(tl, time, y2)

// === تغییر ۱: get_range — نمایش فقط N سشن اخیر ===
// extendMidToLast: برای آسیا (Tokyo) خط Mid و همچنین High/Low تا بار جاری ادامه می‌یابند
// مختصات با bar_time تا خطای «x1 too far from current bar» روی تاریخچهٔ بلند پیش نیاید
get_range(session, session_name, session_css, show_midline, midline_length, displayDays, extendMidToLast)=>
    var t = 0 
    var max = high
    var min = low
    var box bx = na
    var label lbl = na 
    var line mid_line = na
    var line high_line = na
    var line low_line = na
    var int start_time = na
    var int end_time = na
    int tfMs = timeframe.in_seconds() * 1000
    
    var array<box>   boxHistory = array.new<box>()
    var array<label> lblHistory = array.new<label>()
    var array<line>  midHistory = array.new<line>()
    var array<line>  highHistory = array.new<line>()
    var array<line>  lowHistory = array.new<line>()

    if session > session[1]
        t := time
        max := high
        min := low
        start_time := time

        border_color_transparent = color.new(session_css, outline_transp)
        
        bx := box.new(start_time, max, time, min
          , xloc = xloc.bar_time
          , bgcolor = color.new(session_css, bg_transp)
          , border_color = show_outline and not extendMidToLast ? border_color_transparent : na
          , border_width = outline_width
          , border_style = outline_style
          )
        boxHistory.push(bx)

        if show_midline
            midline_color_transparent = color.new(session_css, midline_transp)
            mid_line := line.new(
                 start_time, (max + min) / 2, 
                 time, (max + min) / 2, 
                 xloc = xloc.bar_time,
                 color = midline_color_transparent, 
                 style = line.style_dotted,
                 width = midline_width
             )
            midHistory.push(mid_line)

        // آسیا: خط سقف/کف جدا مثل Mid تا انتهای سشن و بعد از آن ادامه یابد
        if extendMidToLast
            hl_color = color.new(session_css, outline_transp)
            high_line := line.new(start_time, max, time, max, xloc = xloc.bar_time, color = hl_color, style = outline_style, width = outline_width)
            low_line := line.new(start_time, min, time, min, xloc = xloc.bar_time, color = hl_color, style = outline_style, width = outline_width)
            highHistory.push(high_line)
            lowHistory.push(low_line)

        if show_txt
            lbl := label.new(t, max, session_name
              , xloc = xloc.bar_time
              , textcolor = session_css
              , style = label.style_label_down
              , color = color.new(color.white, 100)
              , size = size.tiny)
            lblHistory.push(lbl)
        
        while boxHistory.size() > displayDays
            oldBox = boxHistory.shift()
            box.delete(oldBox)
        while lblHistory.size() > displayDays
            oldLbl = lblHistory.shift()
            label.delete(oldLbl)
        while midHistory.size() > displayDays
            oldMid = midHistory.shift()
            line.delete(oldMid)
        while highHistory.size() > displayDays
            oldHi = highHistory.shift()
            line.delete(oldHi)
        while lowHistory.size() > displayDays
            oldLo = lowHistory.shift()
            line.delete(oldLo)

    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        end_time := time

        if not na(bx)
            box.set_top(bx, max)
            box.set_rightbottom(bx, time, min)

        if show_midline and not na(mid_line) and not na(start_time)
            float midY = (max + min) / 2
            line.set_xy1(mid_line, start_time, midY)
            line.set_xy2(mid_line, end_time + midline_length * tfMs, midY)

        if extendMidToLast and not na(start_time)
            int hlEnd = end_time + midline_length * tfMs
            if not na(high_line)
                line.set_xy1(high_line, start_time, max)
                line.set_xy2(high_line, hlEnd, max)
            if not na(low_line)
                line.set_xy1(low_line, start_time, min)
                line.set_xy2(low_line, hlEnd, min)
    
        if show_txt and not na(lbl)
            label.set_xy(lbl, int(math.avg(t, time)), max)
    
    if extendMidToLast and session == 0 and not na(start_time)
        if show_midline and not na(mid_line)
            line.set_xy2(mid_line, time, (max + min) / 2)
        if not na(high_line)
            line.set_xy1(high_line, start_time, max)
            line.set_xy2(high_line, time, max)
        if not na(low_line)
            line.set_xy1(low_line, start_time, min)
            line.set_xy2(low_line, time, min)
    
    [session != 0 ? na : max, session != 0 ? na : min, max, min]
//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{
tf = timeframe.period

var tz = use_exchange ? syminfo.timezone :
  str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

is_sesa = math.sign(nz(time(tf, sesa_ses, tz)))
is_sesb = math.sign(nz(time(tf, sesb_ses, tz)))
is_sesc = math.sign(nz(time(tf, sesc_ses, tz)))
is_sesd = math.sign(nz(time(tf, sesd_ses, tz)))

//-----------------------------------------------------------------------------}
//Overlays
//-----------------------------------------------------------------------------{
var float max_sesa = na
var float min_sesa = na
var float max_sesb = na
var float min_sesb = na
var float max_sesc = na
var float min_sesc = na
var float max_sesd = na
var float min_sesd = na

var float curmax_sesa = na
var float curmin_sesa = na
var float curmax_sesb = na
var float curmin_sesb = na
var float curmax_sesc = na
var float curmin_sesc = na
var float curmax_sesd = na
var float curmin_sesd = na

if show_sesa and sesa_range
    [max, min, curmax, curmin] = get_range(is_sesa, sesa_txt, sesa_css, sesa_midline, sesa_midline_length, sessionDisplayDays, false)
    max_sesa := max
    min_sesa := min
    curmax_sesa := curmax
    curmin_sesa := curmin

if show_sesb and sesb_range
    [max, min, curmax, curmin] = get_range(is_sesb, sesb_txt, sesb_css, sesb_midline, sesb_midline_length, sessionDisplayDays, false)
    max_sesb := max
    min_sesb := min
    curmax_sesb := curmax
    curmin_sesb := curmin

if show_sesc and sesc_range
    [max, min, curmax, curmin] = get_range(is_sesc, sesc_txt, sesc_css, sesc_midline, sesc_midline_length, sessionDisplayDays, true)
    max_sesc := max
    min_sesc := min
    curmax_sesc := curmax
    curmin_sesc := curmin

if show_sesd and sesd_range
    [max, min, curmax, curmin] = get_range(is_sesd, sesd_txt, sesd_css, sesd_midline, sesd_midline_length, sessionDisplayDays, false)
    max_sesd := max
    min_sesd := min
    curmax_sesd := curmax
    curmin_sesd := curmin

//Mean
if show_sesa and sesa_avg
    avg = get_avg(is_sesa)
    set_line(is_sesa, avg, avg, sesa_css)

if show_sesb and sesb_avg
    avg = get_avg(is_sesb)
    set_line(is_sesb, avg, avg, sesb_css)

if show_sesc and sesc_avg
    avg = get_avg(is_sesc)
    set_line(is_sesc, avg, avg, sesc_css)

if show_sesd and sesd_avg
    avg = get_avg(is_sesd)
    set_line(is_sesd, avg, avg, sesd_css)

//-----------------------------------------------------------------------------

var GRP_DAYOC = "Day Open/Close"
showDayOpenLine = input.bool(true, 'Show Day Open Line', inline = 'dayoc_show', group = GRP_DAYOC)
showDayCloseLine = input.bool(true, 'Show Day Close Line', inline = 'dayoc_show', group = GRP_DAYOC)
open_line_color = input.color(color.green, 'Open Line Color', inline = 'dayoc_col', group = GRP_DAYOC)
close_line_color = input.color(color.red, 'Close Line Color', inline = 'dayoc_col', group = GRP_DAYOC)
openLineWidth = input.int(2, 'Open Line Width', minval = 1, maxval = 5, inline = 'dayoc_w', group = GRP_DAYOC)
closeLineWidth = input.int(2, 'Close Line Width', minval = 1, maxval = 5, inline = 'dayoc_w', group = GRP_DAYOC)
openLineStyle = input.string('Solid', 'Open Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'dayoc_st', group = GRP_DAYOC)
closeLineStyle = input.string('Dotted', 'Close Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'dayoc_st', group = GRP_DAYOC)
openLineTransparency = input.int(0, 'Open Line Transparency', minval = 0, maxval = 100, inline = 'dayoc_tr', group = GRP_DAYOC)
closeLineTransparency = input.int(0, 'Close Line Transparency', minval = 0, maxval = 100, inline = 'dayoc_tr', group = GRP_DAYOC)
line_length_factor_1m = input.int(130, 'Line Length Factor (1m)', minval = 1, group = GRP_DAYOC)
line_length_factor_5m = input.int(24, 'Line Length Factor (5m)', minval = 1, group = GRP_DAYOC)
line_length_factor_15m = input.int(7, 'Line Length Factor (15m)', minval = 1, group = GRP_DAYOC)
line_length_factor_other = input.int(10, 'Line Length Factor (Other TF)', minval = 1, group = GRP_DAYOC)
showDayOCBox = input.bool(true, 'Show Day Open/Close Panel', group = GRP_DAYOC, tooltip = 'یک باکس در سمت راست نمودار که قیمت اپن امروز و کلوز دیروز را نشان می‌دهد')
dayOCBoxBgColor = input.color(color.new(color.blue, 85), 'Panel Background Color', group = GRP_DAYOC)

var GRP_TIMETGT = "Time Targets (Vertical)"
enableTimeTargets = input.bool(true, 'Show Time Targets', group = GRP_TIMETGT, tooltip = 'خطوط عمودی روی ساعت‌های داده‌شده، بر اساس تایم‌زون انتخابی همین گروه')
timeTargetTzMode = input.string('Custom UTC', 'Timezone', options = ['Custom UTC', 'Same as Sessions', 'Exchange'], group = GRP_TIMETGT, tooltip = 'Custom UTC = آفست زیر | Same as Sessions = همان تایم‌زون گروه Timezone سشن‌ها | Exchange = تایم‌زون صرافی نماد')
timeTargetUtcOffset = input.float(3.5, 'UTC Offset (hours)', minval = -12.0, maxval = 14.0, step = 0.25, group = GRP_TIMETGT, tooltip = 'فقط وقتی Timezone = Custom UTC. پیش‌فرض ۳.۵ = UTC+03:30. مثال: 0 = UTC، 3 = UTC+3، 3.5 = UTC+3:30')
timeTargetDisplayDays = input.int(1, 'Display Days', minval = 1, maxval = 10, group = GRP_TIMETGT, tooltip = 'تعداد روزهای نمایش: ۱ = فقط امروز، ۲ = امروز + دیروز، و همین‌طور بیشتر')
timeTargetsCsv = input.string('03:30,04:30,08:00,09:00,09:30,10:30,14:30,15:00,15:30,16:00,16:30,17:00,17:30,18:00,20:00,21:30,23:00,23:30', 'Times (HH:MM, comma-separated)', group = GRP_TIMETGT, tooltip = 'لیست تایم‌ها با کاما در همان تایم‌زون انتخابی؛ پیش‌فرض برای UTC+03:30')
timeTargetColor = input.color(color.new(#78909c, 0), 'Line Color', inline = 'tt_col', group = GRP_TIMETGT)
timeTargetWidth = input.int(1, 'Line Width', minval = 1, maxval = 5, inline = 'tt_col', group = GRP_TIMETGT)
timeTargetStyle = input.string('Dotted', 'Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'tt_st', group = GRP_TIMETGT)
timeTargetTransparency = input.int(50, 'Line Transparency', minval = 0, maxval = 100, inline = 'tt_st', group = GRP_TIMETGT)
showTimeTargetLabels = input.bool(true, 'Show Time Labels', group = GRP_TIMETGT)
timeTargetLabelSize = input.string('Tiny', 'Label Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP_TIMETGT)

// ساخت رشتهٔ تایم‌زون UTC از آفست ساعتی (مثلاً 3.5 → UTC+3:30)
formatUtcOffsetTz(float hoursOffset) =>
    float absH = math.abs(hoursOffset)
    int whole = int(math.floor(absH + 1e-9))
    int mins = int(math.round((absH - whole) * 60.0))
    if mins >= 60
        whole += 1
        mins := 0
    string sign = hoursOffset >= 0 ? '+' : '-'
    mins == 0 ? str.format('UTC{0}{1}', sign, whole) : str.format('UTC{0}{1}:{2}', sign, whole, mins < 10 ? '0' + str.tostring(mins) : str.tostring(mins))

// MAP Weekly — سطوح هفتهٔ قبل (مانند MAPWeekly.cs)
var GRP_MAPW = "MAP Weekly Targets"
enableMapWeekly = input.bool(false, 'Show MAP Weekly Targets', group = GRP_MAPW, tooltip = 'حدود ۱۳ خط از High/Low هفتهٔ قبل. اول از همه رسم می‌شود تا با تارگت‌های زیاد یا Heavy script حذف نشود.')
mapShowHigh = input.bool(true, 'Show Weekly High', inline = 'map_key', group = GRP_MAPW)
mapShowLow  = input.bool(true, 'Show Weekly Low', inline = 'map_key', group = GRP_MAPW)
mapShowMid  = input.bool(true, 'Show 50% Mid', inline = 'map_mid', group = GRP_MAPW)
mapShow25   = input.bool(true, 'Show 25%', inline = 'map_mid', group = GRP_MAPW)
mapShow75   = input.bool(true, 'Show 75%', inline = 'map_mid', group = GRP_MAPW)
mapShowExtAbove = input.bool(true, 'Extensions Above High', inline = 'map_ext', group = GRP_MAPW)
mapShowExtBelow = input.bool(true, 'Extensions Below Low', inline = 'map_ext', group = GRP_MAPW)
mapShow1125 = input.bool(false, '1.125x', inline = 'map_x1', group = GRP_MAPW)
mapShow125  = input.bool(true, '1.25x', inline = 'map_x1', group = GRP_MAPW)
mapShow1375 = input.bool(false, '1.375x', inline = 'map_x1', group = GRP_MAPW)
mapShow150  = input.bool(true, '1.5x', inline = 'map_x2', group = GRP_MAPW)
mapShow175  = input.bool(true, '1.75x', inline = 'map_x2', group = GRP_MAPW)
mapShow200  = input.bool(true, '2x', inline = 'map_x2', group = GRP_MAPW)
mapExtendBars = input.int(150, 'Extend Lines (Bars)', minval = 0, maxval = 490, group = GRP_MAPW)
mapShowLabels = input.bool(true, 'Show Labels', group = GRP_MAPW)
mapLineTransparency = input.int(30, 'Line Transparency', minval = 0, maxval = 100, group = GRP_MAPW)
mapKeyLineWidth = input.int(1, 'Key Line Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapMidLineWidth = input.int(1, 'Mid/Retrace Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapExtLineWidth = input.int(1, 'Extension Width', minval = 1, maxval = 5, inline = 'map_w', group = GRP_MAPW)
mapKeyLineStyle = input.string('Dotted', 'Key Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapMidLineStyle = input.string('Dotted', 'Mid Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapExtLineStyle = input.string('Dotted', 'Extension Line Style', options = ['Solid', 'Dashed', 'Dotted'], inline = 'map_st', group = GRP_MAPW)
mapHighColor = input.color(#FF4D6D, 'High Color', inline = 'map_c1', group = GRP_MAPW)
mapLowColor  = input.color(#7CFF47, 'Low Color', inline = 'map_c1', group = GRP_MAPW)
mapMidColor  = input.color(#FFE566, 'Mid Color', inline = 'map_c2', group = GRP_MAPW)
mapRetraceColor = input.color(#7AA2FF, '25/75% Color', inline = 'map_c2', group = GRP_MAPW)
mapExtColor = input.color(#C084FC, 'Extension Color', group = GRP_MAPW)

dayOcStyleFromString(string s) =>
    s == 'Solid' ? line.style_solid : s == 'Dashed' ? line.style_dashed : line.style_dotted

line_length_factor = switch
    timeframe.isminutes and timeframe.period == "1" => line_length_factor_1m
    timeframe.isminutes and timeframe.period == "5" => line_length_factor_5m
    timeframe.isminutes and timeframe.period == "15" => line_length_factor_15m
    => line_length_factor_other

line_length = math.round(line_length_factor * 10)

is_new_day = ta.change(time("D")) != 0

// هفتهٔ قبل از کندل استاندارد — روی Range/Renko نباید از tickerid چارت استفاده شود
// چون tickerid نوع چارت را داخل خودش دارد و Weekly اشتباه می‌سازد
mapStdTicker = ticker.standard(syminfo.tickerid)
[mapPwHighRaw, mapPwLowRaw, mapPrevWeekTime] = request.security(mapStdTicker, "W", [high[1], low[1], time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// قفل با شناسهٔ هفته از خود security — روی رنج دقیق‌تر از ta.change(time("W")) چارت
var float mapPwHigh = na
var float mapPwLow = na
var int mapLockedWeekTime = na
bool mapRawOk = not na(mapPwHighRaw) and not na(mapPwLowRaw) and mapPwHighRaw > mapPwLowRaw and not na(mapPrevWeekTime)
if mapRawOk and (na(mapLockedWeekTime) or mapPrevWeekTime != mapLockedWeekTime)
    mapPwHigh := mapPwHighRaw
    mapPwLow := mapPwLowRaw
    mapLockedWeekTime := mapPrevWeekTime

// رسم MAP: از ایندکس کندل (حداکثر ~۴۹۰ عقب) تا جلو — کم‌حجم، اولویت اول بعد از clear
drawMapWeeklyLevel(float price, color col, int width, string styleStr, int startIdx, int endIdx) =>
    if not na(price) and not na(startIdx) and not na(endIdx) and canDrawMapLine()
        lnStyle = styleFromString(styleStr)
        int sIdx = math.max(0, math.min(startIdx, endIdx - 1))
        int eIdx = math.max(sIdx + 1, endIdx)
        trackMapLine(line.new(chart.point.from_index(sIdx, price), chart.point.from_index(eIdx, price), color = color.new(col, mapLineTransparency), width = width, style = lnStyle))
        if mapShowLabels and canDrawMapLabel()
            int baseX = targetLabelBaseX(mapExtendBars)
            int lineEnd = targetLabelMaxX(mapExtendBars)
            int lblX = getStaggerX(price, baseX, 2, lineEnd)
            trackMapLabel(label.new(x = lblX, y = labelYAboveLine(price), text = "W.L", style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = textSizeFromString(targetLabelSize)))

// تعداد کندل از ابتدای هفتهٔ جاری؛ روی رنج/غیرزمانی از lookback ثابت استفاده می‌شود
mapBarsSinceWeekStart() =>
    int result = MAP_MAX_LOOKBACK
    int secs = timeframe.in_seconds()
    // رنج/رنکو/تیک: طول کندل ثابت نیست → in_seconds = na
    if not na(secs) and secs > 0
        int tfMs = secs * 1000
        int weekStart = time("W")
        if not na(weekStart) and weekStart > 0 and not na(time)
            result := int(math.max((time - weekStart) / tfMs, 1))
    result

drawAllMapWeeklyLevels() =>
    if enableMapWeekly and not na(mapPwHigh) and not na(mapPwLow)
        float mapRange = mapPwHigh - mapPwLow
        if mapRange > 0
            int lookback = math.min(math.max(mapBarsSinceWeekStart(), 10), MAP_MAX_LOOKBACK)
            int startIdx = math.max(0, bar_index - lookback)
            int endIdx = bar_index + math.max(mapExtendBars, 10)
            float mapMid = (mapPwHigh + mapPwLow) / 2.0
            float map25 = mapPwLow + mapRange * 0.25
            float map75 = mapPwLow + mapRange * 0.75

            if mapShowHigh
                drawMapWeeklyLevel(mapPwHigh, mapHighColor, mapKeyLineWidth, mapKeyLineStyle, startIdx, endIdx)
            if mapShowLow
                drawMapWeeklyLevel(mapPwLow, mapLowColor, mapKeyLineWidth, mapKeyLineStyle, startIdx, endIdx)
            if mapShowMid
                drawMapWeeklyLevel(mapMid, mapMidColor, mapMidLineWidth, mapMidLineStyle, startIdx, endIdx)
            if mapShow25
                drawMapWeeklyLevel(map25, mapRetraceColor, mapMidLineWidth, mapMidLineStyle, startIdx, endIdx)
            if mapShow75
                drawMapWeeklyLevel(map75, mapRetraceColor, mapMidLineWidth, mapMidLineStyle, startIdx, endIdx)

            if mapShowExtAbove
                if mapShow1125
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.125, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow125
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.25, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow1375
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.375, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow150
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.50, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow175
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 0.75, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow200
                    drawMapWeeklyLevel(mapPwHigh + mapRange * 1.00, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)

            if mapShowExtBelow
                if mapShow1125
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.125, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow125
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.25, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow1375
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.375, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow150
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.50, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow175
                    drawMapWeeklyLevel(mapPwLow - mapRange * 0.75, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)
                if mapShow200
                    drawMapWeeklyLevel(mapPwLow - mapRange * 1.00, mapExtColor, mapExtLineWidth, mapExtLineStyle, startIdx, endIdx)

[open_1m, close_1m] = if showDayOpenLine or showDayCloseLine or showDayOCBox
    request.security(ticker.standard(syminfo.tickerid), "1", [open, close], lookahead=barmerge.lookahead_off)
else
    [na, na]

var float open_today_price = na
var float close_yesterday_price = na

var int dayCountOpenClose = 0

if is_new_day
    open_today_price := open_1m
    close_yesterday_price := close_1m[1]
    dayCountOpenClose += 1

// Reuse 2 var lines — avoid creating a new line on every bar
var line dayOpenHistLine = na
var line dayCloseHistLine = na
openLnStyle = dayOcStyleFromString(openLineStyle)
closeLnStyle = dayOcStyleFromString(closeLineStyle)
if dayCountOpenClose <= 2
    if showDayOpenLine and not na(open_today_price)
        if na(dayOpenHistLine)
            dayOpenHistLine := line.new(bar_index, open_today_price, bar_index - line_length, open_today_price, color = color.new(open_line_color, openLineTransparency), width = openLineWidth, style = openLnStyle)
        else
            line.set_xy1(dayOpenHistLine, bar_index, open_today_price)
            line.set_xy2(dayOpenHistLine, bar_index - line_length, open_today_price)
            line.set_color(dayOpenHistLine, color.new(open_line_color, openLineTransparency))
            line.set_width(dayOpenHistLine, openLineWidth)
            line.set_style(dayOpenHistLine, openLnStyle)
    if showDayCloseLine and not na(close_yesterday_price)
        if na(dayCloseHistLine)
            dayCloseHistLine := line.new(bar_index, close_yesterday_price, bar_index - line_length, close_yesterday_price, color = color.new(close_line_color, closeLineTransparency), width = closeLineWidth, style = closeLnStyle)
        else
            line.set_xy1(dayCloseHistLine, bar_index, close_yesterday_price)
            line.set_xy2(dayCloseHistLine, bar_index - line_length, close_yesterday_price)
            line.set_color(dayCloseHistLine, color.new(close_line_color, closeLineTransparency))
            line.set_width(dayCloseHistLine, closeLineWidth)
            line.set_style(dayCloseHistLine, closeLnStyle)

// ================================================================================================
// بخش ج: ثبت سقف/کف/میدلاین هر سشن به‌عنوان تارگت + اپن/کلوز روزانه + پنل
// ================================================================================================
//#region ———————————————————— SESSION TARGETS


registerSessionTargetEx(float price, color col, string labelText, int lineWidth) =>
    if not na(price) and canDrawLine() and canDrawLabel()
        drawTargetLineLabel(bar_index, price, col, lineWidth, sessionTargetLineStyle, sessionTargetLineTransparency, labelText, targetLabelGapBars, 2)

if bar_index == last_bar_index
    clearDrawings()
    resetLabelStagger()

    if deleteHitTargets
        prepareHitWindow(hitGraceBarsInput)

    // MAP اول — فقط حدود ۱۳ خط؛ قبل از تارگت‌های قیمتی تا با Heavy script حذف نشود
    drawAllMapWeeklyLevels()

    bool showStarred  = nodeDisplayMode == 'Starred'
    bool showStarless = nodeDisplayMode == 'Starless'

    if showStarred
        if cNodeSym.nodesUp.size() > 0
            cNodeSym.drawingNumberNodes(true,  "*", verticalGapInput, showRegularStarredNodes, showDoubleStarNodesInput, nodeLabelDistPct, incompleteNode2RadiusPct, incompleteNode2RadiusBars, incompleteNode2CircleColor, incompleteNode2FillTransparency)
        if cNodeSym.nodesDown.size() > 0
            cNodeSym.drawingNumberNodes(false, "*", verticalGapInput, showRegularStarredNodes, showDoubleStarNodesInput, nodeLabelDistPct, incompleteNode2RadiusPct, incompleteNode2RadiusBars, incompleteNode2CircleColor, incompleteNode2FillTransparency)
    if showStarless
        if cNodeNoSym.nodesUp.size() > 0
            cNodeNoSym.drawingNumberNodes(true,  "", 0, true, false, nodeLabelDistPct, incompleteNode2RadiusPct, incompleteNode2RadiusBars, incompleteNode2CircleColor, incompleteNode2FillTransparency)
        if cNodeNoSym.nodesDown.size() > 0
            cNodeNoSym.drawingNumberNodes(false, "", 0, true, false, nodeLabelDistPct, incompleteNode2RadiusPct, incompleteNode2RadiusBars, incompleteNode2CircleColor, incompleteNode2FillTransparency)

    NDS cTarget = showStarred ? cNodeSym : cNodeNoSym

    if enableSingleNode1Targets
        if showTargetNode1Up
            cTarget.drawingTargetsNode1(true,  showTargetDoubleInput, showTargetDouble15Input, showTargetDouble086Input, showTargetMinInput, showTargetCorrectionInput, showTargetBasedMin13Input, targetDoubleWidth, targetDouble15Width, targetDouble086Width, targetMinWidth, targetCorrectionWidth, targetDoubleStyle, targetDouble15Style, targetDouble086Style, targetMinStyle, targetCorrectionStyle, targetNode1MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency, double086Ratio, double15Ratio, min085Ratio, basedRetraceRatio, basedMinExtRatio, minDblProximityTolPct, proximityMarkerRadiusPct, proximityMarkerRadiusBars, proximityMarkerColor, proximityMarkerFillTransparency)
        if showTargetNode1Down
            cTarget.drawingTargetsNode1(false, showTargetDoubleInput, showTargetDouble15Input, showTargetDouble086Input, showTargetMinInput, showTargetCorrectionInput, showTargetBasedMin13Input, targetDoubleWidth, targetDouble15Width, targetDouble086Width, targetMinWidth, targetCorrectionWidth, targetDoubleStyle, targetDouble15Style, targetDouble086Style, targetMinStyle, targetCorrectionStyle, targetNode1MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency, double086Ratio, double15Ratio, min085Ratio, basedRetraceRatio, basedMinExtRatio, minDblProximityTolPct, proximityMarkerRadiusPct, proximityMarkerRadiusBars, proximityMarkerColor, proximityMarkerFillTransparency)

    if enableSingleNode2Targets
        if showTargetNode1Up
            cTarget.drawingTargetsNode2(true,  showTargetNode2Input, targetNode2Width, targetNode2Style, targetNode2MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)
        if showTargetNode1Down
            cTarget.drawingTargetsNode2(false, showTargetNode2Input, targetNode2Width, targetNode2Style, targetNode2MaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)

    if enablePairNode12Targets
        if showTargetNode1Up
            cTarget.drawingPairTargetsNode12(true,  showPairMinInput, showPairMaxInput, showPairDoubleInput, showPairCorrectionInput, pairMinWidth, pairMaxWidth, pairDoubleWidth, pairCorrectionWidth, pairMinStyle, pairMaxStyle, pairDoubleStyle, pairCorrectionStyle, pairTargetMaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)
        if showTargetNode1Down
            cTarget.drawingPairTargetsNode12(false, showPairMinInput, showPairMaxInput, showPairDoubleInput, showPairCorrectionInput, pairMinWidth, pairMaxWidth, pairDoubleWidth, pairCorrectionWidth, pairMinStyle, pairMaxStyle, pairDoubleStyle, pairCorrectionStyle, pairTargetMaxCount, targetLabelGapBars, deleteHitTargets, hitGraceBarsInput, targetLineTransparency)

    if enableRoundTargets
        if roundApplyUp
            drawRoundNumberTargets(roundBasePrice, true,  targetLabelGapBars, roundDeleteHit, roundHitGraceBars, roundLineWidth, roundLineStyle, roundLineTransparency, roundLineColor, roundMinVisiblePrice, startPointInput, true)
        if roundApplyDown
            drawRoundNumberTargets(roundBasePrice, false, targetLabelGapBars, roundDeleteHit, roundHitGraceBars, roundLineWidth, roundLineStyle, roundLineTransparency, roundLineColor, roundMinVisiblePrice, startPointInput, not roundApplyUp)

    if enableSessionTargets
        if show_sesa and sesa_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesa, sesa_css, sesa_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesa, sesa_css, sesa_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesa) and not na(curmin_sesa)
                midA = (curmax_sesa + curmin_sesa) / 2
                registerSessionTargetEx(midA, sesa_css, sesa_txt + " Mid", sessionMidLineWidth)
        if show_sesb and sesb_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesb, sesb_css, sesb_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesb, sesb_css, sesb_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesb) and not na(curmin_sesb)
                midB = (curmax_sesb + curmin_sesb) / 2
                registerSessionTargetEx(midB, sesb_css, sesb_txt + " Mid", sessionMidLineWidth)
        if show_sesc and sesc_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesc, sesc_css, sesc_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesc, sesc_css, sesc_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesc) and not na(curmin_sesc)
                midC = (curmax_sesc + curmin_sesc) / 2
                registerSessionTargetEx(midC, sesc_css, sesc_txt + " Mid", sessionMidLineWidth)
        if show_sesd and sesd_range
            if applySessionHigh
                registerSessionTargetEx(curmax_sesd, sesd_css, sesd_txt + " High", sessionHighLineWidth)
            if applySessionLow
                registerSessionTargetEx(curmin_sesd, sesd_css, sesd_txt + " Low", sessionLowLineWidth)
            if applySessionMid and not na(curmax_sesd) and not na(curmin_sesd)
                midD = (curmax_sesd + curmin_sesd) / 2
                registerSessionTargetEx(midD, sesd_css, sesd_txt + " Mid", sessionMidLineWidth)

    if showDayOpenLine and not na(open_today_price)
        drawTargetLineLabel(bar_index, open_today_price, open_line_color, openLineWidth, openLineStyle, openLineTransparency, "H Day Open", targetLabelGapBars, 2)

    if showDayCloseLine and not na(close_yesterday_price)
        drawTargetLineLabel(bar_index, close_yesterday_price, close_line_color, closeLineWidth, closeLineStyle, closeLineTransparency, "L Day Close", targetLabelGapBars, 2)

    if showDayOCBox and not na(open_today_price) and not na(close_yesterday_price)
        boxTop = math.max(open_today_price, close_yesterday_price)
        boxBot = math.min(open_today_price, close_yesterday_price)
        ocBox = box.new(left = bar_index, top = boxTop, right = bar_index + targetLabelGapBars, bottom = boxBot, bgcolor = dayOCBoxBgColor, border_color = color.new(color.white, 70), border_width = 1, border_style = line.style_solid)
        trackBox(ocBox)

    // تارگت‌های زمانی عمودی — آخر صف بودجه (اگر جا کم باشد حذف می‌شوند، نه تارگت قیمتی)
    if enableTimeTargets
        string ttTz = timeTargetTzMode == 'Exchange' ? syminfo.timezone : timeTargetTzMode == 'Same as Sessions' ? tz : formatUtcOffsetTz(timeTargetUtcOffset)
        int yToday = year(timenow, ttTz)
        int mToday = month(timenow, ttTz)
        int dToday = dayofmonth(timenow, ttTz)
        int noonToday = timestamp(ttTz, yToday, mToday, dToday, 12, 0, 0)
        ttLnStyle = dayOcStyleFromString(timeTargetStyle)
        color ttCol = color.new(timeTargetColor, timeTargetTransparency)
        float ttLabelY = high
        array<string> ttParts = str.split(timeTargetsCsv, ',')
        if ttParts.size() > 0
            for dayOffset = 0 to timeTargetDisplayDays - 1
                int dayAnchor = noonToday - dayOffset * 86400000
                int yDay = year(dayAnchor, ttTz)
                int mDay = month(dayAnchor, ttTz)
                int dDay = dayofmonth(dayAnchor, ttTz)
                for ti = 0 to ttParts.size() - 1
                    string rawT = str.replace_all(str.trim(ttParts.get(ti)), ' ', '')
                    if str.length(rawT) >= 4
                        array<string> hm = str.split(rawT, ':')
                        if hm.size() >= 2
                            float hhF = str.tonumber(hm.get(0))
                            float mmF = str.tonumber(hm.get(1))
                            if not na(hhF) and not na(mmF)
                                int hh = int(hhF)
                                int mm = int(mmF)
                                if hh >= 0 and hh <= 23 and mm >= 0 and mm <= 59
                                    int ts = timestamp(ttTz, yDay, mDay, dDay, hh, mm, 0)
                                    if not na(ts) and canDrawLine()
                                        line ttLn = line.new(x1 = ts, y1 = ttLabelY, x2 = ts, y2 = ttLabelY * 0.999, xloc = xloc.bar_time, extend = extend.both, color = ttCol, width = timeTargetWidth, style = ttLnStyle)
                                        trackLine(ttLn)
                                        if showTimeTargetLabels and canDrawLabel()
                                            string lblTxt = (hh < 10 ? '0' : '') + str.tostring(hh) + ':' + (mm < 10 ? '0' : '') + str.tostring(mm)
                                            label ttLbl = label.new(x = ts, y = ttLabelY, text = lblTxt, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = ttCol, size = textSizeFromString(timeTargetLabelSize))
                                            trackLabel(ttLbl)


//#endregion
