//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
nBar = bar_index

//Get session average
get_avg(session)=>
    var len = 1
    var float csma = na
    var float sma = na

    if session > session[1]
        len := 1
        csma := close
    
    if session != 0 and session == session[1]
        len += 1    
        csma += close
        sma := csma / len
    
    sma

//Get trendline coordinates
get_linreg(session)=>
    var len = 1
    var float cwma  = na
    var float csma  = na
    var float csma2 = na

    var float y1 = na
    var float y2 = na
    var float stdev = na 
    var float r2    = na 

    if session > session[1]
        len   := 1
        cwma  := close
        csma  := close
        csma2 := close * close
    
    if session != 0 and session == session[1]
        len   += 1    
        csma  += close
        csma2 += close * close
        cwma  += close * len

        sma = csma / len
        wma = cwma / (len * (len + 1) / 2)

        cov   = (wma - sma) * (len+1)/2
        stdev := math.sqrt(csma2 / len - sma * sma)
        r2    := cov / (stdev * (math.sqrt(len*len - 1) / (2 * math.sqrt(3))))

        y1 := 4 * sma - 3 * wma
        y2 := 3 * wma - 2 * sma

    [y1 , y2, stdev, r2]

//Set line
set_line(session, y1, y2, session_css)=>
    var line tl = na

    if session > session[1]
        tl := line.new(time, close, time, close, xloc = xloc.bar_time, color = session_css)

    if session != 0 and session == session[1]
        line.set_y1(tl, y1)
        line.set_xy2(tl, time, y2)

// === تغییر ۱: get_range — نمایش فقط N سشن اخیر ===
get_range(session, session_name, session_css, show_midline, midline_length, displayDays, extendMidToLast)=>
    var t = 0 
    var max = high
    var min = low
    var box bx = na
    var label lbl = na 
    var line mid_line = na
    var int start_time = na
    var int end_time = na
    int tfMs = timeframe.in_seconds() * 1000
    
    var array<box>   boxHistory = array.new<box>()
    var array<label> lblHistory = array.new<label>()
    var array<line>  midHistory = array.new<line>()

    if session > session[1]
        t := time
        max := high
        min := low
        start_time := time

        border_color_transparent = color.new(session_css, outline_transp)
        
        bx := box.new(start_time, max, time, min
          , xloc = xloc.bar_time
          , bgcolor = color.new(session_css, bg_transp)
          , border_color = show_outline ? border_color_transparent : na
          , border_width = outline_width
          , border_style = outline_style
          )
        boxHistory.push(bx)

        if show_midline
            midline_color_transparent = color.new(session_css, midline_transp)
            mid_line := line.new(
                 start_time, (max + min) / 2, 
                 time, (max + min) / 2, 
                 xloc = xloc.bar_time,
                 color = midline_color_transparent, 
                 style = line.style_dotted,
                 width = midline_width
             )
            midHistory.push(mid_line)

        if show_txt
            lbl := label.new(t, max, session_name
              , xloc = xloc.bar_time
              , textcolor = session_css
              , style = label.style_label_down
              , color = color.new(color.white, 100)
              , size = size.tiny)
            lblHistory.push(lbl)
        
        while boxHistory.size() > displayDays
            oldBox = boxHistory.shift()
            box.delete(oldBox)
        while lblHistory.size() > displayDays
            oldLbl = lblHistory.shift()
            label.delete(oldLbl)
        while midHistory.size() > displayDays
            oldMid = midHistory.shift()
            line.delete(oldMid)

    if session != 0 and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        end_time := time

        if not na(bx)
            box.set_top(bx, max)
            box.set_rightbottom(bx, time, min)

        if show_midline and not na(mid_line) and not na(start_time)
            float midY = (max + min) / 2
            line.set_xy1(mid_line, start_time, midY)
            line.set_xy2(mid_line, end_time + midline_length * tfMs, midY)
    
        if show_txt and not na(lbl)
            label.set_xy(lbl, int(math.avg(t, time)), max)
    
    if extendMidToLast and show_midline and not na(mid_line) and not na(start_time) and session == 0
        line.set_xy2(mid_line, time, (max + min) / 2)
    
    [session != 0 ? na : max, session != 0 ? na : min, max, min]
//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{
tf = timeframe.period

var tz = use_exchange ? syminfo.timezone :
  str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

is_sesa = math.sign(nz(time(tf, sesa_ses, tz)))
is_sesb = math.sign(nz(time(tf, sesb_ses, tz)))
is_sesc = math.sign(nz(time(tf, sesc_ses, tz)))
is_sesd = math.sign(nz(time(tf, sesd_ses, tz)))

//-----------------------------------------------------------------------------}
//Overlays
//-----------------------------------------------------------------------------{
var float max_sesa = na
var float min_sesa = na
var float max_sesb = na
var float min_sesb = na
var float max_sesc = na
var float min_sesc = na
var float max_sesd = na
var float min_sesd = na

var float curmax_sesa = na
var float curmin_sesa = na
var float curmax_sesb = na
var float curmin_sesb = na
var float curmax_sesc = na
var float curmin_sesc = na
var float curmax_sesd = na
var float curmin_sesd = na

if show_sesa and sesa_range
    [max, min, curmax, curmin] = get_range(is_sesa, sesa_txt, sesa_css, sesa_midline, sesa_midline_length, sessionDisplayDays, false)
    max_sesa := max
    min_sesa := min
    curmax_sesa := curmax
    curmin_sesa := curmin

if show_sesb and sesb_range
    [max, min, curmax, curmin] = get_range(is_sesb, sesb_txt, sesb_css, sesb_midline, sesb_midline_length, sessionDisplayDays, false)
    max_sesb := max
    min_sesb := min
    curmax_sesb := curmax
    curmin_sesb := curmin

if show_sesc and sesc_range
    [max, min, curmax, curmin] = get_range(is_sesc, sesc_txt, sesc_css, sesc_midline, sesc_midline_length, sessionDisplayDays, true)
    max_sesc := max
    min_sesc := min
    curmax_sesc := curmax
    curmin_sesc := curmin

if show_sesd and sesd_range
    [max, min, curmax, curmin] = get_range(is_sesd, sesd_txt, sesd_css, sesd_midline, sesd_midline_length, sessionDisplayDays, false)
    max_sesd := max
    min_sesd := min
    curmax_sesd := curmax
    curmin_sesd := curmin

//Mean
if show_sesa and sesa_avg
    avg = get_avg(is_sesa)
    set_line(is_sesa, avg, avg, sesa_css)

if show_sesb and sesb_avg
    avg = get_avg(is_sesb)
    set_line(is_sesb, avg, avg, sesb_css)

if show_sesc and sesc_avg
    avg = get_avg(is_sesc)
    set_line(is_sesc, avg, avg, sesc_css)

if show_sesd and sesd_avg
    avg = get_avg(is_sesd)
    set_line(is_sesd, avg, avg, sesd_css)

//-----------------------------------------------------------------------------

line_length_factor_1m = input.int(130, title="Line Length Factor for 1 Minute", minval=1)
line_length_factor_5m = input.int(24, title="Line Length Factor for 5 Minutes", minval=1)
line_length_factor_15m = input.int(7, title="Line Length Factor for 15 Minutes", minval=1)
line_length_factor_other = input.int(10, title="Line Length Factor for Other Timeframes", minval=1)

open_line_color = input.color(color.green, title="Open Line Color")
close_line_color = input.color(color.red, title="Close Line Color")

showDayOCBox = input.bool(true, 'Show Day Open/Close Panel', group = 'Day Open/Close', tooltip = 'یک باکس در سمت راست نمودار که قیمت اپن امروز و کلوز دیروز را نشان می‌دهد')
dayOCBoxBgColor = input.color(color.new(color.blue, 85), 'Panel Background Color', group = 'Day Open/Close')

line_length_factor = switch
    timeframe.isminutes and timeframe.period == "1" => line_length_factor_1m
    timeframe.isminutes and timeframe.period == "5" => line_length_factor_5m
    timeframe.isminutes and timeframe.period == "15" => line_length_factor_15m
    => line_length_factor_other

line_length = math.round(line_length_factor * 10)

is_new_day = ta.change(time("D")) != 0

[open_1m, close_1m] = request.security(syminfo.tickerid, "1", [open, close], lookahead=barmerge.lookahead_off)

var float open_today_price = na
var float close_yesterday_price = na

var int dayCountOpenClose = 0

if is_new_day
    open_today_price := open_1m
    close_yesterday_price := close_1m[1]
    dayCountOpenClose += 1

// Reuse 2 var lines — avoid creating a new line on every bar
var line dayOpenHistLine = na
var line dayCloseHistLine = na
if dayCountOpenClose <= 2
    if not na(open_today_price)
        if na(dayOpenHistLine)
            dayOpenHistLine := line.new(bar_index, open_today_price, bar_index - line_length, open_today_price, color=open_line_color, width=2, style=line.style_solid)
        else
            line.set_xy1(dayOpenHistLine, bar_index, open_today_price)
            line.set_xy2(dayOpenHistLine, bar_index - line_length, open_today_price)
            line.set_color(dayOpenHistLine, open_line_color)
    if not na(close_yesterday_price)
        if na(dayCloseHistLine)
            dayCloseHistLine := line.new(bar_index, close_yesterday_price, bar_index - line_length, close_yesterday_price, color=close_line_color, width=2, style=line.style_dotted)
        else
            line.set_xy1(dayCloseHistLine, bar_index, close_yesterday_price)
            line.set_xy2(dayCloseHistLine, bar_index - line_length, close_yesterday_price)
            line.set_color(dayCloseHistLine, close_line_color)

// ================================================================================================
// بخش ج: ثبت سقف/کف/میدلاین هر سشن به‌عنوان تارگت + اپن/کلوز روزانه + پنل + زون‌ها
// ================================================================================================
//#region ———————————————————— SESSION TARGETS → CONFLUENCE ZONES


// ================================================================================================
// بخش POV: Pivot-Anchored Volume Profile (PoC / VAH / VAL)
// ================================================================================================
//#region ———————————————————— POV VOLUME PROFILE

enablePovProfile = input.bool(true, 'Enable Pivot Volume Profile (PoC/VAH/VAL)', group = 'Pivot Points Volume Profile')
pvtLength = input.int(20, 'Pivot Points Left / Right Length', minval = 1, group = 'Pivot Points Volume Profile', tooltip = 'طول تشخیص پیوت (چپ/راست) برای پروفایل‌های تاریخی بین پیوت‌ها')
povDevLookbackMode = input.string('Fixed', 'Developing PoC Lookback Mode', options = ['Fixed', 'Auto (from last pivot)'], group = 'Pivot Points Volume Profile', tooltip = 'Fixed = تعداد کندل ثابت برای رسم PoC/VAH/VAL فعلی | Auto = از آخرین پیوت تا الان')
povDevLookbackBars = input.int(100, 'Candles Back for PoC / VAH / VAL', minval = 5, maxval = 5000, group = 'Pivot Points Volume Profile', tooltip = 'چند کندل قبل برای محاسبه و رسم PoC / VAH / VAL فعلی (فقط وقتی Mode = Fixed)')
isValueArea = input.float(68, 'Value Area Volume %', minval = 0, maxval = 100, group = 'Pivot Points Volume Profile') / 100
pointOfControl = input.bool(true, 'Point of Control (PoC)', inline = 'PoC', group = 'Pivot Points Volume Profile')
pocColor       = input.color(color.new(#ff0000, 0), '', inline = 'PoC', group = 'Pivot Points Volume Profile')
pocExtend = input.string('None', 'Extend Point of Control (PoC)', options = ['Until Last Bar', 'Until Bar Cross', 'Until Bar Touch', 'None'], group = 'Pivot Points Volume Profile')
valueAreaHigh = input.bool(true, 'Value Area High (VAH)', inline = 'VAH', group = 'Pivot Points Volume Profile')
vahColor      = input.color(color.new(#2962ff, 0), '', inline = 'VAH', group = 'Pivot Points Volume Profile')
valueAreaLow = input.bool(true, 'Value Area Low (VAL)', inline = 'VAL', group = 'Pivot Points Volume Profile')
valColor     = input.color(color.new(#2962ff, 0), '', inline = 'VAL', group = 'Pivot Points Volume Profile')
profileLevels = input.int(25, 'Number of Rows', minval = 10, maxval = 100, step = 1, group = 'Pivot Points Volume Profile')
showHistoricalPov = input.bool(false, 'Show Historical PoC/VAH/VAL', group = 'Pivot Points Volume Profile', tooltip = 'اگر خاموش باشد فقط پروفایل فعلی (Developing) رسم می‌شود و چارت خلوت می‌ماند')
povMaxPocHistory = input.int(2, 'Max Red PoC Boxes (History)', minval = 0, maxval = 50, group = 'Pivot Points Volume Profile', tooltip = 'حداکثر تعداد باکس قرمز PoC تاریخی روی چارت')
povMaxVahValHistory = input.int(2, 'Max Blue VAH/VAL Segments (History)', minval = 0, maxval = 50, group = 'Pivot Points Volume Profile', tooltip = 'حداکثر تعداد سگمنت آبی VAH و VAL تاریخی (هر سگمنت = یک VAH + یک VAL)')
registerPovAsTargets = input.bool(true, 'Register PoC/VAH/VAL as Targets', group = 'Pivot Points Volume Profile', tooltip = 'فقط سطوح فعلی Developing را به‌عنوان تارگت ثبت می‌کند')

pov_trimBoxHistory(arrayOfBoxes, int maxKeep) =>
    while array.size(arrayOfBoxes) > maxKeep
        box.delete(array.shift(arrayOfBoxes))

pov_trimLineHistory(arrayOfLines, int maxKeep) =>
    while array.size(arrayOfLines) > maxKeep
        line.delete(array.shift(arrayOfLines))

pov_drawOnlyLineX(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width) =>
    line.new(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width)

pov_drawLineX(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width) =>
    var id = line.new(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width)
    line.set_xy1(id, _x1, _y1)
    line.set_xy2(id, _x2, _y2)
    line.set_color(id, _color)
    id

pov_getHighLow(_len, _calc, _offset) =>
    if _calc
        htf_l = low[_offset]
        htf_h = high[_offset]
        vol = 0.
        for x = 0 to _len - 1 by 1
            htf_l := math.min(low[_offset + x], htf_l)
            htf_h := math.max(high[_offset + x], htf_h)
            vol := vol + volume[_offset + x]
        htf_l := math.min(low[_offset + _len], htf_l)
        htf_h := math.max(high[_offset + _len], htf_h)
        [htf_h, htf_l, vol]
    else
        [na, na, na]

pov_checkBreaches(arrayOfBoxes, extend) =>
    int qtyOfBoxes = array.size(arrayOfBoxes)
    for boxNo = 0 to qtyOfBoxes > 0 ? qtyOfBoxes - 1 : na by 1
        if boxNo < array.size(arrayOfBoxes)
            box currentBox = array.get(arrayOfBoxes, boxNo)
            float boxMidLevel = math.avg(box.get_bottom(currentBox), box.get_top(currentBox))
            bool boxWasCrossed = math.sign(close[1] - boxMidLevel) != math.sign(close - boxMidLevel)
            bool boxWasTouched = math.sign(close[1] - boxMidLevel) != math.sign(low - boxMidLevel) or math.sign(close[1] - boxMidLevel) != math.sign(high - boxMidLevel)
            if boxWasCrossed and extend == 'Until Bar Cross'
                array.remove(arrayOfBoxes, boxNo)
                int(na)
            else if boxWasTouched and extend == 'Until Bar Touch'
                array.remove(arrayOfBoxes, boxNo)
                int(na)
            else
                box.set_right(currentBox, bar_index)
                int(na)

pov_fillVolumeProfile(_len, _offset, _priceLowest, _priceStep, _volumeStorage) =>
    array.fill(_volumeStorage, 0.)
    for barIndexx = 1 to _len by 1
        level = 0
        barIndex = barIndexx + _offset
        for priceLevel = _priceLowest to _priceLowest + _priceStep * profileLevels by _priceStep
            if high[barIndex] >= priceLevel and low[barIndex] < priceLevel + _priceStep
                barRange = high[barIndex] - low[barIndex]
                array.set(_volumeStorage, level, array.get(_volumeStorage, level) + nz(volume[barIndex]) * (barRange == 0 ? 1 : _priceStep / barRange))
            level += 1

pov_calcValueArea(_volumeStorage, _pocLevel) =>
    totalVolumeTraded = array.sum(_volumeStorage) * isValueArea
    valueArea = array.get(_volumeStorage, _pocLevel)
    levelAbove = _pocLevel
    levelBelow = _pocLevel
    while valueArea < totalVolumeTraded
        if levelBelow == 0 and levelAbove == profileLevels - 1
            break
        volumeAbove = levelAbove < profileLevels - 1 ? array.get(_volumeStorage, levelAbove + 1) : 0.
        volumeBelow = levelBelow > 0 ? array.get(_volumeStorage, levelBelow - 1) : 0.
        if volumeAbove == 0 and volumeBelow == 0
            break
        if volumeAbove >= volumeBelow
            valueArea += volumeAbove
            levelAbove += 1
        else
            valueArea += volumeBelow
            levelBelow -= 1
    [levelAbove, levelBelow]

volumeStorageT = array.new_float(profileLevels + 1, 0.)
var a_poc = array.new_box()
var a_vahHist = array.new_line()
var a_valHist = array.new_line()
var pov_x1 = 0
var pov_x2 = 0
var levelAbovePoc = 0
var levelBelowPoc = 0
var pocLevel = 0
var float pov_devPocPrice = na
var float pov_devVahPrice = na
var float pov_devValPrice = na

pvtHigh = enablePovProfile ? ta.pivothigh(pvtLength, pvtLength) : na
pvtLow = enablePovProfile ? ta.pivotlow(pvtLength, pvtLength) : na
proceed = enablePovProfile and (not na(pvtHigh) or not na(pvtLow))

if proceed
    pov_x1 := pov_x2
    pov_x2 := bar_index
    profileLength = pov_x2 - pov_x1
    [priceHighest, priceLowest, _] = pov_getHighLow(profileLength, proceed, pvtLength)
    priceStep = (priceHighest - priceLowest) / profileLevels
    nzVolume = nz(volume)
    if showHistoricalPov and proceed and nzVolume > 0 and priceStep > 0 and bar_index > profileLength and profileLength > 0
        pov_fillVolumeProfile(profileLength, pvtLength, priceLowest, priceStep, volumeStorageT)
        pocLevel := array.indexof(volumeStorageT, array.max(volumeStorageT))
        [levelAbove, levelBelow] = pov_calcValueArea(volumeStorageT, pocLevel)
        levelAbovePoc := levelAbove
        levelBelowPoc := levelBelow
        if pointOfControl and povMaxPocHistory > 0
            array.push(a_poc, box.new(bar_index[pvtLength] - profileLength, priceLowest + (pocLevel + .40) * priceStep, bar_index[pvtLength], priceLowest + (pocLevel + .60) * priceStep, pocColor, bgcolor = pocColor))
            pov_trimBoxHistory(a_poc, povMaxPocHistory)
        if valueAreaHigh and povMaxVahValHistory > 0
            array.push(a_vahHist, pov_drawOnlyLineX(bar_index[pvtLength] - profileLength, priceLowest + (levelAbovePoc + 1.00) * priceStep, bar_index[pvtLength], priceLowest + (levelAbovePoc + 1.00) * priceStep, xloc.bar_index, extend.none, vahColor, line.style_solid, 2))
            pov_trimLineHistory(a_vahHist, povMaxVahValHistory)
        if valueAreaLow and povMaxVahValHistory > 0
            array.push(a_valHist, pov_drawOnlyLineX(bar_index[pvtLength] - profileLength, priceLowest + (levelBelowPoc + 0.00) * priceStep, bar_index[pvtLength], priceLowest + (levelBelowPoc + 0.00) * priceStep, xloc.bar_index, extend.none, valColor, line.style_solid, 2))
            pov_trimLineHistory(a_valHist, povMaxVahValHistory)

if enablePovProfile and pointOfControl and pocExtend != 'None'
    pov_checkBreaches(a_poc, pocExtend)
    pov_trimBoxHistory(a_poc, math.max(povMaxPocHistory, 0))

var a_profileD = array.new_box()
autoDevLength = last_bar_index - pov_x2 + pvtLength
devLength = enablePovProfile and barstate.islast ? (povDevLookbackMode == 'Fixed' ? math.min(povDevLookbackBars, bar_index) : math.max(autoDevLength, 1)) : 1
devHigh = ta.highest(high, math.max(devLength, 1) + 1)
devLow = ta.lowest(low, math.max(devLength, 1) + 1)
devStep = (devHigh - devLow) / profileLevels
nzVolumePov = nz(volume)

if enablePovProfile and barstate.islast and nzVolumePov > 0 and devLength > 0 and devStep > 0
    if array.size(a_profileD) > 0
        for i = 0 to array.size(a_profileD) - 1 by 1
            box.delete(array.shift(a_profileD))
    pov_fillVolumeProfile(devLength, 0, devLow, devStep, volumeStorageT)
    pocLevel := array.indexof(volumeStorageT, array.max(volumeStorageT))
    [levelAbove, levelBelow] = pov_calcValueArea(volumeStorageT, pocLevel)
    levelAbovePoc := levelAbove
    levelBelowPoc := levelBelow
    pov_devPocPrice := devLow + (pocLevel + 0.5) * devStep
    pov_devVahPrice := devLow + (levelAbovePoc + 1.00) * devStep
    pov_devValPrice := devLow + (levelBelowPoc + 0.00) * devStep
    if pointOfControl
        array.push(a_profileD, box.new(bar_index - devLength, devLow + (pocLevel + .40) * devStep, bar_index, devLow + (pocLevel + .60) * devStep, pocColor, bgcolor = pocColor))
    pov_drawLineX(bar_index - devLength, pov_devVahPrice, bar_index, pov_devVahPrice, xloc.bar_index, extend.none, valueAreaHigh ? vahColor : #00000000, line.style_solid, 2)
    pov_drawLineX(bar_index - devLength, pov_devValPrice, bar_index, pov_devValPrice, xloc.bar_index, extend.none, valueAreaLow ? valColor : #00000000, line.style_solid, 2)

//#endregion

// ================================================================================================
// بخش FVG: Fair Value Gap
// Adapted from LuxAlgo Fair Value Gap (CC BY-NC-SA 4.0) — © LuxAlgo
// https://creativecommons.org/licenses/by-nc-sa/4.0/
// ================================================================================================
//#region ———————————————————— FAIR VALUE GAP (LuxAlgo-adapted)

enableFvg = input.bool(true, 'Enable Fair Value Gap', group = 'Fair Value Gap')
fvgThresholdPer = input.float(0.0, 'Threshold %', minval = 0, maxval = 100, step = 0.1, inline = 'fvg_thr', group = 'Fair Value Gap')
fvgAutoThreshold = input.bool(false, 'Auto', inline = 'fvg_thr', group = 'Fair Value Gap')
fvgShowLast = input.int(0, 'Unmitigated Levels', minval = 0, group = 'Fair Value Gap')
fvgMitigationLevels = input.bool(false, 'Mitigation Levels', group = 'Fair Value Gap')
fvgTf = input.timeframe('', 'Timeframe', group = 'Fair Value Gap')
fvgExtend = input.int(20, 'Extend', minval = 0, inline = 'fvg_ext', group = 'Fair Value Gap')
fvgDynamic = input.bool(false, 'Dynamic', inline = 'fvg_ext', group = 'Fair Value Gap')
fvgBullCss = input.color(color.new(#089981, 70), 'Bullish FVG', group = 'Fair Value Gap')
fvgBearCss = input.color(color.new(#f23645, 70), 'Bearish FVG', group = 'Fair Value Gap')
fvgShowDash = input.bool(false, 'Show Dashboard', group = 'Fair Value Gap')
fvgDashLoc = input.string('Top Right', 'Dashboard Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = 'Fair Value Gap')
fvgTextSize = input.string('Small', 'Dashboard Size', options = ['Tiny', 'Small', 'Normal'], group = 'Fair Value Gap')
registerFvgAsTargets = input.bool(true, 'Register FVG as Targets', group = 'Fair Value Gap', tooltip = 'سطوح گپ‌های mitigate‌نشده را برای confluence ثبت می‌کند')
fvgTargetWeight = input.float(120, 'Weight: FVG Target', minval = 0, group = 'Fair Value Gap')
fvgMaxRegister = input.int(10, 'Max FVG Targets to Register', minval = 1, maxval = 50, group = 'Fair Value Gap')

fvgToSolid(color id) =>
    color.rgb(color.r(id), color.g(id), color.b(id))

// Chart-native detect (no UDT through security — that broke mitigation)
fvgDetectRaw() =>
    float thr = fvgAutoThreshold ? ta.cum((high - low) / low) / math.max(bar_index, 1) : fvgThresholdPer / 100.0
    bool bull_fvg = bar_index > 2 and low > high[2] and close[1] > high[2] and (low - high[2]) / high[2] > thr
    bool bear_fvg = bar_index > 2 and high < low[2] and close[1] < low[2] and (low[2] - high) / high > thr
    float mx = bull_fvg ? low : bear_fvg ? low[2] : na
    float mn = bull_fvg ? high[2] : bear_fvg ? high : na
    [bull_fvg, bear_fvg, mx, mn]

var float fvg_max_bull = na
var float fvg_min_bull = na
var float fvg_max_bear = na
var float fvg_min_bear = na
var int fvg_bull_count = 0
var int fvg_bear_count = 0
var int fvg_bull_mitigated = 0
var int fvg_bear_mitigated = 0
var int fvg_last_sig_bar = -1

// Parallel arrays (reliable; box tied 1:1 with levels)
var array<float> fvg_max_arr = array.new<float>()
var array<float> fvg_min_arr = array.new<float>()
var array<bool> fvg_bull_arr = array.new<bool>()
var array<int> fvg_born_arr = array.new<int>()
var array<box> fvg_box_arr = array.new<box>()
var array<line> fvg_unmitigated = array.new<line>()

[fvg_bull_c, fvg_bear_c, fvg_mx_c, fvg_mn_c] = fvgDetectRaw()
[fvg_bull_htf, fvg_bear_htf, fvg_mx_htf, fvg_mn_htf] = request.security(syminfo.tickerid, fvgTf == '' ? timeframe.period : fvgTf, fvgDetectRaw(), lookahead = barmerge.lookahead_off)
bool fvg_on_chart = fvgTf == '' or fvgTf == timeframe.period
bool fvg_bull = fvg_on_chart ? fvg_bull_c : fvg_bull_htf
bool fvg_bear = fvg_on_chart ? fvg_bear_c : fvg_bear_htf
float fvg_mx = fvg_on_chart ? fvg_mx_c : fvg_mx_htf
float fvg_mn = fvg_on_chart ? fvg_mn_c : fvg_mn_htf
// Rising edge only — prevents re-creating the same HTF gap every chart bar
bool fvg_bull_new = fvg_bull and not fvg_bull[1]
bool fvg_bear_new = fvg_bear and not fvg_bear[1]

if enableFvg and fvg_bull_new and not na(fvg_mx) and not na(fvg_mn) and fvg_mx >= fvg_mn
    if fvgDynamic
        fvg_max_bull := fvg_mx
        fvg_min_bull := fvg_mn
    if not fvgDynamic
        fvg_box_arr.unshift(box.new(bar_index - 2, fvg_mx, math.max(bar_index + fvgExtend, bar_index), fvg_mn, border_color = na, bgcolor = fvgBullCss))
    else
        fvg_box_arr.unshift(na)
    fvg_max_arr.unshift(fvg_mx)
    fvg_min_arr.unshift(fvg_mn)
    fvg_bull_arr.unshift(true)
    fvg_born_arr.unshift(bar_index)
    fvg_bull_count += 1
    fvg_last_sig_bar := bar_index
else if enableFvg and fvgDynamic
    fvg_max_bull := math.max(math.min(close, fvg_max_bull), fvg_min_bull)

if enableFvg and fvg_bear_new and not na(fvg_mx) and not na(fvg_mn) and fvg_mx >= fvg_mn
    if fvgDynamic
        fvg_max_bear := fvg_mx
        fvg_min_bear := fvg_mn
    if not fvgDynamic
        fvg_box_arr.unshift(box.new(bar_index - 2, fvg_mx, math.max(bar_index + fvgExtend, bar_index), fvg_mn, border_color = na, bgcolor = fvgBearCss))
    else
        fvg_box_arr.unshift(na)
    fvg_max_arr.unshift(fvg_mx)
    fvg_min_arr.unshift(fvg_mn)
    fvg_bull_arr.unshift(false)
    fvg_born_arr.unshift(bar_index)
    fvg_bear_count += 1
    fvg_last_sig_bar := bar_index
else if enableFvg and fvgDynamic
    fvg_min_bear := math.min(math.max(close, fvg_min_bear), fvg_max_bear)

// Mitigate: after birth bar, any overlap of candle range with FVG zone deletes it
if enableFvg and fvg_max_arr.size() > 0
    for i = fvg_max_arr.size() - 1 to 0
        int born = fvg_born_arr.get(i)
        float mx = fvg_max_arr.get(i)
        float mn = fvg_min_arr.get(i)
        bool isBull = fvg_bull_arr.get(i)
        // Keep box growing to the right while alive
        box bx = fvg_box_arr.get(i)
        if not na(bx)
            box.set_right(bx, math.max(bar_index, born + fvgExtend))
        if bar_index > born and not na(mx) and not na(mn)
            bool touched = high >= mn and low <= mx
            if touched
                if fvgMitigationLevels
                    float y = isBull ? mn : mx
                    line.new(born, y, bar_index, y, xloc.bar_index, color = isBull ? fvgBullCss : fvgBearCss, style = line.style_dashed)
                if not na(bx)
                    box.delete(bx)
                fvg_box_arr.remove(i)
                fvg_max_arr.remove(i)
                fvg_min_arr.remove(i)
                fvg_bull_arr.remove(i)
                fvg_born_arr.remove(i)
                if isBull
                    fvg_bull_mitigated += 1
                else
                    fvg_bear_mitigated += 1

if enableFvg and fvgDynamic
    if fvg_born_arr.size() == 0 or bar_index > fvg_born_arr.get(0)
        if not na(fvg_max_bull) and not na(fvg_min_bull) and high >= fvg_min_bull and low <= fvg_max_bull
            fvg_max_bull := na
            fvg_min_bull := na
        if not na(fvg_max_bear) and not na(fvg_min_bear) and high >= fvg_min_bear and low <= fvg_max_bear
            fvg_max_bear := na
            fvg_min_bear := na

if enableFvg and barstate.islast and fvgShowLast > 0 and fvg_max_arr.size() > 0
    if fvg_unmitigated.size() > 0
        for element in fvg_unmitigated
            line.delete(element)
        fvg_unmitigated.clear()
    for i = 0 to math.min(fvgShowLast - 1, fvg_max_arr.size() - 1)
        bool isBull = fvg_bull_arr.get(i)
        float lvl = isBull ? fvg_min_arr.get(i) : fvg_max_arr.get(i)
        int born = fvg_born_arr.get(i)
        fvg_unmitigated.push(line.new(born, lvl, bar_index, lvl, xloc.bar_index, color = isBull ? fvgBullCss : fvgBearCss))

var table fvg_tb = na

fvg_table_size = fvgTextSize == 'Tiny' ? size.tiny : fvgTextSize == 'Small' ? size.small : size.normal

if enableFvg and fvgShowDash
    if na(fvg_tb)
        fvg_tb := table.new(
             fvgDashLoc == 'Bottom Left' ? position.bottom_left : fvgDashLoc == 'Top Right' ? position.top_right : position.bottom_right,
             3, 3, bgcolor = #1e222d, border_color = #373a46, border_width = 1, frame_color = #373a46, frame_width = 1)
    if barstate.isfirst or barstate.islast
        table.cell(fvg_tb, 1, 0, 'Bullish', text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 0, 'Bearish', text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 0, 1, 'Count', text_size = fvg_table_size, text_color = color.white)
        table.cell(fvg_tb, 0, 2, 'Mitigated', text_size = fvg_table_size, text_color = color.white)
    if barstate.islast
        table.cell(fvg_tb, 1, 1, str.tostring(fvg_bull_count), text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 1, str.tostring(fvg_bear_count), text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)
        float bullMitPct = fvg_bull_count > 0 ? fvg_bull_mitigated / fvg_bull_count * 100.0 : 0.0
        float bearMitPct = fvg_bear_count > 0 ? fvg_bear_mitigated / fvg_bear_count * 100.0 : 0.0
        table.cell(fvg_tb, 1, 2, str.tostring(bullMitPct, '#.##') + '%', text_color = fvgToSolid(fvgBullCss), text_size = fvg_table_size)
        table.cell(fvg_tb, 2, 2, str.tostring(bearMitPct, '#.##') + '%', text_color = fvgToSolid(fvgBearCss), text_size = fvg_table_size)

fvg_max_bull_plot = plot(enableFvg and fvgDynamic ? fvg_max_bull : na, color = na, display = display.none)
fvg_min_bull_plot = plot(enableFvg and fvgDynamic ? fvg_min_bull : na, color = na, display = display.none)
fill(fvg_max_bull_plot, fvg_min_bull_plot, color = enableFvg and fvgDynamic ? fvgBullCss : na)
fvg_max_bear_plot = plot(enableFvg and fvgDynamic ? fvg_max_bear : na, color = na, display = display.none)
fvg_min_bear_plot = plot(enableFvg and fvgDynamic ? fvg_min_bear : na, color = na, display = display.none)
fill(fvg_max_bear_plot, fvg_min_bear_plot, color = enableFvg and fvgDynamic ? fvgBearCss : na)

alertcondition(enableFvg and fvg_bull_count > fvg_bull_count[1], 'Bullish FVG', 'Bullish FVG detected')
alertcondition(enableFvg and fvg_bear_count > fvg_bear_count[1], 'Bearish FVG', 'Bearish FVG detected')
alertcondition(enableFvg and fvg_bull_mitigated > fvg_bull_mitigated[1], 'Bullish FVG Mitigation', 'Bullish FVG mitigated')
alertcondition(enableFvg and fvg_bear_mitigated > fvg_bear_mitigated[1], 'Bearish FVG Mitigation', 'Bearish FVG mitigated')

// Keep fvg_records alias for target registration below
var array<FvgGap> fvg_records = array.new<FvgGap>()
if enableFvg and barstate.islast
    fvg_records.clear()
    if fvg_max_arr.size() > 0
        for i = 0 to fvg_max_arr.size() - 1
            fvg_records.push(FvgGap.new(fvg_max_arr.get(i), fvg_min_arr.get(i), fvg_bull_arr.get(i), time, fvg_born_arr.get(i)))

//#endregion

// ================================================================================================
// بخش ANA: Hit-Rate Combo Analytics (NCT types + FVG)
// ================================================================================================
//#region ———————————————————— TARGET COMBO ANALYTICS

var array<float> ana_litePx = array.new<float>()
var array<string> ana_liteTy = array.new<string>()
var array<bool> ana_liteUp = array.new<bool>()
var array<float> ana_liteW = array.new<float>()

var array<string> ana_pendSig = array.new<string>()
var array<bool> ana_pendUp = array.new<bool>()
var array<int> ana_pendEntry = array.new<int>()
var array<float> ana_pendEntryPx = array.new<float>()
var array<float> ana_pendStop = array.new<float>()
var array<float> ana_pendTgt = array.new<float>()

var array<string> ana_statKey = array.new<string>()
var array<int> ana_statHits = array.new<int>()
var array<int> ana_statFails = array.new<int>()
var array<int> ana_statSumBars = array.new<int>()
var array<int> ana_statTimeouts = array.new<int>()

var int ana_lastEvBarUp = -999999
var int ana_lastEvBarDn = -999999
var string ana_lastEvSigUp = ""
var string ana_lastEvSigDn = ""
var string ana_liveHint = ""
var string ana_liveSigUp = ""
var string ana_liveSigDn = ""
var int ana_dbgEvents = 0
var int ana_dbgResolved = 0
var int ana_dbgLite = 0

var table anaTable = table.new(position.bottom_left, 4, 18, bgcolor = color.new(color.black, 5), border_color = color.new(color.gray, 40), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
var table anaHintTable = table.new(position.top_left, 1, 2, bgcolor = color.new(color.black, 5), border_color = color.new(color.aqua, 50), border_width = 1)

anaResetLite() =>
    ana_litePx.clear()
    ana_liteTy.clear()
    ana_liteUp.clear()
    ana_liteW.clear()

anaPushLite(float px, string ty, bool isUp, float w) =>
    if not na(px) and w > 0 and ty != ""
        ana_litePx.push(px)
        ana_liteTy.push(ty)
        ana_liteUp.push(isUp)
        ana_liteW.push(w)

anaSafeLog(float v) =>
    v > 0 ? math.log(v) : 0.0

anaCollectNode1(array<Node> nodes, bool isUp, int maxCount) =>
    int countNodes = nodes.size()
    if countNodes > 0 and maxCount > 0
        array<int> quals = array.new<int>()
        for i = 0 to countNodes - 1
            if nodes.get(i).numberNode == 1
                quals.push(i)
        int qn = quals.size()
        int skip = math.max(qn - maxCount, 0)
        int seen = 0
        if qn > 0
            for qi = 0 to qn - 1
                seen += 1
                if seen > skip
                    Node node = nodes.get(quals.get(qi))
                    float moveSizeLog = math.abs(anaSafeLog(node.highNode) - anaSafeLog(node.lowPreNode))
                    float correctionSizeLog = math.abs(anaSafeLog(node.highNode) - anaSafeLog(node.lowCorrection))
                    if showTargetDoubleInput and targetWeightSingleDouble > 0
                        float p = isUp ? math.exp(anaSafeLog(node.highNode) + moveSizeLog) : math.exp(anaSafeLog(node.highNode) - moveSizeLog)
                        anaPushLite(p, "SD", isUp, targetWeightSingleDouble)
                    if showTargetMinInput and targetWeightSingleMin > 0
                        float p = isUp ? math.exp(anaSafeLog(node.lowCorrection) + moveSizeLog) : math.exp(anaSafeLog(node.lowCorrection) - moveSizeLog)
                        anaPushLite(p, "SM", isUp, targetWeightSingleMin)
                    if showTargetCorrectionInput and targetWeightSingleCorrection > 0
                        float p = isUp ? math.exp(anaSafeLog(node.highNode) + correctionSizeLog) : math.exp(anaSafeLog(node.highNode) - correctionSizeLog)
                        anaPushLite(p, "SC", isUp, targetWeightSingleCorrection)

anaCollectPair12(array<Node> nodes, bool isUp, int maxCount) =>
    int countNodes = nodes.size()
    if countNodes > 1 and maxCount > 0
        array<int> pairIdx = array.new<int>()
        for i = 0 to countNodes - 2
            if nodes.get(i).numberNode == 1 and nodes.get(i + 1).numberNode == 2
                pairIdx.push(i)
        int pn = pairIdx.size()
        int skip = math.max(pn - maxCount, 0)
        int seen = 0
        if pn > 0
            for pi = 0 to pn - 1
                seen += 1
                if seen > skip
                    int i = pairIdx.get(pi)
                    Node node1 = nodes.get(i)
                    Node node2 = nodes.get(i + 1)
                    float totalMoveLog = math.abs(anaSafeLog(node2.highNode) - anaSafeLog(node1.lowPreNode))
                    if showPairMinInput and targetWeightPairMin > 0
                        float p = isUp ? math.exp(anaSafeLog(node1.lowCorrection) + totalMoveLog) : math.exp(anaSafeLog(node1.lowCorrection) - totalMoveLog)
                        anaPushLite(p, "PM", isUp, targetWeightPairMin)
                    if showPairMaxInput and targetWeightPairMax > 0
                        float p = isUp ? math.exp(anaSafeLog(node2.lowCorrection) + totalMoveLog) : math.exp(anaSafeLog(node2.lowCorrection) - totalMoveLog)
                        anaPushLite(p, "PX", isUp, targetWeightPairMax)
                    if showPairDoubleInput and targetWeightPairDouble > 0
                        float p = isUp ? math.exp(anaSafeLog(node2.highNode) + totalMoveLog) : math.exp(anaSafeLog(node2.highNode) - totalMoveLog)
                        anaPushLite(p, "PD", isUp, targetWeightPairDouble)
                    if showPairCorrectionInput and targetWeightPairCorrection > 0
                        float c2 = math.abs(anaSafeLog(node2.highNode) - anaSafeLog(node2.lowCorrection))
                        float p = isUp ? math.exp(anaSafeLog(node2.highNode) + c2) : math.exp(anaSafeLog(node2.highNode) - c2)
                        anaPushLite(p, "PC", isUp, targetWeightPairCorrection)

anaCollectFvg(bool isUp) =>
    if enableFvg and fvgTargetWeight > 0 and fvg_max_arr.size() > 0
        for i = 0 to fvg_max_arr.size() - 1
            if fvg_bull_arr.get(i) == isUp
                float mid = (fvg_max_arr.get(i) + fvg_min_arr.get(i)) * 0.5
                anaPushLite(mid, "FG", isUp, fvgTargetWeight)

anaTypeOrder(string t) =>
    switch t
        "SM" => 0
        "SD" => 1
        "SC" => 2
        "PM" => 3
        "PX" => 4
        "PD" => 5
        "PC" => 6
        "FG" => 7
        => 99

anaBuildSigFromFlags(bool hasSM, bool hasSD, bool hasSC, bool hasPM, bool hasPX, bool hasPD, bool hasPC, bool hasFG) =>
    string sig = ""
    if hasSM
        sig := sig == "" ? "SM" : sig + "+SM"
    if hasSD
        sig := sig == "" ? "SD" : sig + "+SD"
    if hasSC
        sig := sig == "" ? "SC" : sig + "+SC"
    if hasPM
        sig := sig == "" ? "PM" : sig + "+PM"
    if hasPX
        sig := sig == "" ? "PX" : sig + "+PX"
    if hasPD
        sig := sig == "" ? "PD" : sig + "+PD"
    if hasPC
        sig := sig == "" ? "PC" : sig + "+PC"
    if hasFG
        sig := sig == "" ? "FG" : sig + "+FG"
    sig

anaNear(float a, float b, float tolPct) =>
    float refP = math.max(math.abs(a), 1e-8)
    math.abs(a - b) / refP * 100.0 <= tolPct

// فقط خوشه‌های دایره قرمز (همان معیار Close Target Detection) → برای بک‌تست
// Returns [sig, score, refTarget]
anaBestCluster(bool isUp) =>
    string bestSig = ""
    float bestScore = -1.0
    float bestTgt = na
    float redTol = redDensityTolerancePct
    int minCnt = redDensityMinCount
    int nAll = ana_litePx.size()

    // جمع‌آوری ایندکس‌های هم‌جهت (بدون FG برای هم‌خوانی با دایره قرمز نودی؛ FG فقط اگر داخل باند قرمز باشد به امضا اضافه می‌شود)
    array<int> idxs = array.new<int>()
    if nAll > 0
        for i = 0 to nAll - 1
            if ana_liteUp.get(i) == isUp and ana_liteTy.get(i) != "FG"
                idxs.push(i)

    int n = idxs.size()
    if n >= minCnt
        // مرتب‌سازی صعودی بر اساس قیمت
        for a = 1 to n - 1
            int iKey = idxs.get(a)
            float pKey = ana_litePx.get(iKey)
            int b = a - 1
            while b >= 0 and ana_litePx.get(idxs.get(b)) > pKey
                idxs.set(b + 1, idxs.get(b))
                b -= 1
            idxs.set(b + 1, iKey)

        array<bool> used = array.new<bool>(n, false)
        for i = 0 to n - 1
            if used.get(i)
                continue
            float runMin = ana_litePx.get(idxs.get(i))
            float runMax = runMin
            array<int> cluster = array.new<int>()
            cluster.push(idxs.get(i))
            if i < n - 1
                for j = i + 1 to n - 1
                    if used.get(j)
                        continue
                    float priceJ = ana_litePx.get(idxs.get(j))
                    float refP = math.max(math.abs(runMin), 1e-8)
                    float widthProbe = (math.max(runMax, priceJ) - math.min(runMin, priceJ)) / refP * 100.0
                    // فقط داخل باند قرمز رشد کن (سخت‌گیرانه)
                    if widthProbe > redTol
                        break
                    cluster.push(idxs.get(j))
                    runMin := math.min(runMin, priceJ)
                    runMax := math.max(runMax, priceJ)

            int cSize = cluster.size()
            if cSize < minCnt
                used.set(i, true)
                continue

            for k = 0 to cSize - 1
                // mark used by scanning idxs positions
                int idk = cluster.get(k)
                for u = 0 to n - 1
                    if idxs.get(u) == idk
                        used.set(u, true)

            float refW = math.max(math.abs(runMin), 1e-8)
            float widthPct = (runMax - runMin) / refW * 100.0
            // شرط دایره قرمز
            if widthPct <= redTol and cSize >= minCnt
                bool hasSM = false
                bool hasSD = false
                bool hasSC = false
                bool hasPM = false
                bool hasPX = false
                bool hasPD = false
                bool hasPC = false
                bool hasFG = false
                float score = 0.0
                float bestW = -1.0
                float refT = na
                int typeCount = 0
                for k = 0 to cSize - 1
                    int id = cluster.get(k)
                    string ty = ana_liteTy.get(id)
                    float w = ana_liteW.get(id)
                    float px = ana_litePx.get(id)
                    bool neu = false
                    if ty == "SM" and not hasSM
                        hasSM := true
                        neu := true
                    else if ty == "SD" and not hasSD
                        hasSD := true
                        neu := true
                    else if ty == "SC" and not hasSC
                        hasSC := true
                        neu := true
                    else if ty == "PM" and not hasPM
                        hasPM := true
                        neu := true
                    else if ty == "PX" and not hasPX
                        hasPX := true
                        neu := true
                    else if ty == "PD" and not hasPD
                        hasPD := true
                        neu := true
                    else if ty == "PC" and not hasPC
                        hasPC := true
                        neu := true
                    if neu
                        typeCount += 1
                        score += w
                        bool sideOk = isUp ? px > close : px < close
                        if sideOk and w > bestW
                            bestW := w
                            refT := px

                // FG هم‌جهت اگر دقیقاً داخل باند قرمز باشد به امضا اضافه شود
                if nAll > 0
                    for fi = 0 to nAll - 1
                        if ana_liteUp.get(fi) == isUp and ana_liteTy.get(fi) == "FG"
                            float fpx = ana_litePx.get(fi)
                            if fpx >= runMin and fpx <= runMax and not hasFG
                                hasFG := true
                                score += ana_liteW.get(fi)
                                typeCount += 1
                                bool sideOkFg = isUp ? fpx > close : fpx < close
                                if sideOkFg and ana_liteW.get(fi) > bestW
                                    bestW := ana_liteW.get(fi)
                                    refT := fpx

                if na(refT)
                    float mid = (runMin + runMax) * 0.5
                    bool midOk = isUp ? mid > close : mid < close
                    if midOk
                        refT := mid
                    else
                        // نزدیک‌ترین عضو خوشه در سمت معامله
                        float nearestDist = 1e99
                        for k = 0 to cSize - 1
                            float px = ana_litePx.get(cluster.get(k))
                            bool sideOk = isUp ? px > close : px < close
                            if sideOk
                                float d = math.abs(px - close)
                                if d < nearestDist
                                    nearestDist := d
                                    refT := px

                if typeCount >= anaMinTypesInCluster and score >= anaMinClusterScore and not na(refT)
                    // تنگ‌ترین / قوی‌ترین خوشه قرمز
                    float rankScore = score + (redTol - widthPct) * 1000.0
                    if rankScore > bestScore
                        bestScore := rankScore
                        bestSig := anaBuildSigFromFlags(hasSM, hasSD, hasSC, hasPM, hasPX, hasPD, hasPC, hasFG)
                        bestTgt := refT

    [bestSig, bestScore, bestTgt]

anaFindStat(string key) =>
    int idx = -1
    int ns = ana_statKey.size()
    if ns > 0
        for i = 0 to ns - 1
            if ana_statKey.get(i) == key
                idx := i
                break
    idx

anaEnsureStat(string key) =>
    int idx = anaFindStat(key)
    if idx < 0
        ana_statKey.push(key)
        ana_statHits.push(0)
        ana_statFails.push(0)
        ana_statSumBars.push(0)
        ana_statTimeouts.push(0)
        idx := ana_statKey.size() - 1
    idx

anaRecordResult(string sig, bool isUp, bool isHit, bool isTimeout, int barsToHit) =>
    string key = (isUp ? "U:" : "D:") + sig
    int idx = anaEnsureStat(key)
    if isTimeout
        ana_statTimeouts.set(idx, ana_statTimeouts.get(idx) + 1)
    else if isHit
        ana_statHits.set(idx, ana_statHits.get(idx) + 1)
        ana_statSumBars.set(idx, ana_statSumBars.get(idx) + barsToHit)
    else
        ana_statFails.set(idx, ana_statFails.get(idx) + 1)

anaOpenEvent(string sig, bool isUp, float tgt) =>
    bool opened = false
    int usedEntry = bar_index
    if sig != "" and not na(tgt) and not na(atrValue) and atrValue > 0 and ana_pendSig.size() < 80
        float entryPx = close
        float stopPx = isUp ? entryPx - anaStopAtrMult * atrValue : entryPx + anaStopAtrMult * atrValue
        bool tgtOk = isUp ? tgt > entryPx : tgt < entryPx
        if tgtOk
            ana_pendSig.push(sig)
            ana_pendUp.push(isUp)
            ana_pendEntry.push(bar_index)
            ana_pendEntryPx.push(entryPx)
            ana_pendStop.push(stopPx)
            ana_pendTgt.push(tgt)
            opened := true
    [opened, usedEntry]

anaResolvePending() =>
    if ana_pendSig.size() > 0
        for i = ana_pendSig.size() - 1 to 0
            int entry = ana_pendEntry.get(i)
            if bar_index > entry
                bool isUp = ana_pendUp.get(i)
                float tgt = ana_pendTgt.get(i)
                float stop = ana_pendStop.get(i)
                string sig = ana_pendSig.get(i)
                int age = bar_index - entry
                bool hit = isUp ? high >= tgt : low <= tgt
                bool fail = isUp ? low <= stop : high >= stop
                if hit
                    anaRecordResult(sig, isUp, true, false, age)
                    ana_pendSig.remove(i)
                    ana_pendUp.remove(i)
                    ana_pendEntry.remove(i)
                    ana_pendEntryPx.remove(i)
                    ana_pendStop.remove(i)
                    ana_pendTgt.remove(i)
                else if fail
                    anaRecordResult(sig, isUp, false, false, age)
                    ana_pendSig.remove(i)
                    ana_pendUp.remove(i)
                    ana_pendEntry.remove(i)
                    ana_pendEntryPx.remove(i)
                    ana_pendStop.remove(i)
                    ana_pendTgt.remove(i)
                else if age >= anaLookaheadBars
                    anaRecordResult(sig, isUp, false, true, age)
                    ana_pendSig.remove(i)
                    ana_pendUp.remove(i)
                    ana_pendEntry.remove(i)
                    ana_pendEntryPx.remove(i)
                    ana_pendStop.remove(i)
                    ana_pendTgt.remove(i)

anaHitRate(int idx) =>
    int h = ana_statHits.get(idx)
    int f = ana_statFails.get(idx)
    int den = h + f
    den > 0 ? 100.0 * h / den : 0.0

anaSampleN(int idx) =>
    ana_statHits.get(idx) + ana_statFails.get(idx)

anaTrials(int idx) =>
    ana_statHits.get(idx) + ana_statFails.get(idx) + ana_statTimeouts.get(idx)

anaAvgBars(int idx) =>
    int h = ana_statHits.get(idx)
    h > 0 ? ana_statSumBars.get(idx) * 1.0 / h : 0.0

anaSortRank(array<int> idxs) =>
    int m = idxs.size()
    if m > 1
        for a = 0 to m - 2
            int best = a
            for b = a + 1 to m - 1
                int ib = idxs.get(b)
                int ibest = idxs.get(best)
                float rb = anaHitRate(ib)
                float rbest = anaHitRate(ibest)
                int nb = anaSampleN(ib)
                int nbest = anaSampleN(ibest)
                if rb > rbest or (rb == rbest and nb > nbest)
                    best := b
            if best != a
                int tmp = idxs.get(a)
                idxs.set(a, idxs.get(best))
                idxs.set(best, tmp)

// ——— Main analytics loop (after nodes + FVG exist) ———
if enableTargetAnalytics
    int anaWindowStart = last_bar_index - anaLookbackBars
    bool inAnaWindow = bar_index >= anaWindowStart

    if inAnaWindow
        anaResetLite()
        NDS anaNode = nodeDisplayMode == 'Starred' ? cNodeSym : cNodeNoSym
        if enableSingleNode1Targets
            if showTargetNode1Up
                anaCollectNode1(anaNode.nodesUp, true, targetNode1MaxCount)
            if showTargetNode1Down
                anaCollectNode1(anaNode.nodesDown, false, targetNode1MaxCount)
        if enablePairNode12Targets
            if showTargetNode1Up
                anaCollectPair12(anaNode.nodesUp, true, pairTargetMaxCount)
            if showTargetNode1Down
                anaCollectPair12(anaNode.nodesDown, false, pairTargetMaxCount)
        anaCollectFvg(true)
        anaCollectFvg(false)
        ana_dbgLite := ana_litePx.size()

        [sigUp, scUp, tgtUp] = anaBestCluster(true)
        [sigDn, scDn, tgtDn] = anaBestCluster(false)
        ana_liveSigUp := sigUp
        ana_liveSigDn := sigDn

        if sigUp != ""
            bool coolUp = bar_index - ana_lastEvBarUp >= anaEventCooldown or sigUp != ana_lastEvSigUp
            if coolUp
                [openedUp, entUp] = anaOpenEvent(sigUp, true, tgtUp)
                if openedUp
                    ana_lastEvBarUp := entUp
                    ana_lastEvSigUp := sigUp
                    ana_dbgEvents += 1
        if sigDn != ""
            bool coolDn = bar_index - ana_lastEvBarDn >= anaEventCooldown or sigDn != ana_lastEvSigDn
            if coolDn
                [openedDn, entDn] = anaOpenEvent(sigDn, false, tgtDn)
                if openedDn
                    ana_lastEvBarDn := entDn
                    ana_lastEvSigDn := sigDn
                    ana_dbgEvents += 1

        int pendBefore = ana_pendSig.size()
        anaResolvePending()
        int closedNow = pendBefore - ana_pendSig.size()
        if closedNow > 0
            ana_dbgResolved += closedNow

    if barstate.islast
        ana_liveHint := ""
        array<int> upIdx = array.new<int>()
        array<int> dnIdx = array.new<int>()
        int ns = ana_statKey.size()
        if ns > 0
            for i = 0 to ns - 1
                // Show if enough resolved (hit/fail) OR enough total trials incl. timeout
                if anaSampleN(i) >= anaMinSamples or anaTrials(i) >= anaMinSamples
                    string k = ana_statKey.get(i)
                    if str.startswith(k, "U:")
                        upIdx.push(i)
                    else if str.startswith(k, "D:")
                        dnIdx.push(i)

        anaSortRank(upIdx)
        anaSortRank(dnIdx)

        if anaShowLiveHint
            string hint = ""
            if ana_liveSigUp != "" and upIdx.size() > 0
                for t = 0 to math.min(anaTopN, upIdx.size()) - 1
                    int ii = upIdx.get(t)
                    if ana_statKey.get(ii) == "U:" + ana_liveSigUp
                        hint := "LIVE ▲ " + ana_liveSigUp + "  hit " + str.tostring(anaHitRate(ii), "#.#") + "% (n=" + str.tostring(anaSampleN(ii)) + ")"
                        break
            if hint == "" and ana_liveSigDn != "" and dnIdx.size() > 0
                for t = 0 to math.min(anaTopN, dnIdx.size()) - 1
                    int ii = dnIdx.get(t)
                    if ana_statKey.get(ii) == "D:" + ana_liveSigDn
                        hint := "LIVE ▼ " + ana_liveSigDn + "  hit " + str.tostring(anaHitRate(ii), "#.#") + "% (n=" + str.tostring(anaSampleN(ii)) + ")"
                        break
            if hint == "" and ana_liveSigUp != ""
                hint := "NOW ▲ " + ana_liveSigUp + " (building stats…)"
            else if hint == "" and ana_liveSigDn != ""
                hint := "NOW ▼ " + ana_liveSigDn + " (building stats…)"
            else if hint == ""
                hint := "Lite " + str.tostring(ana_dbgLite) + " | Ev " + str.tostring(ana_dbgEvents) + " | Done " + str.tostring(ana_dbgResolved)
            ana_liveHint := hint
            table.cell(anaHintTable, 0, 0, "Combo Hint", text_color = color.aqua, text_size = size.small)
            table.cell(anaHintTable, 0, 1, hint, text_color = color.white, text_size = size.small)
        else
            table.clear(anaHintTable, 0, 0, 0, 1)

        if anaShowTable
            table.cell(anaTable, 0, 0, "Combo Analytics", text_color = color.white, text_size = size.small)
            table.cell(anaTable, 1, 0, "Hit%", text_color = color.gray, text_size = size.small)
            table.cell(anaTable, 2, 0, "n", text_color = color.gray, text_size = size.small)
            table.cell(anaTable, 3, 0, "avgBars", text_color = color.gray, text_size = size.small)

            table.cell(anaTable, 0, 1, "status", text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 1, 1, "L" + str.tostring(ana_dbgLite), text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 2, 1, "E" + str.tostring(ana_dbgEvents), text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 3, 1, "R" + str.tostring(ana_dbgResolved), text_color = color.aqua, text_size = size.tiny)

            table.cell(anaTable, 0, 2, "▲ TOP UP", text_color = color.lime, text_size = size.small)
            table.cell(anaTable, 1, 2, "", text_color = color.lime, text_size = size.small)
            table.cell(anaTable, 2, 2, "", text_color = color.lime, text_size = size.small)
            table.cell(anaTable, 3, 2, "", text_color = color.lime, text_size = size.small)

            int row = 3
            int upShow = math.min(anaTopN, upIdx.size())
            if upShow > 0
                for t = 0 to upShow - 1
                    int ii = upIdx.get(t)
                    string name = str.replace_all(ana_statKey.get(ii), "U:", "")
                    table.cell(anaTable, 0, row, name, text_color = color.lime, text_size = size.tiny)
                    table.cell(anaTable, 1, row, str.tostring(anaHitRate(ii), "#.#"), text_color = color.white, text_size = size.tiny)
                    table.cell(anaTable, 2, row, str.tostring(anaSampleN(ii)) + "/" + str.tostring(anaTrials(ii)), text_color = color.white, text_size = size.tiny)
                    table.cell(anaTable, 3, row, str.tostring(anaAvgBars(ii), "#.#"), text_color = color.white, text_size = size.tiny)
                    row += 1
            else
                table.cell(anaTable, 0, row, ana_dbgLite < 2 ? "(few targets now)" : "(waiting resolve…)", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 1, row, "—", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 2, row, "—", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 3, row, "—", text_color = color.gray, text_size = size.tiny)
                row += 1

            table.cell(anaTable, 0, row, "▼ TOP DOWN", text_color = color.red, text_size = size.small)
            table.cell(anaTable, 1, row, "", text_color = color.red, text_size = size.small)
            table.cell(anaTable, 2, row, "", text_color = color.red, text_size = size.small)
            table.cell(anaTable, 3, row, "", text_color = color.red, text_size = size.small)
            row += 1

            int dnShow = math.min(anaTopN, dnIdx.size())
            if dnShow > 0
                for t = 0 to dnShow - 1
                    int ii = dnIdx.get(t)
                    string name = str.replace_all(ana_statKey.get(ii), "D:", "")
                    table.cell(anaTable, 0, row, name, text_color = color.red, text_size = size.tiny)
                    table.cell(anaTable, 1, row, str.tostring(anaHitRate(ii), "#.#"), text_color = color.white, text_size = size.tiny)
                    table.cell(anaTable, 2, row, str.tostring(anaSampleN(ii)) + "/" + str.tostring(anaTrials(ii)), text_color = color.white, text_size = size.tiny)
                    table.cell(anaTable, 3, row, str.tostring(anaAvgBars(ii), "#.#"), text_color = color.white, text_size = size.tiny)
                    row += 1
            else
                table.cell(anaTable, 0, row, ana_dbgLite < 2 ? "(few targets now)" : "(waiting resolve…)", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 1, row, "—", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 2, row, "—", text_color = color.gray, text_size = size.tiny)
                table.cell(anaTable, 3, row, "—", text_color = color.gray, text_size = size.tiny)
                row += 1

            string tip = "RED● only | Live ▲ " + (ana_liveSigUp == "" ? "—" : ana_liveSigUp) + " ▼ " + (ana_liveSigDn == "" ? "—" : ana_liveSigDn)
            if upIdx.size() > 0
                int bi = upIdx.get(0)
                tip := "Best RED▲ " + str.replace_all(ana_statKey.get(bi), "U:", "") + " " + str.tostring(anaHitRate(bi), "#.#") + "% (n=" + str.tostring(anaSampleN(bi)) + ")"
            else if dnIdx.size() > 0
                int bi = dnIdx.get(0)
                tip := "Best RED▼ " + str.replace_all(ana_statKey.get(bi), "D:", "") + " " + str.tostring(anaHitRate(bi), "#.#") + "% (n=" + str.tostring(anaSampleN(bi)) + ")"
            table.cell(anaTable, 0, row, tip, text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 1, row, "", text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 2, row, "", text_color = color.aqua, text_size = size.tiny)
            table.cell(anaTable, 3, row, "", text_color = color.aqua, text_size = size.tiny)
        else
            table.clear(anaTable, 0, 0, 3, 17)
else if barstate.islast
    table.clear(anaTable, 0, 0, 3, 15)
    table.clear(anaHintTable, 0, 0, 0, 1)

//#endregion


registerSessionTargetEx(float price, color col, float weight, bool isUp, string labelText, bool isToday) =>
    if not na(price) and weight > 0 and canDrawLine() and canDrawLabel()
        lnStyle = sessionTargetLineStyle == 'Solid' ? line.style_solid : sessionTargetLineStyle == 'Dashed' ? line.style_dashed : line.style_dotted
        f = chart.point.from_index(bar_index, price)
        s = chart.point.from_index(bar_index + targetLabelGapBars, price)
        trackLine(line.new(f, s, color = color.new(col, sessionTargetLineTransparency), width = sessionTargetLineWidth, style = lnStyle))
        midX = (bar_index + bar_index + targetLabelGapBars) / 2
        trackLabel(label.new(x = midX, y = price, text = labelText, style = label.style_label_center, color = color.new(color.black, 100), textcolor = col, size = textSizeFromString(targetLabelSize)))
        if isToday
            string sessionKey = "Session_" + labelText + "_" + str.tostring(price)
            registerTarget(price, bar_index + targetLabelGapBars, col, weight, isUp, 1.0, bar_index, sessionKey)

if bar_index == last_bar_index
    if enableSessionTargets
        bool sesaActiveRecently = is_sesa[0] != 0 or (bar_index > 0 and is_sesa[1] != 0)
        if show_sesa and sesa_range
            bool sesaIsTodayTarget = sesaActiveRecently
            if applySessionHigh
                registerSessionTargetEx(curmax_sesa, sesa_css, sessionTargetWeightHigh, true, sesa_txt + " High", sesaIsTodayTarget)
            if applySessionLow
                registerSessionTargetEx(curmin_sesa, sesa_css, sessionTargetWeightLow, false, sesa_txt + " Low", sesaIsTodayTarget)
            if applySessionMid and not na(curmax_sesa) and not na(curmin_sesa)
                midA = (curmax_sesa + curmin_sesa) / 2
                registerSessionTargetEx(midA, sesa_css, sessionTargetWeightMid, true, sesa_txt + " Mid", sesaIsTodayTarget)

        bool sesbActiveRecently = is_sesb[0] != 0 or (bar_index > 0 and is_sesb[1] != 0)
        if show_sesb and sesb_range
            bool sesbIsTodayTarget = sesbActiveRecently
            if applySessionHigh
                registerSessionTargetEx(curmax_sesb, sesb_css, sessionTargetWeightHigh, true, sesb_txt + " High", sesbIsTodayTarget)
            if applySessionLow
                registerSessionTargetEx(curmin_sesb, sesb_css, sessionTargetWeightLow, false, sesb_txt + " Low", sesbIsTodayTarget)
            if applySessionMid and not na(curmax_sesb) and not na(curmin_sesb)
                midB = (curmax_sesb + curmin_sesb) / 2
                registerSessionTargetEx(midB, sesb_css, sessionTargetWeightMid, true, sesb_txt + " Mid", sesbIsTodayTarget)

        bool sescActiveRecently = is_sesc[0] != 0 or (bar_index > 0 and is_sesc[1] != 0)
        if show_sesc and sesc_range
            bool sescIsTodayTarget = sescActiveRecently
            if applySessionHigh
                registerSessionTargetEx(curmax_sesc, sesc_css, tokyoTargetWeightHigh, true, sesc_txt + " High", sescIsTodayTarget)
            if applySessionLow
                registerSessionTargetEx(curmin_sesc, sesc_css, tokyoTargetWeightLow, false, sesc_txt + " Low", sescIsTodayTarget)
            if applySessionMid and not na(curmax_sesc) and not na(curmin_sesc)
                midC = (curmax_sesc + curmin_sesc) / 2
                registerSessionTargetEx(midC, sesc_css, tokyoTargetWeightMid, true, sesc_txt + " Mid", sescIsTodayTarget)

        bool sesdActiveRecently = is_sesd[0] != 0 or (bar_index > 0 and is_sesd[1] != 0)
        if show_sesd and sesd_range
            bool sesdIsTodayTarget = sesdActiveRecently
            if applySessionHigh
                registerSessionTargetEx(curmax_sesd, sesd_css, sessionTargetWeightHigh, true, sesd_txt + " High", sesdIsTodayTarget)
            if applySessionLow
                registerSessionTargetEx(curmin_sesd, sesd_css, sessionTargetWeightLow, false, sesd_txt + " Low", sesdIsTodayTarget)
            if applySessionMid and not na(curmax_sesd) and not na(curmin_sesd)
                midD = (curmax_sesd + curmin_sesd) / 2
                registerSessionTargetEx(midD, sesd_css, sessionTargetWeightMid, true, sesd_txt + " Mid", sesdIsTodayTarget)

    if not na(open_today_price) and dayOCWeight > 0
        f_open = chart.point.from_index(bar_index, open_today_price)
        s_open = chart.point.from_index(bar_index + targetLabelGapBars, open_today_price)
        trackLine(line.new(f_open, s_open, color = color.new(open_line_color, 0), width = 2, style = line.style_solid))
        midX = (bar_index + bar_index + targetLabelGapBars) / 2
        trackLabel(label.new(x = midX, y = open_today_price, text = "H Day Open", style = label.style_label_center, color = color.new(color.black, 100), textcolor = open_line_color, size = textSizeFromString(targetLabelSize)))
        string openKey = "DayOpen_" + str.tostring(open_today_price)
        registerTarget(open_today_price, bar_index + targetLabelGapBars, open_line_color, dayOCWeight, true, 1.0, bar_index, openKey)

    if not na(close_yesterday_price) and dayOCWeight > 0
        f_close = chart.point.from_index(bar_index, close_yesterday_price)
        s_close = chart.point.from_index(bar_index + targetLabelGapBars, close_yesterday_price)
        trackLine(line.new(f_close, s_close, color = color.new(close_line_color, 0), width = 2, style = line.style_dotted))
        midX = (bar_index + bar_index + targetLabelGapBars) / 2
        trackLabel(label.new(x = midX, y = close_yesterday_price, text = "L Day Close", style = label.style_label_center, color = color.new(color.black, 100), textcolor = close_line_color, size = textSizeFromString(targetLabelSize)))
        string closeKey = "DayClose_" + str.tostring(close_yesterday_price)
        registerTarget(close_yesterday_price, bar_index + targetLabelGapBars, close_line_color, dayOCWeight, false, 1.0, bar_index, closeKey)

    if showDayOCBox and not na(open_today_price) and not na(close_yesterday_price)
        boxTop = math.max(open_today_price, close_yesterday_price)
        boxBot = math.min(open_today_price, close_yesterday_price)
        ocBox = box.new(left = bar_index, top = boxTop, right = bar_index + targetLabelGapBars, bottom = boxBot, bgcolor = dayOCBoxBgColor, border_color = color.new(color.white, 70), border_width = 1, border_style = line.style_solid)
        trackBox(ocBox)
        ocLbl = label.new(x = getStaggerX(boxTop, bar_index + targetLabelGapBars), y = boxTop, text = "OC Panel", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.white, 0), size = size.tiny)
        trackLabel(ocLbl)

    if enablePovProfile and registerPovAsTargets
        if pointOfControl and not na(pov_devPocPrice) and pocTargetWeight > 0
            f_poc = chart.point.from_index(bar_index, pov_devPocPrice)
            s_poc = chart.point.from_index(bar_index + targetLabelGapBars, pov_devPocPrice)
            trackLine(line.new(f_poc, s_poc, color = color.new(pocColor, targetLineTransparency), width = 2, style = line.style_solid))
            trackLabel(label.new(x = bar_index + int(targetLabelGapBars / 2), y = pov_devPocPrice, text = "PoC", style = label.style_label_center, color = color.new(color.black, 100), textcolor = pocColor, size = textSizeFromString(targetLabelSize)))
            registerTarget(pov_devPocPrice, bar_index + targetLabelGapBars, pocColor, pocTargetWeight, close < pov_devPocPrice, 1.0, bar_index, "POV_PoC_" + str.tostring(pov_devPocPrice))
        if valueAreaHigh and not na(pov_devVahPrice) and vahTargetWeight > 0
            f_vah = chart.point.from_index(bar_index, pov_devVahPrice)
            s_vah = chart.point.from_index(bar_index + targetLabelGapBars, pov_devVahPrice)
            trackLine(line.new(f_vah, s_vah, color = color.new(vahColor, targetLineTransparency), width = 1, style = line.style_dashed))
            trackLabel(label.new(x = bar_index + int(targetLabelGapBars / 2), y = pov_devVahPrice, text = "VAH", style = label.style_label_center, color = color.new(color.black, 100), textcolor = vahColor, size = textSizeFromString(targetLabelSize)))
            registerTarget(pov_devVahPrice, bar_index + targetLabelGapBars, vahColor, vahTargetWeight, true, 1.0, bar_index, "POV_VAH_" + str.tostring(pov_devVahPrice))
        if valueAreaLow and not na(pov_devValPrice) and valTargetWeight > 0
            f_val = chart.point.from_index(bar_index, pov_devValPrice)
            s_val = chart.point.from_index(bar_index + targetLabelGapBars, pov_devValPrice)
            trackLine(line.new(f_val, s_val, color = color.new(valColor, targetLineTransparency), width = 1, style = line.style_dashed))
            trackLabel(label.new(x = bar_index + int(targetLabelGapBars / 2), y = pov_devValPrice, text = "VAL", style = label.style_label_center, color = color.new(color.black, 100), textcolor = valColor, size = textSizeFromString(targetLabelSize)))
            registerTarget(pov_devValPrice, bar_index + targetLabelGapBars, valColor, valTargetWeight, false, 1.0, bar_index, "POV_VAL_" + str.tostring(pov_devValPrice))

    if enableFvg and registerFvgAsTargets and fvgTargetWeight > 0 and fvg_records.size() > 0
        int fvgRegCount = math.min(fvgMaxRegister, fvg_records.size())
        for i = 0 to fvgRegCount - 1
            FvgGap g = fvg_records.get(i)
            if not na(g.min) and not na(g.max)
                float lvl = g.isbull ? g.min : g.max
                color fvgCol = g.isbull ? fvgBullCss : fvgBearCss
                string fvgLbl = g.isbull ? "FVG Bull" : "FVG Bear"
                if canDrawLine() and canDrawLabel()
                    f_fvg = chart.point.from_index(bar_index, lvl)
                    s_fvg = chart.point.from_index(bar_index + targetLabelGapBars, lvl)
                    trackLine(line.new(f_fvg, s_fvg, color = color.new(fvgCol, targetLineTransparency), width = 1, style = line.style_dotted))
                    trackLabel(label.new(x = bar_index + int(targetLabelGapBars / 2), y = lvl, text = fvgLbl, style = label.style_label_center, color = color.new(color.black, 100), textcolor = fvgToSolid(fvgCol), size = textSizeFromString(targetLabelSize)))
                registerTarget(lvl, bar_index + targetLabelGapBars, fvgToSolid(fvgCol), fvgTargetWeight, g.isbull, 1.0, bar_index, "FVG_" + fvgLbl + "_" + str.tostring(lvl))

    if enableConfluenceZones
        drawConfluenceZones(confluenceTolerancePct, computedZoneMaxWidth, confluenceMinTargets, confluenceTopZonesCount, confluenceZoneLength, confluenceZoneColor, confluenceTopBgColor, startPointInput, confluenceLabelOffsetBars, confluenceLabelSizeTop, confluenceLabelSizeOther)

    drawCloseTargetCircles()
    fillDensityTrendTable()

    if showScoreTable
        string direction = close > open ? "▲ BULL" : close < open ? "▼ BEAR" : "— FLAT"
        color dirColor   = close > open ? color.lime : close < open ? color.red : color.gray

        int totalTargets = g_targetPrices.size()

        float bestUpScore   = 0.0
        float bestDownScore = 0.0
        if totalTargets > 1
            for i = 0 to totalTargets - 1
                if g_targetTrend.get(i)
                    bestUpScore   := math.max(bestUpScore, g_targetWeights.get(i))
                else
                    bestDownScore := math.max(bestDownScore, g_targetWeights.get(i))

        float highestUp   = 0.0
        float lowestDown   = 999999999.0
        for i = 0 to totalTargets - 1
            float p = g_targetPrices.get(i)
            if g_targetTrend.get(i)
                highestUp := math.max(highestUp, p)
            else
                lowestDown := math.min(lowestDown, p)

        table.cell(scoreTable, column = 0, row = 0, text = "Score", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 0, text = "—", text_color = color.gray, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))

        table.cell(scoreTable, column = 0, row = 1, text = "Direction", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 1, text = direction, text_color = dirColor, text_size = size.small, text_halign = text.align_right, text_valign = text.align_center, bgcolor = color.new(dirColor, 20))

        table.cell(scoreTable, column = 0, row = 2, text = "Targets", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 2, text = str.tostring(totalTargets), text_color = color.aqua, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))

        table.cell(scoreTable, column = 0, row = 3, text = "▲ Best", text_color = color.lime, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 3, text = bestUpScore > 0 ? str.tostring(bestUpScore, "#") : "—", text_color = color.lime, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.lime, 85))

        table.cell(scoreTable, column = 0, row = 4, text = "▼ Best", text_color = color.red, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 4, text = bestDownScore > 0 ? str.tostring(bestDownScore, "#") : "—", text_color = color.red, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.red, 85))

        table.cell(scoreTable, column = 0, row = 5, text = "▲ High", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 5, text = highestUp > 0 ? str.tostring(highestUp, "#.##") : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))

        table.cell(scoreTable, column = 0, row = 6, text = "▼ Low", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(scoreTable, column = 1, row = 6, text = lowestDown < 999999999.0 ? str.tostring(lowestDown, "#.##") : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))

//#endregion
