indicator("NCT - Dual Symmetry + Sessions", shorttitle = "NCT+Sessions+POV+FVG", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, dynamic_requests = true)

// ================================================================================================
// بخش الف: موتور NCT Dual Symmetry (سیمتری نودها + تارگت‌ها + زون‌های هم‌پوشان)
// ================================================================================================

// ================================================================================================
// بخش ۱: تعریف Structs و Types
// ================================================================================================
//#region ———————————————————— STRUCTS & TYPES

type Settings
    int    startPoint       = 5000
    int    endPoint         = 0
    bool   swCalcSymmetry   = true
    bool   swCalcLogarithm  = true
    string text_node_size   = "Normal"
    color  c1 = color.white
    color  c2 = color.yellow
    color  c3 = color.aqua
    color  c4 = color.lime
    color  c5 = color.orange
    color  c6 = color.fuchsia
    color  c7 = color.blue
    color  c8 = color.red
    bool   draw             = true

type Node
    int     indexPreNode
    int     indexNode
    int     indexCorrection
    int     numberNode
    float   lowPreNode
    float   highNode
    float   lowCorrection
    float   amountCorrection
    float   log_amountCorrection = 0.0
    bool    isSymmetrySetup      = false

type FvgGap
    float max = na
    float min = na
    bool  isbull = false
    int   t = na
    int   createdBar = 0

type Color
    color   labelColor

type NDS
    Settings     settings
    array<Node>  nodes
    array<Node>  nodesUp
    array<Node>  nodesDown
    array<Color> colors

    bool         swFirst              = true

    float        priceLowest_up       = 999999.0
    int          indexLowest_up       = 0
    float        priceHighest_up      = 0.0
    int          indexHighest_up      = 0

    float        priceLowest_down     = 999999.0
    int          indexLowest_down     = 0
    float        priceHighest_down    = 0.0
    int          indexHighest_down    = 0

//#endregion

// ================================================================================================
// بخش ۲: متدهای محاسبات سیمتری
// ================================================================================================
//#region ———————————————————— INTERNAL CORE METHODS

corrMag(Node n, bool useLog) => useLog ? n.log_amountCorrection : n.amountCorrection

method calcSymmetryNodesDown(series NDS this, int i, bool useLog) =>
    sizeNodes = this.nodesDown.size()
    output = false
    if i >= 3 and i < sizeNodes
        node          = this.nodesDown.get(i)
        prePreNode    = this.nodesDown.get(i-2)
        prePrePreNode = this.nodesDown.get(i-3)

        if prePreNode.numberNode == 2
            if corrMag(node, useLog) >= corrMag(prePreNode, useLog)
                if useLog
                    amountSymmetry = math.log(prePrePreNode.lowPreNode) - math.log(prePreNode.highNode)
                    minPrice       = math.log(prePreNode.lowCorrection) - amountSymmetry
                    if math.log(node.highNode) <= minPrice
                        output := true
                else
                    amountSymmetry = prePrePreNode.lowPreNode - prePreNode.highNode
                    minPrice       = prePreNode.lowCorrection - amountSymmetry
                    if node.highNode <= minPrice
                        output := true
    output

method calcSymmetryNodesUp(series NDS this, int i, bool useLog) =>
    sizeNodes = this.nodesUp.size()
    output = false
    if i >= 3 and i < sizeNodes
        node          = this.nodesUp.get(i)
        prePreNode    = this.nodesUp.get(i-2)
        prePrePreNode = this.nodesUp.get(i-3)

        if prePreNode.numberNode == 2
            if corrMag(node, useLog) >= corrMag(prePreNode, useLog)
                if useLog
                    amountSymmetry = math.log(prePreNode.highNode)   - math.log(prePrePreNode.lowPreNode)
                    maxPrice       = math.log(prePreNode.lowCorrection) + amountSymmetry
                    if math.log(node.highNode) >= maxPrice
                        output := true
                else
                    amountSymmetry = prePreNode.highNode      - prePrePreNode.lowPreNode
                    maxPrice       = prePreNode.lowCorrection + amountSymmetry
                    if node.highNode >= maxPrice
                        output := true
    output

//#endregion

// ================================================================================================
// بخش ۳: متدهای مرتب‌سازی گره‌ها
// ================================================================================================
//#region ———————————————————— SORT METHODS

method sortNodesDownTrend(series NDS this, bool useLog) =>
    i = this.nodesDown.size() - 1
    sw = false
    if this.nodesDown.size() > 0
        sw := true
    while sw
        node = this.nodesDown.get(i)
        if this.nodesDown.size() <= 1
            if node.lowCorrection >= node.lowPreNode
                this.nodesDown.remove(0)
            break
        preNode = this.nodesDown.get(i - 1)
        if node.lowCorrection < preNode.lowCorrection
            if corrMag(node, useLog) < corrMag(preNode, useLog)
                node.numberNode := 1
                this.nodesDown.set(i , node)
                break
            if corrMag(node, useLog) >= corrMag(preNode, useLog)
                if preNode.numberNode == 1
                    if this.settings.swCalcSymmetry == true
                        isSymmetry = this.calcSymmetryNodesDown(i, useLog)
                        if isSymmetry
                            prePrePreNode      = this.nodesDown.get(i - 3)
                            node.indexPreNode := prePrePreNode.indexPreNode
                            node.lowPreNode   := prePrePreNode.lowPreNode
                            node.numberNode   := 1
                            node.isSymmetrySetup := true
                            this.nodesDown.set(i , node)
                            this.nodesDown.remove(i - 1)
                            this.nodesDown.remove(i - 2)
                            this.nodesDown.remove(i - 3)
                            i := i - 3
                            continue
                    node.numberNode := 2
                    this.nodesDown.set(i , node)
                    break
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesDown.get(i - 2).indexPreNode
                    node.lowPreNode := this.nodesDown.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesDown.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    this.nodesDown.remove(i - 2)
                    i := i - 2
                    continue
        else if node.lowCorrection >= preNode.lowCorrection
            if node.highNode > preNode.highNode
                node.indexPreNode     := preNode.indexPreNode
                node.indexNode        := preNode.indexNode
                node.highNode         := preNode.highNode
                node.lowPreNode       := preNode.lowPreNode
                amountCorrection       = node.lowCorrection - node.highNode
                node.amountCorrection := amountCorrection
                if useLog
                    node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
                node.numberNode       := preNode.numberNode
                node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                this.nodesDown.set(i , node)
                this.nodesDown.remove(i - 1)
                i := i - 1
                continue
            if node.highNode <= preNode.highNode
                if preNode.numberNode == 1
                    node.numberNode      := 1
                    node.indexPreNode    := preNode.indexPreNode
                    node.lowPreNode      := preNode.lowPreNode
                    node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    i := i - 1
                    continue
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesDown.get(i - 2).indexPreNode
                    node.lowPreNode   := this.nodesDown.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesDown.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesDown.set(i , node)
                    this.nodesDown.remove(i - 1)
                    this.nodesDown.remove(i - 2)
                    i := i - 2
                    continue

method sortNodesUpTrend(series NDS this, bool useLog) =>
    i = this.nodesUp.size() - 1
    sw = false
    if this.nodesUp.size() > 0
        sw := true
    while sw
        node = this.nodesUp.get(i)
        if this.nodesUp.size() <= 1
            if node.lowCorrection <= node.lowPreNode
                this.nodesUp.remove(0)
            break
        preNode = this.nodesUp.get(i - 1)
        if node.lowCorrection > preNode.lowCorrection
            if corrMag(node, useLog) < corrMag(preNode, useLog)
                node.numberNode := 1
                this.nodesUp.set(i , node)
                break
            if corrMag(node, useLog) >= corrMag(preNode, useLog)
                if preNode.numberNode == 1
                    if this.settings.swCalcSymmetry == true
                        isSymmetry = this.calcSymmetryNodesUp(i, useLog)
                        if isSymmetry
                            prePrePreNode      = this.nodesUp.get(i - 3)
                            node.indexPreNode := prePrePreNode.indexPreNode
                            node.lowPreNode   := prePrePreNode.lowPreNode
                            node.numberNode   := 1
                            node.isSymmetrySetup := true
                            this.nodesUp.set(i , node)
                            this.nodesUp.remove(i - 1)
                            this.nodesUp.remove(i - 2)
                            this.nodesUp.remove(i - 3)
                            i := i - 3
                            continue
                    node.numberNode := 2
                    this.nodesUp.set(i , node)
                    break
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesUp.get(i - 2).indexPreNode
                    node.lowPreNode := this.nodesUp.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesUp.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    this.nodesUp.remove(i - 2)
                    i := i - 2
                    continue
        else if node.lowCorrection <= preNode.lowCorrection
            if node.highNode < preNode.highNode
                node.indexPreNode     := preNode.indexPreNode
                node.indexNode        := preNode.indexNode
                node.highNode         := preNode.highNode
                node.lowPreNode       := preNode.lowPreNode
                node.amountCorrection := node.highNode - node.lowCorrection
                if useLog
                    node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
                node.numberNode       := preNode.numberNode
                node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                this.nodesUp.set(i , node)
                this.nodesUp.remove(i - 1)
                i := i - 1
                continue
            if node.highNode >= preNode.highNode
                if preNode.numberNode == 1
                    node.numberNode      := 1
                    node.indexPreNode    := preNode.indexPreNode
                    node.lowPreNode      := preNode.lowPreNode
                    node.isSymmetrySetup := preNode.isSymmetrySetup or node.isSymmetrySetup
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    i := i - 1
                    continue
                if preNode.numberNode == 2
                    node.indexPreNode := this.nodesUp.get(i - 2).indexPreNode
                    node.lowPreNode   := this.nodesUp.get(i - 2).lowPreNode
                    node.isSymmetrySetup := this.nodesUp.get(i - 2).isSymmetrySetup or node.isSymmetrySetup
                    node.numberNode   := 1
                    this.nodesUp.set(i , node)
                    this.nodesUp.remove(i - 1)
                    this.nodesUp.remove(i - 2)
                    i := i - 2
                    continue

//#endregion

// ================================================================================================
// بخش ۴: متدهای ایجاد و به‌روزرسانی گره‌ها
// ================================================================================================
//#region ———————————————————— NODE CREATION & UPDATE

method SetNode_UpTrend(series NDS this) =>
    numberNode       = 1
    indexPreNode     = this.indexLowest_up
    indexNode        = this.indexHighest_up
    indexCorrection  = bar_index
    lowPreNode       = this.priceLowest_up
    highNode         = this.priceHighest_up
    lowCorrection    = low[0]
    amountCorrection = highNode - lowCorrection
    log_amountCorrection = math.log(highNode) - math.log(lowCorrection)
    Node node = Node.new(indexPreNode, indexNode, indexCorrection, numberNode, lowPreNode, highNode, lowCorrection, amountCorrection, log_amountCorrection, false)
    this.nodesUp.push(node)

    this.sortNodesUpTrend(this.settings.swCalcLogarithm)
    this.priceHighest_up := low[0]
    this.indexHighest_up := bar_index

method SetNode_DownTrend(series NDS this) =>
    numberNode       = 1
    indexPreNode     = this.indexHighest_down
    indexNode        = this.indexLowest_down
    indexCorrection  = bar_index
    lowPreNode       = this.priceHighest_down
    highNode         = this.priceLowest_down
    lowCorrection    = high[0]
    amountCorrection = lowCorrection - highNode
    log_amountCorrection = math.log(lowCorrection) - math.log(highNode)
    Node node = Node.new(indexPreNode, indexNode, indexCorrection, numberNode, lowPreNode, highNode, lowCorrection, amountCorrection, log_amountCorrection, false)
    this.nodesDown.push(node)

    this.sortNodesDownTrend(this.settings.swCalcLogarithm)
    this.priceLowest_down := high[0]
    this.indexLowest_down := bar_index

method CalcNode_UpTrend(series NDS this) =>
    if low[0] < this.priceLowest_up
        this.priceLowest_up := low[0]
        this.indexLowest_up := bar_index
    if high[0] > this.priceHighest_up
        this.priceHighest_up := high[0]
        this.indexHighest_up := bar_index

    sizeNodes = this.nodesUp.size()
    if sizeNodes > 0
        node = this.nodesUp.last()
        if low[0] <= node.lowCorrection
            node.lowCorrection    := low[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.highNode - node.lowCorrection
            node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
            this.nodesUp.set(sizeNodes-1 , node)
            this.sortNodesUpTrend(this.settings.swCalcLogarithm)
        else if open[0] > close[0] and open[1] > close[1]
            if high[0] >= node.highNode
                node.highNode  := high[0]
                node.indexNode := bar_index
            if low[0] < low[1]
                node.lowCorrection    := low[0]
                node.indexCorrection  := bar_index
            node.amountCorrection := node.highNode - node.lowCorrection
            node.log_amountCorrection := math.log(node.highNode) - math.log(node.lowCorrection)
            this.nodesUp.set(sizeNodes-1 , node)
            this.sortNodesUpTrend(this.settings.swCalcLogarithm)
            this.indexLowest_up     := this.nodesUp.last().indexCorrection
            this.priceLowest_up     := low[bar_index - this.indexLowest_up]

    isNode = false
    if open[0] > close[0]
        isNode := true
    if isNode
        sizeNodes := this.nodesUp.size()
        if sizeNodes == 0
            this.SetNode_UpTrend()
        else if sizeNodes > 0
            this.indexLowest_up     := this.nodesUp.last().indexCorrection
            this.priceLowest_up     := low[bar_index - this.indexLowest_up]
            this.SetNode_UpTrend()

method CalcNode_DownTrend(series NDS this) =>
    if low[0] < this.priceLowest_down
        this.priceLowest_down := low[0]
        this.indexLowest_down := bar_index
    if high[0] > this.priceHighest_down
        this.priceHighest_down := high[0]
        this.indexHighest_down := bar_index

    sizeNodes = this.nodesDown.size()
    if sizeNodes > 0
        node = this.nodesDown.last()
        if high[0] >= node.lowCorrection
            node.lowCorrection    := high[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.lowCorrection - node.highNode
            node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
            this.nodesDown.set(sizeNodes-1 , node)
            this.sortNodesDownTrend(this.settings.swCalcLogarithm)
        else if open[0] < close[0] and open[1] < close[1]
            if low[0] <= node.highNode
                node.highNode  := low[0]
                node.indexNode := bar_index
            node.lowCorrection    := high[0]
            node.indexCorrection  := bar_index
            node.amountCorrection := node.lowCorrection - node.highNode
            node.log_amountCorrection := math.log(node.lowCorrection) - math.log(node.highNode)
            this.nodesDown.set(sizeNodes-1 , node)
            this.sortNodesDownTrend(this.settings.swCalcLogarithm)

    isNode = false
    if open[0] < close[0]
        isNode := true
    if isNode
        sizeNodes := this.nodesDown.size()
        if sizeNodes == 0
            this.SetNode_DownTrend()
        else if sizeNodes > 0
            this.indexHighest_down     := this.nodesDown.last().indexCorrection
            this.priceHighest_down     := high[bar_index - this.indexHighest_down]
            this.SetNode_DownTrend()

//#endregion

// ================================================================================================
// بخش ۵: متدهای رسم و نمایش
// ================================================================================================
//#region ———————————————————— DRAWING METHODS

var g_labels = array.new<label>()
var g_lines  = array.new<line>()
var g_boxes  = array.new<box>()
var g_circles = array.new<label>()

// Leave headroom under TradingView hard caps (500)
MAX_DRAW_LINES   = 480
MAX_DRAW_LABELS  = 480
MAX_DRAW_BOXES   = 480
MAX_HIT_LOOKBACK = 2000
MAX_ROUND_LEVELS = 40

canDrawLine() =>
    g_lines.size() < MAX_DRAW_LINES

canDrawLabel() =>
    g_labels.size() + g_circles.size() < MAX_DRAW_LABELS

canDrawBox() =>
    g_boxes.size() < MAX_DRAW_BOXES

trackLabel(label lbl) =>
    if canDrawLabel()
        g_labels.push(lbl)
    else
        label.delete(lbl)

trackLine(line ln) =>
    if canDrawLine()
        g_lines.push(ln)
    else
        line.delete(ln)

trackBox(box b) =>
    if canDrawBox()
        g_boxes.push(b)
    else
        box.delete(b)

trackCircle(label circ) =>
    if canDrawLabel()
        g_circles.push(circ)
    else
        label.delete(circ)

clearDrawings() =>
    while g_labels.size() > 0
        label.delete(g_labels.pop())
    while g_lines.size() > 0
        line.delete(g_lines.pop())
    while g_boxes.size() > 0
        box.delete(g_boxes.pop())
    while g_circles.size() > 0
        label.delete(g_circles.pop())

// Hit+grace check with capped lookback + early break (safe inside target loops; avoid ta.* in loops)
shouldDeleteHitTarget(float price, int startIdx, bool isUp, bool deleteHit, int hitGraceBars) =>
    bool result = false
    if deleteHit and not na(price) and startIdx <= bar_index
        int lastCheckBar = bar_index - hitGraceBars - 1
        if lastCheckBar >= startIdx
            int fromBar = math.max(startIdx, lastCheckBar - MAX_HIT_LOOKBACK + 1)
            for barIdx = fromBar to lastCheckBar
                bool touched = isUp ? high[bar_index - barIdx] >= price : low[bar_index - barIdx] <= price
                if touched
                    result := true
                    break
    result

// === ورودی: دایره‌های تراکم تارگت (قرمز = خیلی نزدیک / زرد = کمی دورتر) ===
var GRP_CLOSE = "Close Target Detection"
showCloseTargetCircles = input.bool(true, 'Show Density Circles', group = GRP_CLOSE, tooltip = 'نمایش دایره روی مرکز خوشه‌های تراکم تارگت')

showRedDensityCircle = input.bool(true, 'Show Red Circle (Very Close)', inline = 'dens1', group = GRP_CLOSE)
showYellowDensityCircle = input.bool(true, 'Show Yellow Circle (Near)', inline = 'dens1', group = GRP_CLOSE)

redDensityTolerancePct = input.float(0.01, 'Red Tolerance (%)', minval = 0.001, maxval = 10, step = 0.01, group = GRP_CLOSE, tooltip = 'تارگت‌های نودِ نمایش‌داده‌شده که عرض خوشه‌شان ≤ این % باشد → دایره قرمز')
yellowDensityTolerancePct = input.float(0.05, 'Yellow Tolerance (%)', minval = 0.001, maxval = 10, step = 0.01, group = GRP_CLOSE, tooltip = 'تارگت‌های نودِ نمایش‌داده‌شده که از قرمز دورترند ولی عرض ≤ این % باشد → دایره زرد')

redDensityMinCount = input.int(2, 'Red Min Targets', minval = 2, maxval = 20, inline = 'dens2', group = GRP_CLOSE)
yellowDensityMinCount = input.int(2, 'Yellow Min Targets', minval = 2, maxval = 20, inline = 'dens2', group = GRP_CLOSE)

redDensityColor = input.color(color.red, 'Red Circle Color', inline = 'dens3', group = GRP_CLOSE)
yellowDensityColor = input.color(color.yellow, 'Yellow Circle Color', inline = 'dens3', group = GRP_CLOSE)

redDensitySize = input.string('Huge', 'Red Circle Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], inline = 'dens4', group = GRP_CLOSE)
yellowDensitySize = input.string('Huge', 'Yellow Circle Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], inline = 'dens4', group = GRP_CLOSE)

redCircleScore = input.float(100, 'Score per Red Circle', minval = 0, step = 1, group = GRP_CLOSE, tooltip = 'امتیاز هر دایره قرمز برای تشخیص قدرت روند')
yellowCircleScore = input.float(40, 'Score per Yellow Circle', minval = 0, step = 1, group = GRP_CLOSE, tooltip = 'امتیاز هر دایره زرد برای تشخیص قدرت روند')
showDensityTrendTable = input.bool(true, 'Show Density Trend Table', group = GRP_CLOSE, tooltip = 'جدول کوچک حدس روند بر اساس تعداد دایره‌های قرمز و زرد')
densityMediumScore = input.float(100, 'Medium Strength Min Score', minval = 0, group = GRP_CLOSE, tooltip = 'اگر امتیاز سمت برنده ≥ این مقدار باشد → قدرت متوسط')
densityStrongScore = input.float(250, 'Strong Strength Min Score', minval = 0, group = GRP_CLOSE, tooltip = 'اگر امتیاز سمت برنده ≥ این مقدار باشد → قدرت قوی')

// شمارنده‌های دایره‌های تراکم: [redUp, redDn, yelUp, yelDn] — آرایه تا داخل تابع قابل تغییر باشد
var g_densStats = array.new_int(4, 0)

var table densityTrendTable = table.new(position = position.top_right, columns = 2, rows = 7, bgcolor = color.new(color.black, 0), border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

resetDensityStats() =>
    array.fill(g_densStats, 0)

bumpDensityStat(bool isRedKind, bool isUp) =>
    int idx = isRedKind ? (isUp ? 0 : 1) : (isUp ? 2 : 3)
    array.set(g_densStats, idx, array.get(g_densStats, idx) + 1)

// آرایه‌های موقتِ ثبت تارگت‌ها برای تشخیص هم‌پوشانی (Confluence)
var g_targetPrices = array.new<float>()
var g_targetXEnd   = array.new<int>()
var g_targetColors = array.new<color>()
var g_targetWeights = array.new<float>()
var g_targetTrend  = array.new<bool>()
var g_targetKeys   = array.new<string>()
var g_targetIsNode = array.new<bool>()

// فقط تارگت‌های نود که واقعاً روی چارت رسم شده‌اند (برای دایره قرمز/زرد)
var g_visDensPrices = array.new<float>()
var g_visDensXEnd   = array.new<int>()
var g_visDensTrend  = array.new<bool>()

resetVisibleDensity() =>
    g_visDensPrices.clear()
    g_visDensXEnd.clear()
    g_visDensTrend.clear()

registerVisibleDensity(float price, int xEnd, bool isUp) =>
    if not na(price)
        bool isDup = false
        int n = g_visDensPrices.size()
        if n > 0
            for i = 0 to n - 1
                if g_visDensTrend.get(i) == isUp and g_visDensPrices.get(i) == price
                    isDup := true
                    break
        if not isDup
            g_visDensPrices.push(price)
            g_visDensXEnd.push(xEnd)
            g_visDensTrend.push(isUp)

// --- آرایه‌های جلوگیری از تداخل لیبل‌های تارگت (Label Anti-Overlap) ---
var g_stagLabelPrice = array.new<float>()
var g_stagLabelX     = array.new<int>()

// --- ورودی‌های وزن‌دهی نود قدیمی/جدید ---
var GRP_AGE = "Node Age Weight (Old vs New Targets)"
nodeAgeWeightEnabled = input.bool(true, 'Enable Age-Based Weighting', group = GRP_AGE, tooltip = 'نودهای قدیمی‌تر امتیاز بیشتر، نودهای جدیدتر امتیاز کمتر می‌گیرند. تارگت‌های رند/سشن/روزانه همیشه امتیاز ثابت دارند.')
nodeAgeStepPct = input.float(50.0, 'Age Weight Increase per Older Node (%)', minval = 0, maxval = 1000, step = 5, group = GRP_AGE, tooltip = 'هر نود قدیمی‌تر به این درصد امتیاز بیشتر می‌گیرد. مثال: ۵۰٪ یعنی نود جدید = ۱۰۰٪، یک نود قدیمی‌تر = ۱۵۰٪، دو نود قدیمی‌تر = ۲۰۰٪ و ...')

// --- ورودی‌های تنظیم تداخل لیبل‌ها ---
var GRP_LBL = "Target Label Anti-Overlap"
targetLabelPriceTolerancePct = input.float(0.05, 'Label Collision Tolerance (%)', minval = 0.001, maxval = 5, step = 0.001, group = GRP_LBL, tooltip = 'اگر دو لیبل از نظر قیمتی به این درصد یا کمتر نزدیک باشند، تداخل تشخیص داده شده و یکی جلوتر قرار می‌گیرد')
targetLabelStaggerStep = input.int(18, 'Label Stagger Step (bars)', minval = 2, maxval = 200, group = GRP_LBL, tooltip = 'فاصله جلو‌رفتن هر لیبل متداخل بر حسب تعداد کندل')
targetLabelSize = input.string('Small', 'Target Label Font Size', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP_LBL, tooltip = 'اندازه فونت نوشته روی همه تارگت‌ها (نود، زوج، رند، سشن، Day OC)')

// جدول امتیازات — سمت راست بالای نمودار
var table scoreTable = table.new(position = position.bottom_right, columns = 2, rows = 7, bgcolor = color.new(color.black, 0), border_color = color.new(color.gray, 50), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 2)

// --- تابع جلوگیری از تداخل لیبل‌ها: اگر لیبل جدید با لیبل قبلی قیمتی نزدیک دارد، جلوتر می‌رود ---
getStaggerX(float price, int baseX) =>
    int maxX = bar_index + 490
    int x = math.min(baseX, maxX)
    bool collision = true
    int guard = 0
    while collision and guard < 40
        collision := false
        n = g_stagLabelPrice.size()
        if n > 0
            for i = 0 to n - 1
                if g_stagLabelX.get(i) == x
                    p = g_stagLabelPrice.get(i)
                    refP = math.max(math.abs(p), 0.0000001)
                    diffPct = math.abs(p - price) / refP * 100
                    if diffPct <= targetLabelPriceTolerancePct
                        collision := true
                        break
        if collision
            x := math.min(x + targetLabelStaggerStep, maxX)
        guard += 1
    g_stagLabelPrice.push(price)
    g_stagLabelX.push(x)
    x

// --- محاسبه ضریب سن نود: نود جدید = 1.0، هر نود قدیمی‌تر = ضریب بیشتر ---
// ageFromNewest: 0 = جدیدترین، 1 = یک نود قدیمی‌تر، 2 = دو نود قدیمی‌تر و ...
calcNodeAgeMult(int ageFromNewest) =>
    if not nodeAgeWeightEnabled
        1.0
    else
        1.0 + (ageFromNewest * nodeAgeStepPct / 100.0)

resetTargetRegistry() =>
    g_targetPrices.clear()
    g_targetXEnd.clear()
    g_targetColors.clear()
    g_targetWeights.clear()
    g_targetTrend.clear()
    g_targetKeys.clear()
    g_targetIsNode.clear()
    g_stagLabelPrice.clear()
    g_stagLabelX.clear()
    resetVisibleDensity()

isNodeTargetKey(string key) =>
    str.startswith(key, "Node") or str.startswith(key, "Pair")

var GRP9 = "Target Confluence — Value Weights"
targetDedupTolerancePct = input.float(0, 'Duplicate Target Filter (%)', minval = 0, maxval = 5, step = 0.01, group = GRP9, tooltip = 'اگر دو تارگت با هم روی یک روند از نظر قیمتی به این میزان درصد یا کمتر نزدیک باشند، فقط اولی ثبت می‌شود')

registerTarget(float price, int xEnd, color col, float weight, bool isUp, float ageMult = 1.0, int xStart = bar_index, string key = "") =>
    // اگر کلید خالی بود، یک کلید بر اساس قیمت و روند بساز
    string targetKey = key
    if targetKey == ""
        targetKey := str.tostring(price) + "_" + str.tostring(isUp)
    
    // اعمال ضریب سن نود (نود قدیمی → وزن بیشتر، نود جدید → وزن کمتر)
    float effectiveWeight = weight * ageMult
    bool isDup = false
    n = g_targetPrices.size()
    if n > 0
        for i = 0 to n - 1
            // بررسی تکراری بودن بر اساس کلید
            if g_targetKeys.get(i) == targetKey
                isDup := true
                break
            // همچنین بررسی بر اساس قیمت و روند (برای سازگاری با کد قدیمی)
            if g_targetTrend.get(i) == isUp
                p = g_targetPrices.get(i)
                refP = math.max(math.abs(p), 0.0000001)
                diffPct = math.abs(p - price) / refP * 100
                if diffPct <= targetDedupTolerancePct
                    isDup := true
                    break
    
    if not isDup
        g_targetPrices.push(price)
        g_targetXEnd.push(xEnd)
        g_targetColors.push(col)
        g_targetWeights.push(effectiveWeight)
        g_targetTrend.push(isUp)
        g_targetKeys.push(targetKey)
        g_targetIsNode.push(isNodeTargetKey(targetKey))

// === دایره‌های تراکم: قرمز (خیلی نزدیک) / زرد (کمی دورتر) ===
// یک پاس با تلرانس زرد (بازتر)، بعد طبق عرض واقعی خوشه رنگ انتخاب می‌شود
drawCloseTargetCircles() =>
    resetDensityStats()
    if showCloseTargetCircles and (showRedDensityCircle or showYellowDensityCircle)
        float redTol = redDensityTolerancePct
        float yellowTol = math.max(yellowDensityTolerancePct, redTol)
        int minNeeded = math.min(redDensityMinCount, yellowDensityMinCount)
        // فقط تارگت‌های نودی که واقعاً رسم شده‌اند
        n = math.min(g_visDensPrices.size(), math.min(g_visDensXEnd.size(), g_visDensTrend.size()))
        if n >= minNeeded
            array<float> sortedPrices = array.copy(g_visDensPrices)
            array<int>   sortedXEnd   = array.copy(g_visDensXEnd)
            array<bool>  sortedTrend  = array.copy(g_visDensTrend)
            // مرتب‌سازی صعودی قیمت
            for i = 1 to n - 1
                float pKey = sortedPrices.get(i)
                int   xKey = sortedXEnd.get(i)
                bool  tKey = sortedTrend.get(i)
                int j = i - 1
                while j >= 0 and sortedPrices.get(j) > pKey
                    sortedPrices.set(j + 1, sortedPrices.get(j))
                    sortedXEnd.set(j + 1, sortedXEnd.get(j))
                    sortedTrend.set(j + 1, sortedTrend.get(j))
                    j -= 1
                sortedPrices.set(j + 1, pKey)
                sortedXEnd.set(j + 1, xKey)
                sortedTrend.set(j + 1, tKey)

            array<bool> used = array.new<bool>(n, false)
            for i = 0 to n - 1
                if used.get(i) or not canDrawLabel()
                    continue
                bool trendI = sortedTrend.get(i)
                float runMin = sortedPrices.get(i)
                float runMax = runMin
                int runMaxX = sortedXEnd.get(i)
                array<int> cluster = array.new<int>()
                cluster.push(i)
                if i < n - 1
                    for j = i + 1 to n - 1
                        if used.get(j)
                            continue
                        float priceJ = sortedPrices.get(j)
                        refP = math.max(math.abs(runMin), 0.0000001)
                        // اگر از بازه زرد خارج شد، بقیه هم دورترند (آرایه مرتب است)
                        widthProbe = (math.max(runMax, priceJ) - math.min(runMin, priceJ)) / refP * 100
                        if widthProbe > yellowTol
                            break
                        // روند مخالف را رد کن؛ break نکن
                        if sortedTrend.get(j) != trendI
                            continue
                        cluster.push(j)
                        runMin := math.min(runMin, priceJ)
                        runMax := math.max(runMax, priceJ)
                        runMaxX := math.max(runMaxX, sortedXEnd.get(j))

                int cSize = cluster.size()
                // تکی را مصرف کن تا حلقه گیر نکند
                if cSize < 2
                    used.set(i, true)
                    continue

                for k = 0 to cSize - 1
                    used.set(cluster.get(k), true)

                refW = math.max(math.abs(runMin), 0.0000001)
                float widthPct = (runMax - runMin) / refW * 100
                float midPrice = (runMin + runMax) / 2.0

                // قرمز: عرض خیلی کوچک | زرد: عرض بزرگ‌تر ولی داخل yellowTol
                bool asRed = showRedDensityCircle and widthPct <= redTol and cSize >= redDensityMinCount
                bool asYellow = showYellowDensityCircle and not asRed and widthPct <= yellowTol and cSize >= yellowDensityMinCount
                // اگر خیلی نزدیک بود ولی به حد نصاب قرمز نرسید، در صورت امکان زرد شود
                if not asRed and not asYellow and showYellowDensityCircle and widthPct <= yellowTol and cSize >= yellowDensityMinCount
                    asYellow := true

                if asRed or asYellow
                    bumpDensityStat(asRed, trendI)
                    string sizeStr = asRed ? redDensitySize : yellowDensitySize
                    color dotColor = asRed ? redDensityColor : yellowDensityColor
                    dotSize = switch sizeStr
                        'Auto'   => size.auto
                        'Huge'   => size.huge
                        'Large'  => size.large
                        'Normal' => size.normal
                        'Small'  => size.small
                        => size.tiny
                    if canDrawLabel()
                        circ = label.new(x = runMaxX, y = midPrice, text = "●", style = label.style_label_center, color = color.new(color.black, 100), textcolor = dotColor, size = dotSize)
                        trackCircle(circ)

fillDensityTrendTable() =>
    if showDensityTrendTable
        int redUp = array.get(g_densStats, 0)
        int redDn = array.get(g_densStats, 1)
        int yelUp = array.get(g_densStats, 2)
        int yelDn = array.get(g_densStats, 3)
        float upScore = redUp * redCircleScore + yelUp * yellowCircleScore
        float dnScore = redDn * redCircleScore + yelDn * yellowCircleScore
        float bias = upScore - dnScore
        float winnerScore = math.max(upScore, dnScore)
        string trendTxt = bias > 0 ? "▲ BULL" : bias < 0 ? "▼ BEAR" : "— FLAT"
        color trendCol = bias > 0 ? color.lime : bias < 0 ? color.red : color.gray
        string strengthTxt = winnerScore <= 0 ? "None" : winnerScore >= densityStrongScore ? "Strong" : winnerScore >= densityMediumScore ? "Medium" : "Weak"
        color strengthCol = strengthTxt == "Strong" ? color.lime : strengthTxt == "Medium" ? color.orange : strengthTxt == "Weak" ? color.yellow : color.gray
        int redTotal = redUp + redDn
        int yelTotal = yelUp + yelDn

        table.cell(densityTrendTable, 0, 0, text = "Density Trend", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 0, text = trendTxt, text_color = trendCol, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(trendCol, 20))
        table.cell(densityTrendTable, 0, 1, text = "Strength", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 1, text = strengthTxt, text_color = strengthCol, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(strengthCol, 80))
        table.cell(densityTrendTable, 0, 2, text = "▲ Score", text_color = color.lime, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 2, text = str.tostring(upScore, "#"), text_color = color.lime, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 0, 3, text = "▼ Score", text_color = color.red, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 3, text = str.tostring(dnScore, "#"), text_color = color.red, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 0, 4, text = "Red ●", text_color = redDensityColor, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 4, text = str.tostring(redTotal) + "  (" + str.tostring(redUp) + "↑ " + str.tostring(redDn) + "↓)", text_color = redDensityColor, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 0, 5, text = "Yellow ●", text_color = yellowDensityColor, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 5, text = str.tostring(yelTotal) + "  (" + str.tostring(yelUp) + "↑ " + str.tostring(yelDn) + "↓)", text_color = yellowDensityColor, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 0, 6, text = "Bias", text_color = color.aqua, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 0))
        table.cell(densityTrendTable, 1, 6, text = (bias > 0 ? "+" : "") + str.tostring(bias, "#"), text_color = trendCol, text_size = size.small, text_halign = text.align_right, bgcolor = color.new(color.black, 0))
    else
        table.clear(densityTrendTable, 0, 0, 1, 6)

// ================================================================================================
// وزن‌های ارزش‌گذاری تارگت‌ها — همه در یکجا
// ================================================================================================
// --- وزن‌های تارگت تکی (نود ۱) ---
targetWeightSingleMin        = input.float(200, 'Weight: Single Min Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Min تکی (نود ۱)')
targetWeightSingleDouble     = input.float(100, 'Weight: Single Double Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Double تکی (نود ۱)')
targetWeightSingleCorrection = input.float(30,  'Weight: Single Correction Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Correction تکی (نود ۱)')
// --- وزن‌های تارگت زوجی (نود ۱+۲) ---
targetWeightPairMin           = input.float(200, 'Weight: Pair Min Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Min زوجی (نود ۱+۲)')
targetWeightPairMax           = input.float(100, 'Weight: Pair Max Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Max زوجی (نود ۱+۲)')
targetWeightPairDouble        = input.float(50,  'Weight: Pair Double Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Double زوجی (نود ۱+۲)')
targetWeightPairCorrection    = input.float(30,  'Weight: Pair Correction Target', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی هر تارگت Correction زوجی (نود ۱+۲)')
// --- وزن تارگت قیمت رند ---
