sessionTargetWeightHigh       = input.float(80, 'Weight: Session High', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی سقف هر سشن')
sessionTargetWeightLow        = input.float(80, 'Weight: Session Low', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی کف هر سشن')
sessionTargetWeightMid        = input.float(50, 'Weight: Session Midline', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی میدلاین هر سشن')
