enableTargetAnalytics = input.bool(true, 'Enable Combo Analytics', group = GRP_ANA, tooltip = 'فقط خوشه‌هایی که دایره قرمز می‌سازند وارد بک‌تست می‌شوند؛ بقیه حذف')
