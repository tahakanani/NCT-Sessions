anaLookaheadBars = input.int(50, 'Hit Lookahead Bars', minval = 5, maxval = 500, group = GRP_ANA, tooltip = 'حداکثر کندل برای رسیدن قیمت به تارگت مرجع')
anaStopAtrMult = input.float(1.0, 'Fail Stop ATR Mult', minval = 0.1, maxval = 5.0, step = 0.1, group = GRP_ANA, tooltip = 'اگر قبل از Hit، قیمت این مقدار ATR خلاف جهت برود → Fail')
anaMinSamples = input.int(3, 'Min Samples to Rank', minval = 1, maxval = 100, group = GRP_ANA)
anaTopN = input.int(5, 'Top N Combos', minval = 1, maxval = 10, group = GRP_ANA)
