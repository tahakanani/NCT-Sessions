anaMinTypesInCluster = input.int(2, 'Min Distinct Types in Cluster', minval = 2, maxval = 8, group = GRP_ANA)
anaClusterTolPct = input.float(0.5, 'Analytics Cluster Tolerance (%) [unused if Red-only]', minval = 0.01, maxval = 10.0, step = 0.05, group = GRP_ANA, tooltip = 'دیگر برای رویداد استفاده نمی‌شود. بک‌تست فقط روی خوشه دایره قرمز است (Red Tolerance در Close Target Detection).')
anaEventCooldown = input.int(5, 'Event Cooldown Bars', minval = 1, maxval = 100, group = GRP_ANA)
anaShowTable = input.bool(true, 'Show Analytics Table', group = GRP_ANA)
anaShowLiveHint = input.bool(true, 'Show Live Setup Hint', group = GRP_ANA)

method initColor(series NDS this) =>
    this.colors.push(Color.new(this.settings.c1))
    this.colors.push(Color.new(this.settings.c2))
    this.colors.push(Color.new(this.settings.c3))
    this.colors.push(Color.new(this.settings.c4))
    this.colors.push(Color.new(this.settings.c5))
    this.colors.push(Color.new(this.settings.c6))
    this.colors.push(Color.new(this.settings.c7))
    this.colors.push(Color.new(this.settings.c8))

textSizeFromString(string s) =>
    switch s
        'Auto'   => size.auto
        'Huge'   => size.huge
        'Large'  => size.large
        'Normal' => size.normal
        'Small'  => size.small
        => size.tiny

method drawingNumberNodes(series NDS this, bool swUptrendType, string suffix, int extraGapLines, bool showRegularNodes, bool showDoubleStarNodes) =>
    array<Node> nodesRef = array.new<Node>()
    var locText = yloc.belowbar
    if swUptrendType
        locText := yloc.abovebar
        nodesRef := this.nodesUp
    else
        nodesRef := this.nodesDown

    text_node_size_opt = this.settings.text_node_size
    indexColor = 0
    countNodes = nodesRef.size()

    gapPrefix = ""
    if extraGapLines > 0
        for g = 1 to extraGapLines
            gapPrefix := gapPrefix + "\n"

    if countNodes > 0
        for i = 0 to countNodes - 1
            node = nodesRef.get(i)
            index = node.indexNode
            numberNode  = node.numberNode
            textColor = this.colors.get(indexColor).labelColor
            string baseText = node.isSymmetrySetup ? "**" + str.tostring(numberNode) + "**" : str.tostring(numberNode) + suffix
            string newText = baseText
            if i > 0
                if nodesRef.get(i - 1).indexNode == node.indexNode
                    newText := '     ' + newText
            if node.isSymmetrySetup
                newText := gapPrefix + newText

            shouldDraw = node.isSymmetrySetup ? showDoubleStarNodes : showRegularNodes
            if shouldDraw and canDrawLabel()
                lbl = label.new(x = index, y = na, text = newText, yloc = locText, style = label.style_none, color = color.new(color.white, 100), textcolor = textColor, size = textSizeFromString(text_node_size_opt))
                trackLabel(lbl)

            if i == countNodes - 1
                break
            nextNumberNode = nodesRef.get(i+1).numberNode
            if nextNumberNode == 1
                indexColor := indexColor + 1
            if indexColor == 8
                indexColor := 1

method computeNodeColors(series NDS this, array<Node> nodesRef) =>
    countNodes = nodesRef.size()
    array<color> result = array.new<color>(countNodes)
    indexColor = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            result.set(i, this.colors.get(indexColor).labelColor)
            if i == countNodes - 1
                break
            nextNumberNode = nodesRef.get(i+1).numberNode
            if nextNumberNode == 1
                indexColor := indexColor + 1
            if indexColor == 8
                indexColor := 1
    result

method drawingLineNodes(series NDS this) =>
    lineWidth  = 2

    sizeNodesUp = this.nodesUp.size()
    if sizeNodesUp > 0
        colorsUp = this.computeNodeColors(this.nodesUp)
        for i= 0 to sizeNodesUp - 1
            node = this.nodesUp.get(i)
            lineColor = colorsUp.get(i)
            firstPoint  = chart.point.from_index(node.indexPreNode ,node.lowPreNode)
            secondPoint = chart.point.from_index(node.indexNode    ,node.highNode)
            thirdPoint  = chart.point.from_index(node.indexCorrection ,node.lowCorrection)
            trackLine(line.new(firstPoint, secondPoint ,color = lineColor  ,width = lineWidth ))
            trackLine(line.new(secondPoint, thirdPoint ,color = lineColor ,width = lineWidth ))

    sizeNodesDown = this.nodesDown.size()
    if sizeNodesDown > 0
        colorsDown = this.computeNodeColors(this.nodesDown)
        for i= 0 to sizeNodesDown - 1
            node = this.nodesDown.get(i)
            lineColor = colorsDown.get(i)
            firstPoint  = chart.point.from_index(node.indexPreNode ,node.lowPreNode)
            secondPoint = chart.point.from_index(node.indexNode    ,node.highNode)
            thirdPoint  = chart.point.from_index(node.indexCorrection ,node.lowCorrection)
            trackLine(line.new(firstPoint, secondPoint ,color = lineColor  ,width = lineWidth ))
            trackLine(line.new(secondPoint, thirdPoint ,color = lineColor ,width = lineWidth ))

// ================================================================================================
// تارگت‌های نود ۱ (Double + Min + Correction)
// ================================================================================================
method drawingTargetsNode1(series NDS this, bool swUptrendType, bool showDouble, bool showMin, bool showCorrection, int doubleWidth, int minWidth, int correctionWidth, string doubleStyle, string minStyle, string correctionStyle, int maxCount, int gapBars, bool deleteHit, int hitGraceBars, int lineTransparency) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    trendPrefix = swUptrendType ? "H " : "L "
    countNodes = nodesRef.size()
    lnStyleDouble     = doubleStyle     == 'Solid' ? line.style_solid : doubleStyle     == 'Dashed' ? line.style_dashed : line.style_dotted
    lnStyleMin        = minStyle        == 'Solid' ? line.style_solid : minStyle        == 'Dashed' ? line.style_dashed : line.style_dotted
    lnStyleCorrection = correctionStyle == 'Solid' ? line.style_solid : correctionStyle == 'Dashed' ? line.style_dashed : line.style_dotted

    colorPerIndex = this.computeNodeColors(nodesRef)

    array<bool> qualifies = array.new<bool>(countNodes)
    qualifyingTotal = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            node = nodesRef.get(i)
            isQualified = node.numberNode == 1
            qualifies.set(i, isQualified)
            if isQualified
                qualifyingTotal += 1

    skipCount = math.max(qualifyingTotal - maxCount, 0)
    seen = 0
    if countNodes > 0
        for i = 0 to countNodes - 1
            if qualifies.get(i)
                seen += 1
                if seen > skipCount
                    if not canDrawLine() or not canDrawLabel()
                        break
                    node = nodesRef.get(i)
                    lineColor = colorPerIndex.get(i)
                    int totalDrawn1 = qualifyingTotal - skipCount
                    float ageMult1 = calcNodeAgeMult(totalDrawn1 - seen)
                    moveSizeLog       = math.abs(math.log(node.highNode) - math.log(node.lowPreNode))
                    correctionSizeLog = math.abs(math.log(node.highNode) - math.log(node.lowCorrection))

                    if showDouble and targetWeightSingleDouble > 0
                        targetDoublePrice = swUptrendType ? math.exp(math.log(node.highNode) + moveSizeLog) : math.exp(math.log(node.highNode) - moveSizeLog)

                        bool shouldDelete = shouldDeleteHitTarget(targetDoublePrice, node.indexNode, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            dFirst  = chart.point.from_index(node.indexNode, targetDoublePrice)
                            dSecond = chart.point.from_index(bar_index + gapBars, targetDoublePrice)
                            trackLine(line.new(dFirst, dSecond, color = color.new(lineColor, lineTransparency), width = doubleWidth, style = lnStyleDouble))
                            midX = (node.indexNode + bar_index + gapBars) / 2
                            dLbl = label.new(x = midX, y = targetDoublePrice, text = trendPrefix + "Double 1", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize))
                            trackLabel(dLbl)
                            string doubleKey = "Node1_Double_" + str.tostring(node.indexNode) + "_" + str.tostring(targetDoublePrice)
                            registerTarget(targetDoublePrice, bar_index + gapBars, lineColor, targetWeightSingleDouble, swUptrendType, ageMult1, node.indexNode, doubleKey)
                            registerVisibleDensity(targetDoublePrice, bar_index + gapBars, swUptrendType)

                    if showMin and targetWeightSingleMin > 0
                        targetMinPrice = swUptrendType ? math.exp(math.log(node.lowCorrection) + moveSizeLog) : math.exp(math.log(node.lowCorrection) - moveSizeLog)

                        bool shouldDelete = shouldDeleteHitTarget(targetMinPrice, node.indexCorrection, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            mFirst  = chart.point.from_index(node.indexNode, targetMinPrice)
                            mSecond = chart.point.from_index(bar_index + gapBars, targetMinPrice)
                            trackLine(line.new(mFirst, mSecond, color = color.new(lineColor, lineTransparency), width = minWidth, style = lnStyleMin))
                            midX = (node.indexNode + bar_index + gapBars) / 2
                            mLbl = label.new(x = midX, y = targetMinPrice, text = trendPrefix + "Min 1", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize))
                            trackLabel(mLbl)
                            string minKey = "Node1_Min_" + str.tostring(node.indexNode) + "_" + str.tostring(targetMinPrice)
                            registerTarget(targetMinPrice, bar_index + gapBars, lineColor, targetWeightSingleMin, swUptrendType, ageMult1, node.indexNode, minKey)
                            registerVisibleDensity(targetMinPrice, bar_index + gapBars, swUptrendType)

                    if showCorrection and targetWeightSingleCorrection > 0
                        targetCorrectionPrice = swUptrendType ? math.exp(math.log(node.highNode) + correctionSizeLog) : math.exp(math.log(node.highNode) - correctionSizeLog)

                        bool shouldDelete = shouldDeleteHitTarget(targetCorrectionPrice, node.indexNode, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            cFirst  = chart.point.from_index(node.indexNode, targetCorrectionPrice)
                            cSecond = chart.point.from_index(bar_index + gapBars, targetCorrectionPrice)
                            trackLine(line.new(cFirst, cSecond, color = color.new(lineColor, lineTransparency), width = correctionWidth, style = lnStyleCorrection))
                            midX = (node.indexNode + bar_index + gapBars) / 2
                            cLbl = label.new(x = midX, y = targetCorrectionPrice, text = trendPrefix + "Correction 1", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize))
                            trackLabel(cLbl)
                            string corrKey = "Node1_Corr_" + str.tostring(node.indexNode) + "_" + str.tostring(targetCorrectionPrice)
                            registerTarget(targetCorrectionPrice, bar_index + gapBars, lineColor, targetWeightSingleCorrection, swUptrendType, ageMult1, node.indexNode, corrKey)
                            registerVisibleDensity(targetCorrectionPrice, bar_index + gapBars, swUptrendType)

// ================================================================================================
// تارگت‌های زوج نود ۱ و ۲ مرتبط به هم (Node1+Node2 Pair Targets)
// ================================================================================================
method drawingPairTargetsNode12(series NDS this, bool swUptrendType, bool showMin, bool showMax, bool showDouble, bool showCorrection, int minWidth, int maxWidth, int doubleWidth, int correctionWidth, string minStyle, string maxStyle, string doubleStyle, string correctionStyle, int maxCount, int gapBars, bool deleteHit, int hitGraceBars, int lineTransparency) =>
    array<Node> nodesRef = swUptrendType ? this.nodesUp : this.nodesDown
    trendPrefix = swUptrendType ? "H " : "L "
    countNodes = nodesRef.size()
    lnStyleMin    = minStyle    == 'Solid' ? line.style_solid : minStyle    == 'Dashed' ? line.style_dashed : line.style_dotted
    lnStyleMax    = maxStyle    == 'Solid' ? line.style_solid : maxStyle    == 'Dashed' ? line.style_dashed : line.style_dotted
    lnStyleDouble = doubleStyle == 'Solid' ? line.style_solid : doubleStyle == 'Dashed' ? line.style_dashed : line.style_dotted
    lnStyleCorrection = correctionStyle == 'Solid' ? line.style_solid : correctionStyle == 'Dashed' ? line.style_dashed : line.style_dotted

    colorPerIndex = this.computeNodeColors(nodesRef)

    array<bool> isPairStart = array.new<bool>(countNodes)
    pairTotal = 0
    if countNodes > 1
        for i = 0 to countNodes - 2
            node1c = nodesRef.get(i)
            node2c = nodesRef.get(i+1)
            valid  = node1c.numberNode == 1 and node2c.numberNode == 2
            isPairStart.set(i, valid)
            if valid
                pairTotal += 1

    skipCount = math.max(pairTotal - maxCount, 0)
    seen = 0
    if countNodes > 1
        for i = 0 to countNodes - 2
            if isPairStart.get(i)
                seen += 1
                if seen > skipCount
                    if not canDrawLine() or not canDrawLabel()
                        break
                    node1 = nodesRef.get(i)
                    node2 = nodesRef.get(i+1)
                    lineColor = colorPerIndex.get(i)
                    int totalDrawnPair = pairTotal - skipCount
                    float ageMultPair = calcNodeAgeMult(totalDrawnPair - seen)
                    totalMoveLog = math.abs(math.log(node2.highNode) - math.log(node1.lowPreNode))

                    if showMin and targetWeightPairMin > 0
                        minPrice = swUptrendType ? math.exp(math.log(node1.lowCorrection) + totalMoveLog) : math.exp(math.log(node1.lowCorrection) - totalMoveLog)

                        bool shouldDelete = shouldDeleteHitTarget(minPrice, node1.indexCorrection, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            f1 = chart.point.from_index(node1.indexNode, minPrice)
                            s1 = chart.point.from_index(bar_index + gapBars, minPrice)
                            trackLine(line.new(f1, s1, color = color.new(lineColor, lineTransparency), width = minWidth, style = lnStyleMin))
                            midX = (node1.indexNode + bar_index + gapBars) / 2
                            trackLabel(label.new(x = midX, y = minPrice, text = trendPrefix + "Min 12", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize)))
                            string minKey = "Pair12_Min_" + str.tostring(node1.indexNode) + "_" + str.tostring(node2.indexNode) + "_" + str.tostring(minPrice)
                            registerTarget(minPrice, bar_index + gapBars, lineColor, targetWeightPairMin, swUptrendType, ageMultPair, node1.indexNode, minKey)
                            registerVisibleDensity(minPrice, bar_index + gapBars, swUptrendType)

                    if showMax and targetWeightPairMax > 0
                        maxPrice = swUptrendType ? math.exp(math.log(node2.lowCorrection) + totalMoveLog) : math.exp(math.log(node2.lowCorrection) - totalMoveLog)

                        bool shouldDelete = shouldDeleteHitTarget(maxPrice, node2.indexCorrection, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            f2 = chart.point.from_index(node2.indexNode, maxPrice)
                            s2 = chart.point.from_index(bar_index + gapBars, maxPrice)
                            trackLine(line.new(f2, s2, color = color.new(lineColor, lineTransparency), width = maxWidth, style = lnStyleMax))
                            midX = (node2.indexNode + bar_index + gapBars) / 2
                            trackLabel(label.new(x = midX, y = maxPrice, text = trendPrefix + "Max 12", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize)))
                            string maxKey = "Pair12_Max_" + str.tostring(node1.indexNode) + "_" + str.tostring(node2.indexNode) + "_" + str.tostring(maxPrice)
                            registerTarget(maxPrice, bar_index + gapBars, lineColor, targetWeightPairMax, swUptrendType, ageMultPair, node2.indexNode, maxKey)
                            registerVisibleDensity(maxPrice, bar_index + gapBars, swUptrendType)

                    if showDouble and targetWeightPairDouble > 0
                        dblPrice = swUptrendType ? math.exp(math.log(node2.highNode) + totalMoveLog) : math.exp(math.log(node2.highNode) - totalMoveLog)

                        bool shouldDelete = shouldDeleteHitTarget(dblPrice, node2.indexNode, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            f3 = chart.point.from_index(node2.indexNode, dblPrice)
                            s3 = chart.point.from_index(bar_index + gapBars, dblPrice)
                            trackLine(line.new(f3, s3, color = color.new(lineColor, lineTransparency), width = doubleWidth, style = lnStyleDouble))
                            midX = (node2.indexNode + bar_index + gapBars) / 2
                            trackLabel(label.new(x = midX, y = dblPrice, text = trendPrefix + "Double 12", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize)))
                            string dblKey = "Pair12_Double_" + str.tostring(node1.indexNode) + "_" + str.tostring(node2.indexNode) + "_" + str.tostring(dblPrice)
                            registerTarget(dblPrice, bar_index + gapBars, lineColor, targetWeightPairDouble, swUptrendType, ageMultPair, node2.indexNode, dblKey)
                            registerVisibleDensity(dblPrice, bar_index + gapBars, swUptrendType)

                    if showCorrection and targetWeightPairCorrection > 0
                        correctionSizeLog2 = math.abs(math.log(node2.highNode) - math.log(node2.lowCorrection))
                        corrPrice12 = swUptrendType ? math.exp(math.log(node2.highNode) + correctionSizeLog2) : math.exp(math.log(node2.highNode) - correctionSizeLog2)

                        bool shouldDelete = shouldDeleteHitTarget(corrPrice12, node2.indexNode, swUptrendType, deleteHit, hitGraceBars)

                        if not shouldDelete
                            f4 = chart.point.from_index(node2.indexNode, corrPrice12)
                            s4 = chart.point.from_index(bar_index + gapBars, corrPrice12)
                            trackLine(line.new(f4, s4, color = color.new(lineColor, lineTransparency), width = correctionWidth, style = lnStyleCorrection))
                            midX = (node2.indexNode + bar_index + gapBars) / 2
                            trackLabel(label.new(x = midX, y = corrPrice12, text = trendPrefix + "Correction 2", style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize)))
                            string corrKey = "Pair12_Corr_" + str.tostring(node1.indexNode) + "_" + str.tostring(node2.indexNode) + "_" + str.tostring(corrPrice12)
                            registerTarget(corrPrice12, bar_index + gapBars, lineColor, targetWeightPairCorrection, swUptrendType, ageMultPair, node2.indexNode, corrKey)
                            registerVisibleDensity(corrPrice12, bar_index + gapBars, swUptrendType)

//#endregion

// ================================================================================================
// بخش ۵-ج: تارگت‌های قیمت رند (Round Number / Psychological Levels)
// ================================================================================================
//#region ———————————————————— ROUND NUMBER TARGETS

drawRoundNumberTargets(float basePrice, float weightVal, bool isUp, int gapBars, bool deleteHit, int hitGraceBars, int lineWidth, string lineStyleStr, int lineTransparency, color lineColor, float minVisiblePrice, int historyBars, bool drawVisual) =>
    if basePrice > 0 and weightVal > 0
        int lookback = math.min(historyBars, bar_index)
        float chartLow  = lookback > 0 ? ta.lowest(low, lookback + 1) : low[0]
        float chartHigh = lookback > 0 ? ta.highest(high, lookback + 1) : high[0]
        float effectiveMin = minVisiblePrice > 0 ? math.max(minVisiblePrice, chartLow) : chartLow
        float effectiveMax = chartHigh

        int startMult = math.floor(effectiveMin / basePrice)
        int endMult   = math.ceil(effectiveMax / basePrice)
        if startMult < 1
            startMult := 1

        lnStyle = lineStyleStr == 'Solid' ? line.style_solid : lineStyleStr == 'Dashed' ? line.style_dashed : line.style_dotted
        trendPrefix = isUp ? "H " : "L "
        // مثل بقیه تارگت‌ها: خط از کندل جاری به جلو (نه به تاریخ گذشته)
        int lineStartIdx = bar_index
        int lineEndIdx = bar_index + gapBars
        int midX = int((lineStartIdx + lineEndIdx) / 2)

        if endMult >= startMult
            int totalLevels = endMult - startMult + 1
            if totalLevels > MAX_ROUND_LEVELS
                int mid = int((startMult + endMult) / 2)
                int half = int(MAX_ROUND_LEVELS / 2)
                startMult := math.max(1, mid - half)
                endMult := startMult + MAX_ROUND_LEVELS - 1
            for mult = startMult to endMult
                if not canDrawLine() or not canDrawLabel()
                    break
                float roundPrice = basePrice * mult
                int roundStartIdx = math.max(bar_index - lookback, 0)
                bool shouldDelete = shouldDeleteHitTarget(roundPrice, roundStartIdx, isUp, deleteHit, hitGraceBars)

                if not shouldDelete
                    if drawVisual
                        rFirst  = chart.point.from_index(lineStartIdx, roundPrice)
                        rSecond = chart.point.from_index(lineEndIdx, roundPrice)
                        trackLine(line.new(rFirst, rSecond, color = color.new(lineColor, lineTransparency), width = lineWidth, style = lnStyle))
                        rLbl = label.new(x = midX, y = roundPrice, text = trendPrefix + "RN " + str.tostring(roundPrice, "#.####"), style = label.style_label_center, color = color.new(color.black, 100), textcolor = lineColor, size = textSizeFromString(targetLabelSize))
                        trackLabel(rLbl)
                    string roundKey = "Round_" + str.tostring(roundPrice) + "_" + str.tostring(isUp)
                    registerTarget(roundPrice, lineEndIdx, lineColor, weightVal, isUp, 1.0, lineStartIdx, roundKey)

//#endregion

// ================================================================================================
// بخش ۵-ب: تشخیص و هایلایت نواحی هم‌پوشانِ تارگت‌ها (Confluence Zones)
// ================================================================================================
//#region ———————————————————— CONFLUENCE ZONES

drawConfluenceZones(float tolerancePercent, float maxWidthPrice, int minTargetsInZone, int topZonesCount, int zoneLength, color zoneColor, color topBgColor, int historyBars, int labelOffsetBars, string labelSizeTop, string labelSizeOther) =>
    n = canDrawBox() ? math.min(g_targetPrices.size(), math.min(g_targetXEnd.size(), g_targetWeights.size())) : 0
    if n > 1
        used = array.new<bool>(n, false)

        array<float> zMinP  = array.new<float>()
        array<float> zMaxP  = array.new<float>()
        array<int>   zMaxX  = array.new<int>()
        array<float> zScore = array.new<float>()
        array<int>   zCount = array.new<int>()
        array<bool>  zIsUp  = array.new<bool>()

        for i = 0 to n - 1
            if i < used.size() and not used.get(i)
                array<int> clusterIdx = array.new<int>()
                clusterIdx.push(i)
                pi = g_targetPrices.get(i)
                trendI = g_targetTrend.get(i)
                runMin = pi
                runMax = pi
                // نکته مهم Pine: وقتی i == n-1، "i+1 to n-1" جهتش برعکس می‌شود و ایندکس n
                // (خارج از محدوده) خوانده می‌شود؛ پس صریحاً گارد می‌کنیم
                if i < n - 1
                    for j = i + 1 to n - 1
                        if j < used.size() and not used.get(j)
                            pj = g_targetPrices.get(j)
                            trendJ = g_targetTrend.get(j)
                            refPrice = math.max(math.abs(pi), 0.0000001)
                            diffPct = math.abs(pi - pj) / refPrice * 100
                            candidateMin = math.min(runMin, pj)
                            candidateMax = math.max(runMax, pj)
                            if trendJ == trendI and diffPct <= tolerancePercent and (candidateMax - candidateMin) <= maxWidthPrice
                                clusterIdx.push(j)
                                runMin := candidateMin
                                runMax := candidateMax
                if clusterIdx.size() >= minTargetsInZone
                    minP = 999999999.0
                    maxP = 0.0
                    maxX = 0
                    score = 0.0
                    for k = 0 to clusterIdx.size() - 1
                        idx = clusterIdx.get(k)
                        if idx < used.size()
                            used.set(idx, true)
                        p = g_targetPrices.get(idx)
                        minP  := math.min(minP, p)
                        maxP  := math.max(maxP, p)
                        maxX  := math.max(maxX, g_targetXEnd.get(idx))
                        score += g_targetWeights.get(idx)
                    if (maxP - minP) > maxWidthPrice
                        midP = (maxP + minP) / 2
                        maxP := midP + maxWidthPrice / 2
                        minP := midP - maxWidthPrice / 2
                    if maxP == minP
                        pad = math.min(maxP * (tolerancePercent / 100) * 0.5, maxWidthPrice * 0.5)
                        maxP := maxP + pad
                        minP := minP - pad
                    zMinP.push(minP)
                    zMaxP.push(maxP)
                    zMaxX.push(maxX)
                    zScore.push(score)
                    zCount.push(clusterIdx.size())
                    zIsUp.push(trendI)

        zoneTotal = zScore.size()
        if zoneTotal > 0
            zoneUsed = array.new<bool>(zoneTotal, false)
            for pickUp = 1 to topZonesCount
                bestIdx = -1
                bestScore = -1.0
                for z = 0 to zoneTotal - 1
                    if z < zoneUsed.size() and not zoneUsed.get(z) and zIsUp.get(z)
                        if zScore.get(z) > bestScore
                            bestScore := zScore.get(z)
                            bestIdx   := z
                if bestIdx < 0
                    break
                zoneUsed.set(bestIdx, true)
                minP  = zMinP.get(bestIdx)
                maxP  = zMaxP.get(bestIdx)
                maxX  = zMaxX.get(bestIdx)
                score = zScore.get(bestIdx)
                bool isTop = pickUp == 1
                color useBg = isTop ? topBgColor : zoneColor
                zoneLeft = math.max(maxX - zoneLength, bar_index - historyBars)
                b = box.new(left = zoneLeft, top = maxP, right = maxX, bottom = minP, bgcolor = useBg, border_color = color.new(color.black, 100), border_width = 0, border_style = line.style_solid)
                trackBox(b)
                color lblColor = isTop ? topBgColor : zoneColor
                string starPrefix = isTop ? "⭐ " : ""
                zLbl = label.new(x = zoneLeft - labelOffsetBars, y = maxP, text = starPrefix + str.tostring(score, "#"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(lblColor, 0), size = isTop ? textSizeFromString(labelSizeTop) : textSizeFromString(labelSizeOther))
                trackLabel(zLbl)

            for pickDn = 1 to topZonesCount
                bestIdx = -1
                bestScore = -1.0
                for z = 0 to zoneTotal - 1
                    if z < zoneUsed.size() and not zoneUsed.get(z) and not zIsUp.get(z)
                        if zScore.get(z) > bestScore
                            bestScore := zScore.get(z)
                            bestIdx   := z
                if bestIdx < 0
                    break
                zoneUsed.set(bestIdx, true)
                minP  = zMinP.get(bestIdx)
                maxP  = zMaxP.get(bestIdx)
                maxX  = zMaxX.get(bestIdx)
                score = zScore.get(bestIdx)
                bool isTop = pickDn == 1
                color useBg = isTop ? topBgColor : zoneColor
                zoneLeft = math.max(maxX - zoneLength, bar_index - historyBars)
                b = box.new(left = zoneLeft, top = maxP, right = maxX, bottom = minP, bgcolor = useBg, border_color = color.new(color.black, 100), border_width = 0, border_style = line.style_solid)
                trackBox(b)
                color lblColor = isTop ? topBgColor : zoneColor
                string starPrefix = isTop ? "⭐ " : ""
                zLbl = label.new(x = zoneLeft - labelOffsetBars, y = maxP, text = starPrefix + str.tostring(score, "#"), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(lblColor, 0), size = isTop ? textSizeFromString(labelSizeTop) : textSizeFromString(labelSizeOther))
                trackLabel(zLbl)

//#endregion
// ================================================================================================
//#region ———————————————————— INIT & ENGINE

method initFirst(series NDS this) =>
    if this.swFirst == true
        this.initColor()
        this.swFirst := false

method calc(series NDS this) =>
    min = last_bar_index - this.settings.startPoint
    max = last_bar_index - this.settings.endPoint + 1

    if bar_index > min and bar_index <= max and bar_index > 1
        this.initFirst()
        this.CalcNode_UpTrend()
        this.CalcNode_DownTrend()

newInstance(Settings settings) =>
    NDS result = NDS.new(settings, array.new<Node>(), array.new<Node>(), array.new<Node>(), colors = array.new<Color>())
    result

//#endregion

// ================================================================================================
// بخش ۷: ورودی‌های کاربر
// ================================================================================================
//#region ———————————————————— INPUTS

var GRP2 = "Nodal Calculation Settings"
startPointInput = input.int(5000, 'Starting Point Candles', minval = 1 , maxval = 5000 , inline = "12", group = GRP2)
endPointInput   = input.int(0, 'End Point (Final)', group = GRP2, minval = 0 , maxval = 5000)

var GRP1 = "Strategy Config"
swCalcLogarithm = input.bool(true, 'Calc Nodes with Logarithm' , group = GRP1, tooltip = 'فقط روی محاسبه‌ی خودِ نودها و سیمتری اثر دارد. تارگت‌ها همیشه بر حسب لگاریتم محاسبه می‌شوند.')
nodeDisplayMode = input.string('Starred', 'Node Display Mode', options = ['Starred', 'Starless'], group = GRP1, tooltip = 'ستاره‌دار: فقط نودهای 1* و **1** با خطوط و تارگت‌ها. بدون ستاره: فقط نودهای معمولی 1 و 2.')
verticalGapInput = input.int(0, 'Vertical Gap: Symmetry vs No-Symmetry (lines)', minval = 0, maxval = 15, group = GRP1, tooltip = "تعداد خط خالی فاصله عمودی بین عدد ستاره‌دار (سیمتری) و عدد بدون ستاره")
showRegularStarredNodes = input.bool(true, 'Show Regular Starred Nodes ( * )', group = GRP1)
showDoubleStarNodesInput = input.bool(true, 'Show Double-Star Nodes ( ** )', group = GRP1)

var GRP5 = "Node Targets — Master Switches"
enableSingleNode1Targets = input.bool(true, 'Show Node 1 Targets (Double + Min + Correction)', group = GRP5)
enablePairNode12Targets  = input.bool(true, 'Show Node 1+2 Pair Targets (Min + Max + Double + Correction)', group = GRP5)
showTargetNode1Up   = input.bool(true, 'Apply to Up Trend', inline = "trend1", group = GRP5)
showTargetNode1Down = input.bool(true, 'Apply to Down Trend', inline = "trend1", group = GRP5)
targetLabelGapBars = input.int(200, 'Line-to-Label Gap (bars into future)', minval = 3, maxval = 490, group = GRP5, tooltip = 'تردینگ‌ویو اجازه رسم بیش از ۵۰۰ کندل جلوتر را نمی‌دهد؛ این مقدار حداکثر ۴۹۰ است تا جای کافی برای جابجایی نوشته‌های متداخل باقی بماند')
deleteHitTargets = input.bool(true, 'Delete Hit Targets (auto-remove when price reaches target)', group = GRP5)

hitGraceBarsInput = input.int(2, 'Hit Target Grace Period (bars)', minval = 0, maxval = 500, group = GRP5, tooltip = 'تارگت‌هایی که قیمت به آنها رسیده باشد، حداقل به مدت این تعداد کندل دیگر نمایش داده می‌شوند و سپس حذف می‌شوند')
targetLineTransparency = input.int(60, 'Target Lines Transparency (0=Opaque, 100=Invisible)', minval = 0, maxval = 100, group = GRP5)

var GRP8 = "Target Confluence Zones (Important Areas)"
enableConfluenceZones = input.bool(true, 'Highlight Confluence Zones', group = GRP8)
confluenceTolerancePct = input.float(0.02, 'Zone Tolerance (%)', minval = 0.01, maxval = 10.0, step = 0.05, group = GRP8)
confluenceMinTargets = input.int(2, 'Minimum Targets to Form a Zone', minval = 2, maxval = 10, group = GRP8)
confluenceATRLength = input.int(10, 'Zone Width ATR Period', minval = 1, maxval = 200, group = GRP8)
confluenceATRMultiplier = input.float(1.0, 'Zone Width ATR Multiplier', minval = 0.1, step = 0.1, group = GRP8)
confluenceTopZonesCount = input.int(3, 'Show Top N Zones by Value', minval = 1, maxval = 50, group = GRP8)
confluenceZoneLength = input.int(50, 'Zone Length (bars)', minval = 5, maxval = 5000, group = GRP8)
confluenceLabelOffsetBars = input.int(-100, 'Zone Score Label Distance (bars, +left/-right)', minval = -500, maxval = 500, group = GRP8)
confluenceLabelSizeTop   = input.string('Large', 'Zone Score Label Size (Top Zone)', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP8)
confluenceLabelSizeOther = input.string('Normal', 'Zone Score Label Size (Other Zones)', options = ['Auto', 'Huge', 'Large', 'Normal', 'Small', 'Tiny'], group = GRP8)
confluenceZoneColor = input.color(color.new(color.yellow, 82), 'Zone Background Color (Others)', group = GRP8)
confluenceTopBgColor = input.color(color.new(color.red, 70), 'Top Zone Background Color (Highest Score)', group = GRP8)


var GRP10 = "Round Number Targets (Psychological Levels)"
enableRoundTargets      = input.bool(false, 'Show Round Number Targets', group = GRP10)
roundBasePrice          = input.float(10.0, 'Round Number Base Price', minval = 0.0001, step = 0.1, group = GRP10)
roundApplyUp            = input.bool(true, 'Apply Round Numbers to Up Trend', inline = 'rnd1', group = GRP10)
roundApplyDown          = input.bool(true, 'Apply Round Numbers to Down Trend', inline = 'rnd1', group = GRP10)
// === تارگت‌های رند هرگز با رسیدن قیمت حذف نمی‌شوند و امتیازشان همیشه باقی می‌ماند ===
roundDeleteHit          = false
roundHitGraceBars       = 0
roundLineWidth          = input.int(1, 'Round Number Line Width', minval = 1, maxval = 4, group = GRP10)
roundLineStyle          = input.string('Dashed', 'Round Number Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP10)
