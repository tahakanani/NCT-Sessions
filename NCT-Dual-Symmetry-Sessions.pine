// === تغییر ۲ و ۴: تنظیمات تارگت سشن (بدون وزن — وزن‌ها به GRP9 منتقل شدند) ===
var GRP_SESTGT = "Session Targets"
enableSessionTargets = input.bool(true, 'Show Session High/Low/Midline as Targets', group = GRP_SESTGT, tooltip = 'سقف، کف و میدلاین هر سشن به‌عنوان تارگت رسم و در سیستم امتیازدهی لحاظ می‌شود (فقط سشن‌های امروز امتیاز دارند)')
applySessionHigh = input.bool(true, 'Include Session High (Top)', inline = 'sestgt1', group = GRP_SESTGT)
