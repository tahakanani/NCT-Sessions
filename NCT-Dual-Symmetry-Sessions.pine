applySessionMid  = input.bool(true, 'Include Session Midline', inline = 'sestgt1', group = GRP_SESTGT)
sessionTargetLineWidth  = input.int(1, 'Session Target Line Width', minval = 1, maxval = 4, group = GRP_SESTGT)
sessionTargetLineStyle  = input.string('Dotted', 'Session Target Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP_SESTGT)
