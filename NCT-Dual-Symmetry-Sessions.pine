tokyoTargetWeightHigh         = input.float(120, 'Weight: Tokyo Session High', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی سقف سشن توکیو')
tokyoTargetWeightLow          = input.float(120, 'Weight: Tokyo Session Low', minval = 0, group = GRP9, tooltip = 'ارزش امتیازی کف سشن توکیو')
