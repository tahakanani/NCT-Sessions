//@version=6
indicator('Volume Profile, Pivot Anchored · POC / VAH / VAL', 'ᴘᴀVP', true, max_bars_back = 5000, max_boxes_count = 500)

// ---------------------------------------------------------------------------------------------- //
// Inputs --------------------------------------------------------------------------------------- //

group_vp = 'Pivot Points Volume Profile'

pvtLength = input.int(20, 'Pivot Points Left / Right Length', minval = 1, group = group_vp)

isValueArea = input.float(68, 'Value Area Volume %', minval = 0, maxval = 100, group = group_vp) / 100

pointOfControl = input.bool(true, 'Point of Control (PoC)', inline = 'PoC', group = group_vp)
pocColor       = input.color(color.new(#ff0000, 0), '', inline = 'PoC', group = group_vp)

pocExtend = input.string('None', 'Extend Point of Control (PoC)', options = ['Until Last Bar', 'Until Bar Cross', 'Until Bar Touch', 'None'], group = group_vp)

valueAreaHigh = input.bool(true, 'Value Area High (VAH)', inline = 'VAH', group = group_vp)
vahColor      = input.color(color.new(#2962ff, 0), '', inline = 'VAH', group = group_vp)

valueAreaLow = input.bool(true, 'Value Area Low (VAL)', inline = 'VAL', group = group_vp)
valColor     = input.color(color.new(#2962ff, 0), '', inline = 'VAL', group = group_vp)

profileLevels = input.int(25, 'Number of Rows', minval = 10, maxval = 100, step = 1, group = group_vp)

// ---------------------------------------------------------------------------------------------- //
// Helpers -------------------------------------------------------------------------------------- //

f_drawOnlyLineX(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width) =>
    line.new(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width)

f_drawLineX(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width) =>
    var id = line.new(_x1, _y1, _x2, _y2, _xloc, _extend, _color, _style, _width)
    line.set_xy1(id, _x1, _y1)
    line.set_xy2(id, _x2, _y2)
    line.set_color(id, _color)
    id

f_getHighLow(_len, _calc, _offset) =>
    if _calc
        htf_l = low[_offset]
        htf_h = high[_offset]
        vol = 0.

        for x = 0 to _len - 1 by 1
            htf_l := math.min(low[_offset + x], htf_l)
            htf_h := math.max(high[_offset + x], htf_h)
            vol := vol + volume[_offset + x]

        htf_l := math.min(low[_offset + _len], htf_l)
        htf_h := math.max(high[_offset + _len], htf_h)

        [htf_h, htf_l, vol]

f_checkBreaches(arrayOfBoxes, extend) =>
    int qtyOfBoxes = array.size(arrayOfBoxes)
    for boxNo = 0 to qtyOfBoxes > 0 ? qtyOfBoxes - 1 : na by 1
        if boxNo < array.size(arrayOfBoxes)
            box currentBox = array.get(arrayOfBoxes, boxNo)
            float boxMidLevel = math.avg(box.get_bottom(currentBox), box.get_top(currentBox))
            bool boxWasCrossed = math.sign(close[1] - boxMidLevel) != math.sign(close - boxMidLevel)
            bool boxWasTouched = math.sign(close[1] - boxMidLevel) != math.sign(low - boxMidLevel) or math.sign(close[1] - boxMidLevel) != math.sign(high - boxMidLevel)

            if boxWasCrossed and extend == 'Until Bar Cross'
                array.remove(arrayOfBoxes, boxNo)
                int(na)
            else if boxWasTouched and extend == 'Until Bar Touch'
                array.remove(arrayOfBoxes, boxNo)
                int(na)
            else
                box.set_right(currentBox, bar_index)
                int(na)

f_fillVolumeProfile(_len, _offset, _priceLowest, _priceStep, _volumeStorage) =>
    array.fill(_volumeStorage, 0.)
    for barIndexx = 1 to _len by 1
        level = 0
        barIndex = barIndexx + _offset
        for priceLevel = _priceLowest to _priceLowest + _priceStep * profileLevels by _priceStep
            if high[barIndex] >= priceLevel and low[barIndex] < priceLevel + _priceStep
                barRange = high[barIndex] - low[barIndex]
                array.set(_volumeStorage, level, array.get(_volumeStorage, level) + nz(volume[barIndex]) * (barRange == 0 ? 1 : _priceStep / barRange))
            level += 1

f_calcValueArea(_volumeStorage, _pocLevel) =>
    totalVolumeTraded = array.sum(_volumeStorage) * isValueArea
    valueArea = array.get(_volumeStorage, _pocLevel)
    levelAbove = _pocLevel
    levelBelow = _pocLevel

    while valueArea < totalVolumeTraded
        if levelBelow == 0 and levelAbove == profileLevels - 1
            break

        volumeAbove = levelAbove < profileLevels - 1 ? array.get(_volumeStorage, levelAbove + 1) : 0.
        volumeBelow = levelBelow > 0 ? array.get(_volumeStorage, levelBelow - 1) : 0.

        if volumeBelow == 0 and volumeAbove == 0
            break

        if volumeAbove >= volumeBelow
            valueArea += volumeAbove
            levelAbove += 1
        else
            valueArea += volumeBelow
            levelBelow -= 1

    [levelAbove, levelBelow]

// ---------------------------------------------------------------------------------------------- //
// State ---------------------------------------------------------------------------------------- //

volumeStorageT = array.new_float(profileLevels + 1, 0.)
var a_poc = array.new_box()
var x1 = 0
var x2 = 0
var levelAbovePoc = 0
var levelBelowPoc = 0
var pocLevel = 0

// ---------------------------------------------------------------------------------------------- //
// Pivot-anchored profiles ---------------------------------------------------------------------- //

pvtHigh = ta.pivothigh(pvtLength, pvtLength)
pvtLow = ta.pivotlow(pvtLength, pvtLength)
proceed = not na(pvtHigh) or not na(pvtLow)

if proceed
    x1 := x2
    x2 := bar_index

profileLength = x2 - x1
[priceHighest, priceLowest, _] = f_getHighLow(profileLength, proceed, pvtLength)
priceStep = (priceHighest - priceLowest) / profileLevels
nzVolume = nz(volume)

if proceed and nzVolume > 0 and priceStep > 0 and bar_index > profileLength and profileLength > 0
    f_fillVolumeProfile(profileLength, pvtLength, priceLowest, priceStep, volumeStorageT)

    pocLevel := array.indexof(volumeStorageT, array.max(volumeStorageT))
    [levelAbove, levelBelow] = f_calcValueArea(volumeStorageT, pocLevel)
    levelAbovePoc := levelAbove
    levelBelowPoc := levelBelow

    if pointOfControl
        array.push(a_poc, box.new(bar_index[pvtLength] - profileLength, priceLowest + (pocLevel + .40) * priceStep, bar_index[pvtLength], priceLowest + (pocLevel + .60) * priceStep, pocColor, bgcolor = pocColor))

    if valueAreaHigh
        f_drawOnlyLineX(bar_index[pvtLength] - profileLength, priceLowest + (levelAbovePoc + 1.00) * priceStep, bar_index[pvtLength], priceLowest + (levelAbovePoc + 1.00) * priceStep, xloc.bar_index, extend.none, vahColor, line.style_solid, 2)

    if valueAreaLow
        f_drawOnlyLineX(bar_index[pvtLength] - profileLength, priceLowest + (levelBelowPoc + 0.00) * priceStep, bar_index[pvtLength], priceLowest + (levelBelowPoc + 0.00) * priceStep, xloc.bar_index, extend.none, valColor, line.style_solid, 2)

if pointOfControl and pocExtend != 'None'
    f_checkBreaches(a_poc, pocExtend)

// ---------------------------------------------------------------------------------------------- //
// Developing profile (last segment) ------------------------------------------------------------ //

var a_profileD = array.new_box()
devLength = barstate.islast ? last_bar_index - x2 + pvtLength : 1
devHigh = ta.highest(high, devLength > 0 ? devLength + 1 : 1)
devLow = ta.lowest(low, devLength > 0 ? devLength + 1 : 1)
devStep = (devHigh - devLow) / profileLevels

if barstate.islast and nzVolume > 0 and devLength > 0 and devStep > 0
    if array.size(a_profileD) > 0
        for i = 0 to array.size(a_profileD) - 1 by 1
            box.delete(array.shift(a_profileD))

    f_fillVolumeProfile(devLength, 0, devLow, devStep, volumeStorageT)

    pocLevel := array.indexof(volumeStorageT, array.max(volumeStorageT))
    [levelAbove, levelBelow] = f_calcValueArea(volumeStorageT, pocLevel)
    levelAbovePoc := levelAbove
    levelBelowPoc := levelBelow

    if pointOfControl
        array.push(a_profileD, box.new(bar_index - devLength, devLow + (pocLevel + .40) * devStep, bar_index, devLow + (pocLevel + .60) * devStep, pocColor, bgcolor = pocColor))

    f_drawLineX(bar_index - devLength, devLow + (levelAbovePoc + 1.00) * devStep, bar_index, devLow + (levelAbovePoc + 1.00) * devStep, xloc.bar_index, extend.none, valueAreaHigh ? vahColor : #00000000, line.style_solid, 2)
    f_drawLineX(bar_index - devLength, devLow + (levelBelowPoc + 0.00) * devStep, bar_index, devLow + (levelBelowPoc + 0.00) * devStep, xloc.bar_index, extend.none, valueAreaLow ? valColor : #00000000, line.style_solid, 2)
