//@version=6
indicator("SP2L (Spike – 2Leg – Level)", shorttitle = "SP2L", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ================================================================================================
// Inputs
// ================================================================================================

grpSpike = "Spike Filter | Movement"
minSpikeBars = input.int(3, "Minimum Spike Bars", minval = 2, maxval = 50, group = grpSpike, tooltip = "حداقل تعداد کندل برای اسپایک معتبر")
useMovePower = input.bool(false, "Movement Power", group = grpSpike)
movePowerLevel = input.float(0.8, "Movement Power Level", minval = 0.1, step = 0.1, group = grpSpike, tooltip = "آستانهٔ range اسپایک نسبت به ATR؛ بالاتر = فقط اسپایک‌های قوی")
atrLen = input.int(14, "ATR Length", minval = 1, group = grpSpike)
maxSpikeBars = input.int(80, "Max Spike Bars", minval = 3, maxval = 150, group = grpSpike)
allowInternalPb = input.bool(true, "Allow Internal Pullback", group = grpSpike, tooltip = "پولبک کم‌عمق وسط اسپایک را همان لگ حساب می‌کند")
maxOppBars = input.int(5, "Max Opposite Bars", minval = 1, maxval = 15, group = grpSpike, tooltip = "حداکثر کندل مخالف پشت‌سرهم که هنوز لگ را قطع نکند")
minDirRatio = input.float(0.40, "Min Directional Bar Ratio", minval = 0.3, maxval = 1.0, step = 0.05, group = grpSpike)

grpLeg = "Leg Detection (ZigZag)"
showLegs = input.bool(true, "Show Legs", group = grpLeg, tooltip = "یک لگ تا وقتی قیمت درصد مشخصی برنگردد ادامه دارد؛ پولبک کم‌عمق آن را قطع نمی‌کند")
reversalPct = input.float(25.0, "Reversal %", minval = 8.0, maxval = 70.0, step = 1.0, group = grpLeg, tooltip = "درصد برگشت از سقف/کف لگ برای بستن لگ. برای طلا 100R حدود 20 تا 30")
minLegAtr = input.float(0.5, "Min Leg Size × ATR", minval = 0.0, step = 0.1, group = grpLeg)
maxLegsKeep = input.int(25, "Max Legs On Chart", minval = 4, maxval = 80, group = grpLeg)
showL2Proj = input.bool(true, "Project L2 = L1", group = grpLeg)
showEntryMarks = input.bool(false, "Show Entry Triangles", group = grpLeg, tooltip = "مثلث‌های سبز/قرمز ورود HL؛ برای دیدن لگ‌ها خاموش بماند")

grpGap = "Spike Filter | Gap"
useGapFilter = input.bool(false, "Gap Filter", group = grpGap)
gapType = input.string("All Gaps", "Gap Type", options = ["All Gaps", "Significant", "Structural", "Major"], group = grpGap)
sigGapAtr = input.float(0.5, "Significant Gap × ATR", minval = 0.1, step = 0.1, group = grpGap)
majGapAtr = input.float(1.0, "Major Gap × ATR", minval = 0.1, step = 0.1, group = grpGap)

grpDoji = "Spike Filter | Doji"
dojiTolerance = input.bool(true, "Doji Tolerance", group = grpDoji, tooltip = "اجازهٔ دوجی داخل اسپایک")
maxDojiBody = input.float(0.15, "Max Doji Body Ratio", minval = 0.01, maxval = 0.5, step = 0.01, group = grpDoji)
maxDojiInSpike = input.float(0.25, "Max Doji in Spike Ratio", minval = 0.0, maxval = 1.0, step = 0.05, group = grpDoji)

grpTrend = "Trend Detection"
useTrend = input.bool(false, "Trend Detection", group = grpTrend)
trendDojiBody = input.float(0.15, "Max Doji Body Ratio", minval = 0.01, maxval = 0.5, step = 0.01, group = grpTrend)
trendLookback = input.int(20, "Candle Lookback", minval = 3, maxval = 100, group = grpTrend)
maxDojiInTrend = input.float(0.40, "Max Doji in Trend Ratio", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrend)

grpPos = "Position Management"
useSlThresh = input.bool(true, "Stop-Loss Threshold", group = grpPos)
slThresh = input.float(0.0, "Stop-Loss Threshold Value", minval = 0.0, step = 0.001, group = grpPos, tooltip = "فاصلهٔ اضافه به SL بر حسب قیمت")
rrRatio = input.float(2.0, "Risk-Reward Ratio", minval = 0.5, step = 0.1, group = grpPos, tooltip = "TP2 نسبت به ریسک؛ TP1 همیشه 1R است")
includeThreshInRR = input.bool(true, "Include SL Threshold in R:R", group = grpPos)
maxWaitBars = input.int(80, "Max Wait Bars After Spike", minval = 5, maxval = 500, group = grpPos)
showTpRr = input.bool(true, "Show R:R Take-Profits", group = grpPos)

grpDisp = "Display Settings"
displayMode = input.string("Setup", "Display Mode", options = ["Setup", "Signal"], group = grpDisp)
onlyLast = input.bool(true, "Only Display the Last Position", group = grpDisp)
bullCss = input.color(color.new(#089981, 0), "Bullish", group = grpDisp)
bearCss = input.color(color.new(#f23645, 0), "Bearish", group = grpDisp)
boxTransp = input.int(85, "Spike Box Transparency", minval = 50, maxval = 95, group = grpDisp)
lvlTransp = input.int(20, "Level Line Transparency", minval = 0, maxval = 80, group = grpDisp)

// ================================================================================================
// Types
// ================================================================================================

type Setup
    int dir = 0
    int phase = 0
    int startBar = 0
    int endBar = 0
    float origin = na
    float extreme = na
    float spikeSize = na
    float entry = na
    int entryBar = 0
    float sl = na
    float tpL2 = na
    float tp1 = na
    float tp2 = na
    array<float> lvlPx = na
    array<int> lvlBar = na
    array<bool> lvlUsed = na
    box bSpike = na
    array<line> lvlLines = na
    array<label> labels = na
    line lnEntry = na
    line lnSl = na
    line lnL2 = na
    line lnTp1 = na
    line lnTp2 = na

type ZzPt
    int bar = 0
    float px = na
    bool isHigh = false

type ZzLeg
    int dir = 0
    int x1 = 0
    int x2 = 0
    float y1 = na
    float y2 = na
    line ln = na
    label lb = na

var Setup cur = Setup.new()
var array<Setup> hist = array.new<Setup>()
var array<ZzPt> zzPts = array.new<ZzPt>()
var array<ZzLeg> zzLegs = array.new<ZzLeg>()
var line zzLive = na
var label zzLiveLbl = na
var line zzL2proj = na
var label zzL2lbl = na
var int zzDir = 0
var int zzStartBar = 0
var float zzStartPx = na
var int zzExtBar = 0
var float zzExtPx = na

// phase: 0 empty, 1 forming, 2 wait retest, 3 in trade, 4 closed

// ================================================================================================
// Helpers
// ================================================================================================

isDoji(int off, float bodyRatio) =>
    float rng = high[off] - low[off]
    rng <= 0 ? true : math.abs(close[off] - open[off]) / rng <= bodyRatio

windowHigh(int newest, int oldest) =>
    float m = high[newest]
    if oldest >= newest
        for i = newest to oldest
            m := math.max(m, high[i])
    m

windowLow(int newest, int oldest) =>
    float m = low[newest]
    if oldest >= newest
        for i = newest to oldest
            m := math.min(m, low[i])
    m

countRun(int dir, int fromOff, int maxBars, float bodyRatio, bool allowDoji) =>
    int n = 0
    int opp = 0
    int last = math.min(fromOff + maxBars - 1, bar_index)
    if last >= fromOff
        for i = fromOff to last
            bool d = isDoji(i, bodyRatio)
            bool up = close[i] > open[i]
            bool down = close[i] < open[i]
            bool dirOk = dir == 1 ? up : down
            bool contra = dir == 1 ? down : up
            if d
                if not allowDoji
                    break
                n += 1
                opp := 0
            else if dirOk
                n += 1
                opp := 0
            else if contra and allowInternalPb and opp < maxOppBars
                n += 1
                opp += 1
            else
                break
    n

trendOk() =>
    bool ok = true
    if useTrend
        int d = 0
        int n = math.min(trendLookback, bar_index + 1)
        if n > 0
            for i = 0 to n - 1
                if isDoji(i, trendDojiBody)
                    d += 1
            ok := d / n <= maxDojiInTrend
    ok

gapMatches(float gap, float atrNow, string gType, int dir, int newest, int oldest) =>
    bool ok = false
    if gType == "All Gaps"
        ok := gap > 0
    else if gType == "Significant"
        ok := gap >= atrNow * sigGapAtr
    else if gType == "Major"
        ok := gap >= atrNow * majGapAtr
    else
        bool sized = gap >= atrNow * sigGapAtr
        bool brk = false
        if oldest + 1 <= bar_index
            brk := dir == 1 ? windowHigh(newest, oldest) > high[oldest + 1] : windowLow(newest, oldest) < low[oldest + 1]
        ok := sized and brk
    ok

hasGap(int dir, int newest, int oldest, float atrNow) =>
    bool found = false
    if oldest - newest >= 2
        for i = newest to oldest - 2
            if dir == 1 and low[i] > high[i + 2]
                float gap = low[i] - high[i + 2]
                if gapMatches(gap, atrNow, gapType, dir, newest, oldest)
                    found := true
            else if dir == -1 and high[i] < low[i + 2]
                float gap = low[i + 2] - high[i]
                if gapMatches(gap, atrNow, gapType, dir, newest, oldest)
                    found := true
    found

validateSpike(int dir, int newest, int oldest, float atrNow) =>
    int len = oldest - newest + 1
    bool ok = len >= minSpikeBars and trendOk()
    int dojis = 0
    int dirBars = 0
    if oldest >= newest
        for i = newest to oldest
            bool d = isDoji(i, maxDojiBody)
            bool up = close[i] > open[i]
            bool down = close[i] < open[i]
            if d
                dojis += 1
            else if dir == 1 and up or dir == -1 and down
                dirBars += 1
    int nonDoji = len - dojis
    ok := ok and (dojis / len <= maxDojiInSpike)
    ok := ok and (nonDoji <= 0 or dirBars / nonDoji >= minDirRatio)
    float orig = dir == 1 ? windowLow(newest, oldest) : windowHigh(newest, oldest)
    float ext = dir == 1 ? windowHigh(newest, oldest) : windowLow(newest, oldest)
    float size = math.abs(ext - orig)
    ok := ok and size > 0
    if useMovePower
        ok := ok and atrNow > 0 and size / atrNow >= movePowerLevel
    if useGapFilter
        ok := ok and hasGap(dir, newest, oldest, atrNow)
    ok

deleteLines(array<line> arr) =>
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)
    true

deleteLabels(array<label> arr) =>
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)
    true

clearDraw(Setup s) =>
    if not na(s.bSpike)
        box.delete(s.bSpike)
        s.bSpike := na
    deleteLines(s.lvlLines)
    deleteLabels(s.labels)
    if not na(s.lnEntry)
        line.delete(s.lnEntry)
        s.lnEntry := na
    if not na(s.lnSl)
        line.delete(s.lnSl)
        s.lnSl := na
    if not na(s.lnL2)
        line.delete(s.lnL2)
        s.lnL2 := na
    if not na(s.lnTp1)
        line.delete(s.lnTp1)
        s.lnTp1 := na
    if not na(s.lnTp2)
        line.delete(s.lnTp2)
        s.lnTp2 := na
    true

initArrays(Setup s) =>
    if na(s.lvlPx)
        s.lvlPx := array.new<float>()
        s.lvlBar := array.new<int>()
        s.lvlUsed := array.new<bool>()
        s.lvlLines := array.new<line>()
        s.labels := array.new<label>()
    true

resetSetup(Setup s) =>
    clearDraw(s)
    s.dir := 0
    s.phase := 0
    s.startBar := 0
    s.endBar := 0
    s.origin := na
    s.extreme := na
    s.spikeSize := na
    s.entry := na
    s.entryBar := 0
    s.sl := na
    s.tpL2 := na
    s.tp1 := na
    s.tp2 := na
    if not na(s.lvlPx)
        array.clear(s.lvlPx)
        array.clear(s.lvlBar)
        array.clear(s.lvlUsed)
    true

nearPx(float a, float b) =>
    math.abs(a - b) <= math.max(syminfo.mintick * 4, (high - low) * 0.02)

rebuildLevels(Setup s, int newest, int oldest) =>
    initArrays(s)
    array.clear(s.lvlPx)
    array.clear(s.lvlBar)
    array.clear(s.lvlUsed)
    if oldest - 1 >= newest
        for i = newest to oldest - 1
            int newer = i
            int older = i + 1
            bool hl = s.dir == 1 and low[newer] > low[older]
            bool lh = s.dir == -1 and high[newer] < high[older]
            if hl or lh
                float px = s.dir == 1 ? low[older] : high[older]
                int b = bar_index - older
                bool dup = false
                if array.size(s.lvlPx) > 0
                    for k = 0 to array.size(s.lvlPx) - 1
                        if nearPx(array.get(s.lvlPx, k), px)
                            dup := true
                if not dup
                    array.push(s.lvlPx, px)
                    array.push(s.lvlBar, b)
                    array.push(s.lvlUsed, false)
    true

fillSpike(Setup s, int dir, int newest, int oldest) =>
    initArrays(s)
    s.dir := dir
    s.startBar := bar_index - oldest
    s.endBar := bar_index - newest
    s.origin := dir == 1 ? windowLow(newest, oldest) : windowHigh(newest, oldest)
    s.extreme := dir == 1 ? windowHigh(newest, oldest) : windowLow(newest, oldest)
    s.spikeSize := math.abs(s.extreme - s.origin)
    rebuildLevels(s, newest, oldest)
    true

cssOf(int dir) =>
    dir == 1 ? bullCss : bearCss

fade(color c, int transp) =>
    color.new(c, transp)

drawLabel(Setup s, int x, float y, string txt, color c, string style) =>
    label lb = label.new(x, y, txt, xloc.bar_index, yloc.price, c, style, color.white, size.small)
    array.push(s.labels, lb)
    true

redrawSetup(Setup s) =>
    clearDraw(s)
    initArrays(s)
    if s.dir == 0 or s.phase == 0
        true
    else
        bool showSetup = displayMode == "Setup"
        bool showSignal = displayMode == "Signal"
        bool inTrade = s.phase == 3 or s.phase == 4
        bool show = showSetup or (showSignal and inTrade)
        color c = cssOf(s.dir)
        if show and (showSetup or inTrade)
            if showSetup or s.phase >= 2
                float top = math.max(s.origin, s.extreme)
                float bot = math.min(s.origin, s.extreme)
                int x2 = math.max(s.endBar, bar_index)
                s.bSpike := box.new(s.startBar, top, x2, bot, border_color = fade(c, 60), bgcolor = fade(c, boxTransp), border_width = 1)
                if showSetup and s.phase < 3
                    drawLabel(s, s.startBar, s.dir == 1 ? s.origin : s.extreme, "Spike", fade(c, 0), s.dir == 1 ? label.style_label_up : label.style_label_down)
            if showSetup and s.phase < 3 and not na(s.lvlPx) and array.size(s.lvlPx) > 0
                int nLvl = array.size(s.lvlPx)
                int lastLbl = math.min(nLvl, 8) - 1
                for i = 0 to nLvl - 1
                    if not array.get(s.lvlUsed, i)
                        float px = array.get(s.lvlPx, i)
                        int x1 = array.get(s.lvlBar, i)
                        line ln = line.new(x1, px, bar_index, px, xloc.bar_index, extend.none, fade(c, lvlTransp), line.style_dashed, 1)
                        array.push(s.lvlLines, ln)
                        if i <= lastLbl
                            drawLabel(s, x1, px, s.dir == 1 ? "HL" : "LH", fade(c, 30), label.style_label_right)
            if inTrade
                int x1e = s.entryBar
                int x2e = bar_index
                s.lnEntry := line.new(x1e, s.entry, x2e, s.entry, xloc.bar_index, extend.right, fade(c, 0), line.style_solid, 2)
                s.lnSl := line.new(x1e, s.sl, x2e, s.sl, xloc.bar_index, extend.right, color.new(color.red, 0), line.style_dotted, 2)
                s.lnL2 := line.new(x1e, s.tpL2, x2e, s.tpL2, xloc.bar_index, extend.right, fade(c, 0), line.style_solid, 2)
                if showTpRr
                    s.lnTp1 := line.new(x1e, s.tp1, x2e, s.tp1, xloc.bar_index, extend.right, color.new(color.orange, 20), line.style_dashed, 1)
                    s.lnTp2 := line.new(x1e, s.tp2, x2e, s.tp2, xloc.bar_index, extend.right, color.new(color.orange, 0), line.style_dashed, 1)
                drawLabel(s, x1e, s.entry, "Entry", fade(c, 0), label.style_label_left)
                drawLabel(s, x1e, s.sl, "SL", color.new(color.red, 0), label.style_label_left)
                drawLabel(s, x1e, s.tpL2, "L2", fade(c, 0), label.style_label_left)
        true

extendOpenDraw(Setup s) =>
    if s.dir == 0 or s.phase == 0 or s.phase == 4
        true
    else
        if not na(s.bSpike) and s.phase != 4
            box.set_right(s.bSpike, bar_index)
        if not na(s.lvlLines) and array.size(s.lvlLines) > 0 and (s.phase == 1 or s.phase == 2)
            for i = 0 to array.size(s.lvlLines) - 1
                line.set_x2(array.get(s.lvlLines, i), bar_index)
        if s.phase == 3
            if not na(s.lnEntry)
                line.set_x2(s.lnEntry, bar_index)
            if not na(s.lnSl)
                line.set_x2(s.lnSl, bar_index)
            if not na(s.lnL2)
                line.set_x2(s.lnL2, bar_index)
            if not na(s.lnTp1)
                line.set_x2(s.lnTp1, bar_index)
            if not na(s.lnTp2)
                line.set_x2(s.lnTp2, bar_index)
        true

archiveDraw(Setup s) =>
    if not na(s.bSpike)
        box.set_right(s.bSpike, bar_index)
    if not na(s.lnEntry)
        line.set_extend(s.lnEntry, extend.none)
        line.set_x2(s.lnEntry, bar_index)
    if not na(s.lnSl)
        line.set_extend(s.lnSl, extend.none)
        line.set_x2(s.lnSl, bar_index)
    if not na(s.lnL2)
        line.set_extend(s.lnL2, extend.none)
        line.set_x2(s.lnL2, bar_index)
    if not na(s.lnTp1)
        line.set_extend(s.lnTp1, extend.none)
        line.set_x2(s.lnTp1, bar_index)
    if not na(s.lnTp2)
        line.set_extend(s.lnTp2, extend.none)
        line.set_x2(s.lnTp2, bar_index)
    true

enterTrade(Setup s, float px) =>
    float thresh = useSlThresh ? slThresh : 0.0
    s.entry := px
    s.entryBar := bar_index
    s.phase := 3
    if s.dir == 1
        float rawSl = s.origin - thresh
        s.sl := rawSl
        float risk = includeThreshInRR ? s.entry - s.sl : s.entry - s.origin
        risk := math.max(risk, syminfo.mintick)
        s.tpL2 := s.entry + s.spikeSize
        s.tp1 := s.entry + risk
        s.tp2 := s.entry + risk * rrRatio
    else
        float rawSl = s.origin + thresh
        s.sl := rawSl
        float risk = includeThreshInRR ? s.sl - s.entry : s.origin - s.entry
        risk := math.max(risk, syminfo.mintick)
        s.tpL2 := s.entry - s.spikeSize
        s.tp1 := s.entry - risk
        s.tp2 := s.entry - risk * rrRatio
    true

capHist() =>
    if array.size(hist) > 20
        clearDraw(array.get(hist, 0))
        array.shift(hist)
    true

clearHist() =>
    if array.size(hist) > 0
        for i = 0 to array.size(hist) - 1
            clearDraw(array.get(hist, i))
        array.clear(hist)
    true

legSizeOk(float y1, float y2, float atrNow) =>
    math.abs(y2 - y1) >= atrNow * minLegAtr

trimZzLegs() =>
    if array.size(zzLegs) > maxLegsKeep
        ZzLeg old = array.shift(zzLegs)
        if not na(old.ln)
            line.delete(old.ln)
        if not na(old.lb)
            label.delete(old.lb)
    true

redrawLastZzLeg() =>
    int n = array.size(zzLegs)
    int p = array.size(zzPts)
    if n > 0 and p >= 2
        ZzLeg lg = array.get(zzLegs, n - 1)
        ZzPt a = array.get(zzPts, p - 2)
        ZzPt b = array.get(zzPts, p - 1)
        if not na(lg.ln)
            line.set_xy1(lg.ln, a.bar, a.px)
            line.set_xy2(lg.ln, b.bar, b.px)
        if not na(lg.lb)
            label.set_xy(lg.lb, math.round(math.avg(a.bar, b.bar)), math.avg(a.px, b.px))
    true

pushZzLeg(ZzPt a, ZzPt b, float atrNow) =>
    int dir = b.px > a.px ? 1 : b.px < a.px ? -1 : 0
    bool ok = dir != 0 and legSizeOk(a.px, b.px, atrNow)
    if ok
        color c = fade(cssOf(dir), 0)
        line ln = line.new(a.bar, a.px, b.bar, b.px, xloc.bar_index, extend.none, c, line.style_solid, 2)
        string txt = "L1"
        if array.size(zzLegs) >= 2
            ZzLeg corr = array.get(zzLegs, array.size(zzLegs) - 1)
            ZzLeg first = array.get(zzLegs, array.size(zzLegs) - 2)
            if first.dir == dir and corr.dir != dir
                txt := "L2"
            else if corr.dir != dir
                txt := "C"
        else if array.size(zzLegs) >= 1
            ZzLeg prev = array.get(zzLegs, array.size(zzLegs) - 1)
            if prev.dir != dir
                txt := "C"
        label lb = label.new(math.round(math.avg(a.bar, b.bar)), math.avg(a.px, b.px), txt, xloc.bar_index, yloc.price, c, label.style_label_left, color.white, size.small)
        array.push(zzLegs, ZzLeg.new(dir, a.bar, b.bar, a.px, b.px, ln, lb))
        trimZzLegs()
    true

addZzPt(int b, float p, bool isHigh, float atrNow) =>
    int sz = array.size(zzPts)
    if sz > 0
        ZzPt last = array.get(zzPts, sz - 1)
        if last.isHigh == isHigh
            bool better = isHigh ? p >= last.px : p <= last.px
            if better
                array.set(zzPts, sz - 1, ZzPt.new(b, p, isHigh))
                redrawLastZzLeg()
            false
        else
            array.push(zzPts, ZzPt.new(b, p, isHigh))
            pushZzLeg(last, array.get(zzPts, array.size(zzPts) - 1), atrNow)
            true
    else
        array.push(zzPts, ZzPt.new(b, p, isHigh))
        true

// ================================================================================================
// State
// ================================================================================================

bool spikeAlert = false
bool bosAlert = false
bool entryBuyAlert = false
bool entrySellAlert = false
bool tpAlert = false
bool slAlert = false

atrVal = ta.atr(atrLen)

bool zzChanged = false
if showLegs and bar_index > 3
    if zzDir == 0
        zzDir := close >= open ? 1 : -1
        zzStartBar := bar_index
        zzStartPx := zzDir == 1 ? low : high
        zzExtBar := bar_index
        zzExtPx := zzDir == 1 ? high : low
    else if zzDir == 1
        if high >= zzExtPx
            zzExtPx := high
            zzExtBar := bar_index
        else
            float rise = zzExtPx - zzStartPx
            float retr = zzExtPx - low
            bool enough = rise > 0 and retr >= rise * reversalPct / 100.0 and rise >= atrVal * minLegAtr
            if enough
                addZzPt(zzStartBar, zzStartPx, false, atrVal)
                addZzPt(zzExtBar, zzExtPx, true, atrVal)
                zzChanged := true
                zzDir := -1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := low
    else
        if low <= zzExtPx
            zzExtPx := low
            zzExtBar := bar_index
        else
            float drop = zzStartPx - zzExtPx
            float retr = high - zzExtPx
            bool enough = drop > 0 and retr >= drop * reversalPct / 100.0 and drop >= atrVal * minLegAtr
            if enough
                addZzPt(zzStartBar, zzStartPx, true, atrVal)
                addZzPt(zzExtBar, zzExtPx, false, atrVal)
                zzChanged := true
                zzDir := 1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := high
    if zzChanged and showL2Proj
        if not na(zzL2proj)
            line.delete(zzL2proj)
            zzL2proj := na
        if not na(zzL2lbl)
            label.delete(zzL2lbl)
            zzL2lbl := na
        if array.size(zzLegs) >= 3
            int nzz = array.size(zzLegs)
            ZzLeg zLast = array.get(zzLegs, nzz - 1)
            ZzLeg zCorr = array.get(zzLegs, nzz - 2)
            ZzLeg zFirst = array.get(zzLegs, nzz - 3)
            if zLast.dir == zFirst.dir and zCorr.dir != zLast.dir
                float size1 = math.abs(zFirst.y2 - zFirst.y1)
                float tgt = zLast.dir == 1 ? zLast.y1 + size1 : zLast.y1 - size1
                color zc = fade(cssOf(zLast.dir), 0)
                zzL2proj := line.new(zLast.x1, tgt, math.max(zLast.x2, bar_index), tgt, xloc.bar_index, extend.right, zc, line.style_dashed, 2)
                zzL2lbl := label.new(math.max(zLast.x2, bar_index), tgt, "L2 target", xloc.bar_index, yloc.price, zc, label.style_label_left, color.white, size.small)
    color lc = fade(cssOf(zzDir == 0 ? 1 : zzDir), 0)
    if na(zzLive)
        zzLive := line.new(zzStartBar, zzStartPx, zzExtBar, zzExtPx, xloc.bar_index, extend.none, lc, line.style_solid, 3)
    else
        line.set_xy1(zzLive, zzStartBar, zzStartPx)
        line.set_xy2(zzLive, zzExtBar, zzExtPx)
        line.set_color(zzLive, lc)
    string liveTxt = zzDir == 1 ? "Leg ↑" : "Leg ↓"
    int midX = math.round(math.avg(zzStartBar, zzExtBar))
    float midY = math.avg(zzStartPx, zzExtPx)
    if na(zzLiveLbl)
        zzLiveLbl := label.new(midX, midY, liveTxt, xloc.bar_index, yloc.price, lc, zzDir == 1 ? label.style_label_up : label.style_label_down, color.white, size.normal)
    else
        label.set_xy(zzLiveLbl, midX, midY)
        label.set_text(zzLiveLbl, liveTxt)
        label.set_color(zzLiveLbl, lc)
        label.set_style(zzLiveLbl, zzDir == 1 ? label.style_label_up : label.style_label_down)
    if showL2Proj and not na(zzL2proj)
        line.set_x2(zzL2proj, bar_index)

initArrays(cur)

if bar_index > maxSpikeBars + 5
    int bullRun = countRun(1, 0, maxSpikeBars, maxDojiBody, dojiTolerance)
    int bearRun = countRun(-1, 0, maxSpikeBars, maxDojiBody, dojiTolerance)
    int bullDone = countRun(1, 1, maxSpikeBars, maxDojiBody, dojiTolerance)
    int bearDone = countRun(-1, 1, maxSpikeBars, maxDojiBody, dojiTolerance)
    bool bullBroke = bullRun == 0 and bullDone >= minSpikeBars
    bool bearBroke = bearRun == 0 and bearDone >= minSpikeBars

    // Close trade
    if cur.phase == 3
        bool hitSl = cur.dir == 1 ? low <= cur.sl : high >= cur.sl
        bool hitL2 = cur.dir == 1 ? high >= cur.tpL2 : low <= cur.tpL2
        if hitSl or hitL2
            if hitSl
                slAlert := true
            if hitL2 and not hitSl
                tpAlert := true
            cur.phase := 4
            archiveDraw(cur)
            if onlyLast
                clearHist()
            array.push(hist, cur)
            capHist()
            cur := Setup.new()
            initArrays(cur)

    // Invalidate / expire only after the spike has finished (waiting for retest)
    if cur.phase == 2
        bool broken = cur.dir == 1 ? low < cur.origin : high > cur.origin
        bool expired = bar_index - cur.endBar > maxWaitBars
        if broken or expired
            resetSetup(cur)

    // Spike just completed → freeze and wait for HL/LH retest
    bool newComplete = false
    if cur.phase == 0 or cur.phase == 1
        if bullBroke and validateSpike(1, 1, bullDone, atrVal)
            if onlyLast
                clearHist()
            fillSpike(cur, 1, 1, bullDone)
            cur.phase := 2
            spikeAlert := true
            bosAlert := true
            newComplete := true
            redrawSetup(cur)
        else if bearBroke and validateSpike(-1, 1, bearDone, atrVal)
            if onlyLast
                clearHist()
            fillSpike(cur, -1, 1, bearDone)
            cur.phase := 2
            spikeAlert := true
            bosAlert := true
            newComplete := true
            redrawSetup(cur)
        else if cur.phase == 1 and ((cur.dir == 1 and bullBroke) or (cur.dir == -1 and bearBroke))
            cur.phase := 2
            spikeAlert := true
            bosAlert := true
            newComplete := true
            redrawSetup(cur)

    // Forming spike — refresh while the run continues
    if not newComplete and (cur.phase == 0 or cur.phase == 1)
        bool took = false
        if bullRun >= minSpikeBars and validateSpike(1, 0, bullRun - 1, atrVal)
            if cur.phase == 0 and onlyLast
                clearHist()
            fillSpike(cur, 1, 0, bullRun - 1)
            cur.phase := 1
            took := true
            redrawSetup(cur)
        if not took and bearRun >= minSpikeBars and validateSpike(-1, 0, bearRun - 1, atrVal)
            if cur.phase == 0 and onlyLast
                clearHist()
            fillSpike(cur, -1, 0, bearRun - 1)
            cur.phase := 1
            redrawSetup(cur)

    // Retest entry only after the spike has finished (not on every HL inside the move)
    if cur.phase == 2 and not na(cur.lvlPx) and array.size(cur.lvlPx) > 0
        float best = na
        int bestIdx = -1
        for i = 0 to array.size(cur.lvlPx) - 1
            if not array.get(cur.lvlUsed, i)
                float px = array.get(cur.lvlPx, i)
                int lb = array.get(cur.lvlBar, i)
                if bar_index > lb + 1
                    bool touch = low <= px and high >= px
                    if touch
                        if na(best)
                            best := px
                            bestIdx := i
                        else if cur.dir == 1
                            if px >= best
                                best := px
                                bestIdx := i
                        else
                            if px <= best
                                best := px
                                bestIdx := i
        if not na(best) and bestIdx >= 0
            bool stillValid = cur.dir == 1 ? low >= cur.origin : high <= cur.origin
            if stillValid
                array.set(cur.lvlUsed, bestIdx, true)
                enterTrade(cur, best)
                if cur.dir == 1
                    entryBuyAlert := true
                else
                    entrySellAlert := true
                redrawSetup(cur)

    extendOpenDraw(cur)

plotshape(showEntryMarks and entryBuyAlert, "Buy", shape.triangleup, location.belowbar, bullCss, size = size.small)
plotshape(showEntryMarks and entrySellAlert, "Sell", shape.triangledown, location.abovebar, bearCss, size = size.small)

alertcondition(spikeAlert, "SP2L Spike", "SP2L spike detected")
alertcondition(bosAlert, "SP2L Spike Complete", "SP2L spike completed — waiting for HL/LH retest")
alertcondition(entryBuyAlert, "SP2L Buy", "SP2L buy entry — HL retest")
alertcondition(entrySellAlert, "SP2L Sell", "SP2L sell entry — LH retest")
alertcondition(tpAlert, "SP2L L2 Target", "SP2L second-leg target hit")
alertcondition(slAlert, "SP2L Stop", "SP2L stop-loss hit")
