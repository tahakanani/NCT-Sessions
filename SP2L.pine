// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("SP2L (Spike – 2Leg – Level)", shorttitle = "SP2L", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ================================================================================================
// Inputs — Poursamadi method only
// ================================================================================================

grpLeg = "Leg Detection"
showLegs = input.bool(true, "Show Legs", group = grpLeg)
atrLen = input.int(14, "ATR Length", minval = 1, group = grpLeg)
reversalPct = input.float(22.0, "Reversal % of Leg", minval = 10.0, maxval = 80.0, step = 1.0, group = grpLeg, tooltip = "پولبک کم‌عمق لگ را قطع نمی‌کند")
minLegAtr = input.float(0.8, "Min Leg Size × ATR", minval = 0.2, step = 0.1, group = grpLeg)
minLegPrice = input.float(4.0, "Min Leg Size (Price)", minval = 0.0, step = 0.5, group = grpLeg, tooltip = "طلا ۱دقیقه: ۴ تا ۸")
minReversalAtr = input.float(0.35, "Min Reversal × ATR", minval = 0.1, step = 0.05, group = grpLeg)
minLegBars = input.int(3, "Min Leg Bars", minval = 2, maxval = 120, group = grpLeg)
corrEndPct = input.float(18.0, "Correction End %", minval = 5.0, maxval = 50.0, step = 1.0, group = grpLeg)
corrEndAtr = input.float(0.35, "Correction End × ATR", minval = 0.1, step = 0.05, group = grpLeg)
minCorrBars = input.int(2, "Min Correction Bars", minval = 1, maxval = 20, group = grpLeg)
lookbackDays = input.int(3, "Lookback Days", minval = 1, maxval = 15, group = grpLeg, tooltip = "فقط لگ‌های این تعداد روز معاملاتی آخر")
maxLegsKeep = input.int(20, "Max Legs Kept", minval = 4, maxval = 60, group = grpLeg)

grpDisp = "Display"
bullCss = input.color(color.new(#089981, 0), "Bullish", group = grpDisp)
bearCss = input.color(color.new(#f23645, 0), "Bearish", group = grpDisp)
boxTransp = input.int(82, "Box Transparency", minval = 50, maxval = 95, group = grpDisp)
showLegLabels = input.bool(true, "Show L1 / L2 Labels", group = grpDisp)
showSp2lLevels = input.bool(true, "Show SL / Entry / TP1 / TP2", group = grpDisp)

// ================================================================================================
// Types
// ================================================================================================

type ZzPt
    int bar = 0
    float px = na
    bool isHigh = false

type ZzLeg
    int dir = 0
    int x1 = 0
    int x2 = 0
    float y1 = na
    float y2 = na
    label lb = na
    box bx = na
    float meas = na
    string kind = ""
    bool hasPair = false
    bool frozen = false

type Sp2lDraw
    int dir = 0
    int x0 = 0
    int xE = 0
    float sl = na
    float entry = na
    float tp1 = na
    float tp2 = na
    line lnSl = na
    line lnEntry = na
    line lnTp1 = na
    line lnTp2 = na
    label lbSl = na
    label lbEn = na
    label lbT1 = na
    label lbT2 = na
    bool frozen = false

var array<ZzPt> zzPts = array.new<ZzPt>()
var array<ZzLeg> zzLegs = array.new<ZzLeg>()
var array<Sp2lDraw> spPairs = array.new<Sp2lDraw>()
var array<int> sessOpen = array.new<int>()
var label zzLiveLbl = na
var box zzLiveBox = na
var int zzDir = 0
var int zzStartBar = 0
var float zzStartPx = na
var int zzExtBar = 0
var float zzExtPx = na

// ================================================================================================
// Helpers
// ================================================================================================

cssOf(int dir) =>
    dir == 1 ? bullCss : bearCss

fade(color c, int transp) =>
    color.new(c, transp)

legSpan(float y1, float y2) =>
    math.abs(y2 - y1)

safeAtr(float atrNow) =>
    na(atrNow) or atrNow <= 0 ? syminfo.mintick * 50.0 : atrNow

needSize(float atrNow) =>
    math.max(safeAtr(atrNow) * minLegAtr, minLegPrice)

legSizeOk(float y1, float y2, float atrNow) =>
    legSpan(y1, y2) >= needSize(atrNow)

reversalEnough(float swing, float retr, float atrNow) =>
    float needPct = swing * reversalPct / 100.0
    float needAtr = safeAtr(atrNow) * minReversalAtr
    swing > 0 and retr >= math.max(needPct, needAtr)

pairBox(int x1, float yStart, int x2, float size, int dir, color c) =>
    float yEnd = dir == 1 ? yStart + size : yStart - size
    box.new(x1, math.max(yStart, yEnd), math.max(x2, x1 + 1), math.min(yStart, yEnd), border_color = fade(c, 15), bgcolor = fade(c, boxTransp), border_width = 2)

clearPairDraw(Sp2lDraw p) =>
    if not na(p.lnSl)
        line.delete(p.lnSl)
    if not na(p.lnEntry)
        line.delete(p.lnEntry)
    if not na(p.lnTp1)
        line.delete(p.lnTp1)
    if not na(p.lnTp2)
        line.delete(p.lnTp2)
    if not na(p.lbSl)
        label.delete(p.lbSl)
    if not na(p.lbEn)
        label.delete(p.lbEn)
    if not na(p.lbT1)
        label.delete(p.lbT1)
    if not na(p.lbT2)
        label.delete(p.lbT2)
    true

trimPairs() =>
    if array.size(spPairs) > math.max(4, maxLegsKeep / 2)
        clearPairDraw(array.get(spPairs, 0))
        array.shift(spPairs)
    true

lvlLine(int x1, float y, int x2, color c, string st) =>
    line.new(x1, y, x2, y, xloc.bar_index, extend.none, c, st == "dot" ? line.style_dotted : line.style_solid, 2)

lvlLbl(int x, float y, string txt, color c) =>
    label.new(x, y, txt, xloc.bar_index, yloc.price, c, label.style_label_left, color.white, size.small)

spawnLevels(int dir, int x0, int xE, float sl, float entry, float meas) =>
    float tp1 = dir == 1 ? entry + meas : entry - meas
    float tp2 = dir == 1 ? entry + meas * 2.0 : entry - meas * 2.0
    int x2 = math.max(xE + 1, bar_index)
    color c = fade(cssOf(dir), 0)
    line lnSl = na
    line lnEn = na
    line ln1 = na
    line ln2 = na
    label lbSl = na
    label lbEn = na
    label lb1 = na
    label lb2 = na
    if showSp2lLevels
        lnSl := lvlLine(x0, sl, x2, color.new(color.red, 0), "dot")
        lnEn := lvlLine(xE, entry, x2, c, "solid")
        ln1 := lvlLine(xE, tp1, x2, fade(c, 0), "solid")
        ln2 := lvlLine(xE, tp2, x2, color.new(color.orange, 0), "solid")
        lbSl := lvlLbl(x2, sl, "SL", color.new(color.red, 0))
        lbEn := lvlLbl(x2, entry, "Entry", c)
        lb1 := lvlLbl(x2, tp1, "TP1", c)
        lb2 := lvlLbl(x2, tp2, "TP2", color.new(color.orange, 0))
    array.push(spPairs, Sp2lDraw.new(dir, x0, xE, sl, entry, tp1, tp2, lnSl, lnEn, ln1, ln2, lbSl, lbEn, lb1, lb2, false))
    trimPairs()
    true

eraseLegDraw(ZzLeg lg) =>
    if not na(lg.lb)
        label.delete(lg.lb)
        lg.lb := na
    if not na(lg.bx)
        box.delete(lg.bx)
        lg.bx := na
    true

barTime(int b) =>
    int off = bar_index - b
    off >= 0 and off <= bar_index ? time[off] : time

windowStart() =>
    array.size(sessOpen) > 0 ? array.get(sessOpen, 0) : time

inLookback(int b) =>
    barTime(b) >= windowStart()

clearPairsAt(int x0) =>
    if array.size(spPairs) > 0
        int i = array.size(spPairs) - 1
        while i >= 0
            Sp2lDraw pr = array.get(spPairs, i)
            if pr.x0 == x0
                clearPairDraw(pr)
                array.remove(spPairs, i)
            i -= 1
    true

removeL1(int idx) =>
    bool done = false
    if idx >= 0 and idx < array.size(zzLegs)
        ZzLeg lg = array.get(zzLegs, idx)
        eraseLegDraw(lg)
        clearPairsAt(lg.x1)
        array.remove(zzLegs, idx)
        done := true
    done

pruneOldDraws() =>
    int n = array.size(zzLegs)
    if n > 0
        for i = 0 to n - 1
            ZzLeg lg = array.get(zzLegs, i)
            if not inLookback(lg.x1)
                eraseLegDraw(lg)
                array.set(zzLegs, i, lg)
    if array.size(spPairs) > 0
        int i = array.size(spPairs) - 1
        while i >= 0
            Sp2lDraw pr = array.get(spPairs, i)
            if not inLookback(pr.x0)
                clearPairDraw(pr)
                array.remove(spPairs, i)
            i -= 1
    true

trimZzLegs() =>
    if array.size(zzLegs) > maxLegsKeep
        ZzLeg old = array.shift(zzLegs)
        eraseLegDraw(old)
        clearPairsAt(old.x1)
    true

findUnpairedL1(int avoidDir) =>
    int idx = -1
    int n = array.size(zzLegs)
    if n > 0
        for i = n - 1 to 0
            ZzLeg lg = array.get(zzLegs, i)
            if lg.kind == "L1" and not lg.hasPair and lg.dir != avoidDir
                idx := i
                break
    idx

awaitingCorrEnd() =>
    findUnpairedL1(zzDir) >= 0

spawnL2(int l1i, int x1, float y1) =>
    ZzLeg l1 = array.get(zzLegs, l1i)
    float meas = not na(l1.meas) ? l1.meas : math.abs(l1.y2 - l1.y1)
    int dir = l1.dir
    color c = fade(cssOf(dir), 0)
    float y2 = dir == 1 ? y1 + meas : y1 - meas
    int x2 = math.max(x1 + 1, bar_index)
    box bx = na
    label lb = na
    if inLookback(x1)
        bx := pairBox(x1, y1, x2, meas, dir, c)
        if showLegLabels
            lb := label.new(math.round(math.avg(x1, x2)), math.avg(y1, y2), "L2", xloc.bar_index, yloc.price, c, label.style_label_left, color.white, size.small)
    l1.hasPair := true
    array.set(zzLegs, l1i, l1)
    array.push(zzLegs, ZzLeg.new(dir, x1, x2, y1, y2, lb, bx, meas, "L2", true, false))
    if inLookback(l1.x1)
        spawnLevels(dir, l1.x1, x1, l1.y1, y1, meas)
    trimZzLegs()
    true

corrFinished(float swing, float retr, int bars, float atrNow) =>
    bool bounce = retr >= swing * corrEndPct / 100.0 or (atrNow > 0 and retr >= atrNow * corrEndAtr)
    swing > 0 and bars >= minCorrBars and bounce

redrawLastZzLeg() =>
    int n = array.size(zzLegs)
    int p = array.size(zzPts)
    if n > 0 and p >= 2
        ZzLeg lg = array.get(zzLegs, n - 1)
        if lg.kind == "L1"
            ZzPt a = array.get(zzPts, p - 2)
            ZzPt b = array.get(zzPts, p - 1)
            if not na(lg.lb)
                label.set_xy(lg.lb, math.round(math.avg(a.bar, b.bar)), math.avg(a.px, b.px))
            if not na(lg.bx)
                box.set_lefttop(lg.bx, a.bar, math.max(a.px, b.px))
                box.set_rightbottom(lg.bx, b.bar, math.min(a.px, b.px))
    true

pushZzLeg(ZzPt a, ZzPt b, float atrNow) =>
    int dir = b.px > a.px ? 1 : b.px < a.px ? -1 : 0
    int bars = math.abs(b.bar - a.bar)
    float meas = math.abs(b.px - a.px)
    bool isL1 = dir != 0 and meas > 0 and bars >= minLegBars and legSizeOk(a.px, b.px, atrNow)
    bool isCorr = dir != 0 and meas > 0 and bars >= minCorrBars
    bool ok = isL1 or isCorr
    if ok
        int mate = findUnpairedL1(dir)
        if mate >= 0
            ZzLeg l1m = array.get(zzLegs, mate)
            float l1sz = not na(l1m.meas) ? l1m.meas : math.abs(l1m.y2 - l1m.y1)
            if meas >= l1sz and l1sz > 0
                removeL1(mate)
                mate := -1
        string txt = isL1 ? "L1" : "C"
        color c = fade(cssOf(dir), 0)
        label lb = na
        box bx = na
        if isL1 and inLookback(a.bar)
            bx := pairBox(a.bar, a.px, b.bar, meas, dir, c)
            if showLegLabels
                lb := label.new(math.round(math.avg(a.bar, b.bar)), math.avg(a.px, b.px), "L1", xloc.bar_index, yloc.price, c, label.style_label_left, color.white, size.small)
        array.push(zzLegs, ZzLeg.new(dir, a.bar, b.bar, a.px, b.px, lb, bx, meas, txt, false, false))
        trimZzLegs()
        if mate >= 0
            spawnL2(mate, b.bar, b.px)
    true

addZzPt(int b, float p, bool isHigh, float atrNow) =>
    int sz = array.size(zzPts)
    if sz > 0
        ZzPt last = array.get(zzPts, sz - 1)
        if last.isHigh == isHigh
            bool better = isHigh ? p >= last.px : p <= last.px
            if better
                array.set(zzPts, sz - 1, ZzPt.new(b, p, isHigh))
                redrawLastZzLeg()
            false
        else
            array.push(zzPts, ZzPt.new(b, p, isHigh))
            pushZzLeg(last, array.get(zzPts, array.size(zzPts) - 1), atrNow)
            true
    else
        array.push(zzPts, ZzPt.new(b, p, isHigh))
        true

confirmMajorHigh(float atrNow) =>
    addZzPt(zzStartBar, zzStartPx, false, atrNow)
    addZzPt(zzExtBar, zzExtPx, true, atrNow)

confirmMajorLow(float atrNow) =>
    addZzPt(zzStartBar, zzStartPx, true, atrNow)
    addZzPt(zzExtBar, zzExtPx, false, atrNow)

// ================================================================================================
// State
// ================================================================================================

bool l1Alert = false
bool entryBuyAlert = false
bool entrySellAlert = false
bool tpAlert = false
bool slAlert = false
bool zzChanged = false

atrVal = ta.atr(atrLen)
float sizeNeed = needSize(atrVal)

if showLegs and bar_index > 3
    int dayT = time("D")
    if not na(dayT)
        if array.size(sessOpen) == 0 or array.get(sessOpen, array.size(sessOpen) - 1) != dayT
            array.push(sessOpen, dayT)
            while array.size(sessOpen) > lookbackDays
                array.shift(sessOpen)
            pruneOldDraws()
    if zzDir == 0
        zzDir := close >= open ? 1 : -1
        zzStartBar := bar_index
        zzStartPx := zzDir == 1 ? low : high
        zzExtBar := bar_index
        zzExtPx := zzDir == 1 ? high : low
    else if zzDir == 1
        if high >= zzExtPx
            zzExtPx := high
            zzExtBar := bar_index
        else
            float rise = zzExtPx - zzStartPx
            float retr = zzExtPx - low
            int spanBars = zzExtBar - zzStartBar
            bool easyC = awaitingCorrEnd()
            bool major = rise >= sizeNeed and spanBars >= minLegBars and reversalEnough(rise, retr, atrVal)
            bool corrEnd = easyC and corrFinished(rise, retr, spanBars, atrVal)
            bool abandonTiny = not easyC and rise < sizeNeed and retr >= sizeNeed
            if major or corrEnd
                confirmMajorHigh(atrVal)
                zzChanged := true
                zzDir := -1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := low
            else if abandonTiny
                zzDir := -1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := low
    else
        if low <= zzExtPx
            zzExtPx := low
            zzExtBar := bar_index
        else
            float drop = zzStartPx - zzExtPx
            float retr = high - zzExtPx
            int spanBars = zzExtBar - zzStartBar
            bool easyC = awaitingCorrEnd()
            bool major = drop >= sizeNeed and spanBars >= minLegBars and reversalEnough(drop, retr, atrVal)
            bool corrEnd = easyC and corrFinished(drop, retr, spanBars, atrVal)
            bool abandonTiny = not easyC and drop < sizeNeed and retr >= sizeNeed
            if major or corrEnd
                confirmMajorLow(atrVal)
                zzChanged := true
                zzDir := 1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := high
            else if abandonTiny
                zzDir := 1
                zzStartBar := zzExtBar
                zzStartPx := zzExtPx
                zzExtBar := bar_index
                zzExtPx := high
    int l1iKill = findUnpairedL1(zzDir)
    if l1iKill >= 0
        ZzLeg l1w = array.get(zzLegs, l1iKill)
        float corrNow = math.abs(zzExtPx - zzStartPx)
        float l1sz = not na(l1w.meas) ? l1w.meas : math.abs(l1w.y2 - l1w.y1)
        if l1sz > 0 and corrNow >= l1sz
            removeL1(l1iKill)
    if array.size(zzLegs) > 0
        ZzLeg lastLg = array.get(zzLegs, array.size(zzLegs) - 1)
        if zzChanged and lastLg.kind == "L1" and not lastLg.hasPair
            l1Alert := true
        if zzChanged and lastLg.kind == "L2"
            if lastLg.dir == 1
                entryBuyAlert := true
            else
                entrySellAlert := true
        for i = 0 to array.size(zzLegs) - 1
            ZzLeg lg = array.get(zzLegs, i)
            if lg.kind == "L2" and not lg.frozen and not na(lg.bx)
                int x2 = bar_index
                bool hit = lg.dir == 1 ? high >= lg.y2 : low <= lg.y2
                if hit
                    lg.frozen := true
                    tpAlert := true
                box.set_right(lg.bx, x2)
                if not na(lg.lb)
                    label.set_x(lg.lb, math.round(math.avg(lg.x1, x2)))
                array.set(zzLegs, i, lg)
    if showSp2lLevels and array.size(spPairs) > 0
        for p = 0 to array.size(spPairs) - 1
            Sp2lDraw pr = array.get(spPairs, p)
            if not pr.frozen
                int x2p = bar_index
                bool hitTp2 = pr.dir == 1 ? high >= pr.tp2 : low <= pr.tp2
                bool hitSl = pr.dir == 1 ? low <= pr.sl : high >= pr.sl
                if hitTp2
                    tpAlert := true
                    pr.frozen := true
                if hitSl
                    slAlert := true
                    pr.frozen := true
                if not na(pr.lnSl)
                    line.set_x2(pr.lnSl, x2p)
                if not na(pr.lnEntry)
                    line.set_x2(pr.lnEntry, x2p)
                if not na(pr.lnTp1)
                    line.set_x2(pr.lnTp1, x2p)
                if not na(pr.lnTp2)
                    line.set_x2(pr.lnTp2, x2p)
                if not na(pr.lbSl)
                    label.set_x(pr.lbSl, x2p)
                if not na(pr.lbEn)
                    label.set_x(pr.lbEn, x2p)
                if not na(pr.lbT1)
                    label.set_x(pr.lbT1, x2p)
                if not na(pr.lbT2)
                    label.set_x(pr.lbT2, x2p)
                array.set(spPairs, p, pr)
    bool openL2 = false
    if array.size(zzLegs) > 0
        for j = 0 to array.size(zzLegs) - 1
            ZzLeg lg2 = array.get(zzLegs, j)
            if lg2.kind == "L2" and not lg2.frozen and lg2.dir == zzDir
                openL2 := true
    bool formingL1 = not awaitingCorrEnd() and not openL2 and inLookback(zzStartBar) and math.abs(zzExtPx - zzStartPx) >= sizeNeed * 0.35
    color lc = fade(cssOf(zzDir == 0 ? 1 : zzDir), 0)
    if formingL1
        float liveTop = math.max(zzStartPx, zzExtPx)
        float liveBot = math.min(zzStartPx, zzExtPx)
        if na(zzLiveBox)
            zzLiveBox := box.new(zzStartBar, liveTop, math.max(zzExtBar, bar_index), liveBot, border_color = fade(lc, 25), bgcolor = fade(lc, boxTransp), border_width = 2)
        else
            box.set_lefttop(zzLiveBox, zzStartBar, liveTop)
            box.set_rightbottom(zzLiveBox, math.max(zzExtBar, bar_index), liveBot)
        if showLegLabels
            int midX = math.round(math.avg(zzStartBar, math.max(zzExtBar, bar_index)))
            float midY = math.avg(zzStartPx, zzExtPx)
            if na(zzLiveLbl)
                zzLiveLbl := label.new(midX, midY, "L1", xloc.bar_index, yloc.price, lc, label.style_label_left, color.white, size.small)
            else
                label.set_xy(zzLiveLbl, midX, midY)
                label.set_text(zzLiveLbl, "L1")
                label.set_color(zzLiveLbl, lc)
    else
        if not na(zzLiveLbl)
            label.delete(zzLiveLbl)
            zzLiveLbl := na
        if not na(zzLiveBox)
            box.delete(zzLiveBox)
            zzLiveBox := na

alertcondition(l1Alert, "SP2L L1", "SP2L first leg")
alertcondition(entryBuyAlert, "SP2L Buy", "SP2L buy — entry at correction end")
alertcondition(entrySellAlert, "SP2L Sell", "SP2L sell — entry at correction end")
alertcondition(tpAlert, "SP2L TP", "SP2L take-profit hit")
alertcondition(slAlert, "SP2L Stop", "SP2L stop-loss hit")
