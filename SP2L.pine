//@version=6
indicator("SP2L (Spike – 2Leg – Level)", shorttitle = "SP2L", overlay = true, max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ================================================================================================
// Inputs
// ================================================================================================

grpSpike = "Spike Filter | Movement"
minSpikeBars = input.int(3, "Minimum Spike Bars", minval = 2, maxval = 50, group = grpSpike, tooltip = "حداقل تعداد کندل برای اسپایک معتبر")
useMovePower = input.bool(false, "Movement Power", group = grpSpike)
movePowerLevel = input.float(0.6, "Movement Power Level", minval = 0.1, step = 0.1, group = grpSpike, tooltip = "آستانهٔ range اسپایک نسبت به ATR؛ بالاتر = فقط اسپایک‌های قوی")
atrLen = input.int(14, "ATR Length", minval = 1, group = grpSpike)
maxSpikeBars = input.int(80, "Max Spike Bars", minval = 3, maxval = 150, group = grpSpike)
minDirRatio = input.float(0.40, "Min Directional Bar Ratio", minval = 0.3, maxval = 1.0, step = 0.05, group = grpSpike)

grpLeg = "Leg Detection (ZigZag)"
showLegs = input.bool(true, "Show Legs", group = grpLeg, tooltip = "خطوط زیگ‌زاگ MT4؛ هر خط یک اسپایک SP2L است")
zzDepth = input.int(5, "Depth", minval = 1, step = 1, group = grpLeg)
zzDeviation = input.int(6, "Deviation", minval = 1, step = 1, group = grpLeg, tooltip = "حداقل حرکت بین سقف و کف بر حسب پوینت")
zzBackstep = input.int(3, "Backstep", minval = 2, step = 1, group = grpLeg)
minLegAtr = input.float(1.0, "Min Leg Size × ATR", minval = 0.0, step = 0.1, group = grpLeg)
maxLegsKeep = input.int(220, "Max Legs On Chart", minval = 4, maxval = 400, group = grpLeg, tooltip = "خطوط زیگ‌زاگ؛ کمی پایین‌تر از 500 تا جا برای باکس و پوزیشن بماند")
showL2Proj = input.bool(true, "Project L2 = L1", group = grpLeg)
showEntryMarks = input.bool(false, "Show Entry Triangles", group = grpLeg, tooltip = "مثلث‌های سبز/قرمز ورود HL؛ برای دیدن لگ‌ها خاموش بماند")

grpPos = "Position Management"
rrRatio = input.float(2.0, "Risk-Reward Ratio", minval = 0.5, step = 0.1, group = grpPos, tooltip = "TP2 نسبت به ریسک؛ TP1 همیشه 1R است")
maxWaitBars = input.int(80, "Max Wait Bars After Spike", minval = 5, maxval = 500, group = grpPos)
showTpRr = input.bool(false, "Show R:R Take-Profits", group = grpPos)
startCap = input.float(1000.0, "Starting Capital $", minval = 1.0, step = 100.0, group = grpPos)
lotSize = input.float(0.01, "Lot Size", minval = 0.01, step = 0.01, group = grpPos, tooltip = "طلا: 1 لات استاندارد = 100 اونس؛ 0.01 لات یعنی 1 دلار سود به ازای هر 1 دلار حرکت قیمت")
goldOzPerLot = input.float(100.0, "Gold oz per 1.00 Lot", minval = 1.0, step = 1.0, group = grpPos)

grpDisp = "Display Settings"
displayMode = input.string("Setup", "Display Mode", options = ["Setup", "Signal"], group = grpDisp)
onlyLast = input.bool(false, "Only Display the Last Position", group = grpDisp, tooltip = "اگر روشن باشد فقط آخرین ستاپ می‌ماند")
bullCss = input.color(color.new(#13a886, 0), "Bullish", group = grpDisp)
bearCss = input.color(color.new(#f23645, 0), "Bearish", group = grpDisp)
boxTransp = input.int(85, "Spike Box Transparency", minval = 50, maxval = 95, group = grpDisp)
lvlTransp = input.int(20, "Level Line Transparency", minval = 0, maxval = 80, group = grpDisp)

// ================================================================================================
// Types
// ================================================================================================

type Setup
    int dir = 0
    int phase = 0
    int startBar = 0
    int endBar = 0
    float origin = na
    float extreme = na
    float spikeSize = na
    int pairId = 0
    color pairCss = na
    float corrPx = na
    int corrBar = 0
    bool corrHadBounce = false
    bool corrPending = false
    float entry = na
    int entryBar = 0
    float sl = na
    float tpL2 = na
    float tp1 = na
    float tp2 = na
    array<float> lvlPx = na
    array<int> lvlBar = na
    array<bool> lvlUsed = na
    box bSpike = na
    array<line> lvlLines = na
    array<label> labels = na
    line lnEntry = na
    line lnSl = na
    line lnL2 = na
    line lnTp1 = na
    line lnTp2 = na

type ZzPt
    int bar = 0
    float px = na
    bool isHigh = false

type ZzLeg
    int dir = 0
    int x1 = 0
    int x2 = 0
    float y1 = na
    float y2 = na
    line ln = na
    label lb = na

var Setup cur = Setup.new()
var array<Setup> hist = array.new<Setup>()
var array<ZzPt> zzPts = array.new<ZzPt>()
var array<ZzLeg> zzLegs = array.new<ZzLeg>()
var line zzLive = na
var line zzL2proj = na
var label zzL2lbl = na
var int zzDir = 0
var int zzStartBar = 0
var float zzStartPx = na
var int zzExtBar = 0
var float zzExtPx = na
var int pairSeq = 0
var int statTrades = 0
var int statWins = 0
var float statPnl = 0.0
var table wrTbl = table.new(position.top_right, 2, 7, color.new(#131722, 15), color.new(#787B86, 40), 1, color.new(#131722, 15), 1)

// phase: 0 empty, 1 forming, 2 wait retest, 3 in trade, 4 closed

// ================================================================================================
// Helpers
// ================================================================================================

windowHigh(int newest, int oldest) =>
    float m = high[newest]
    if oldest >= newest
        for i = newest to oldest
            m := math.max(m, high[i])
    m

windowLow(int newest, int oldest) =>
    float m = low[newest]
    if oldest >= newest
        for i = newest to oldest
            m := math.min(m, low[i])
    m

validateSpike(int dir, int newest, int oldest, float atrNow) =>
    int len = oldest - newest + 1
    bool ok = len >= minSpikeBars
    int dirBars = 0
    if oldest >= newest
        for i = newest to oldest
            bool up = close[i] > open[i]
            bool down = close[i] < open[i]
            if dir == 1 and up or dir == -1 and down
                dirBars += 1
    ok := ok and (len <= 0 or dirBars / len >= minDirRatio)
    float orig = dir == 1 ? windowLow(newest, oldest) : windowHigh(newest, oldest)
    float ext = dir == 1 ? windowHigh(newest, oldest) : windowLow(newest, oldest)
    float size = math.abs(ext - orig)
    ok := ok and size > 0
    if useMovePower
        ok := ok and atrNow > 0 and size / atrNow >= movePowerLevel
    ok

deleteLines(array<line> arr) =>
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)
    true

deleteLabels(array<label> arr) =>
    if not na(arr) and array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)
    true

clearDraw(Setup s) =>
    if not na(s.bSpike)
        box.delete(s.bSpike)
        s.bSpike := na
    deleteLines(s.lvlLines)
    deleteLabels(s.labels)
    if not na(s.lnEntry)
        line.delete(s.lnEntry)
        s.lnEntry := na
    if not na(s.lnSl)
        line.delete(s.lnSl)
        s.lnSl := na
    if not na(s.lnL2)
        line.delete(s.lnL2)
        s.lnL2 := na
    if not na(s.lnTp1)
        line.delete(s.lnTp1)
        s.lnTp1 := na
    if not na(s.lnTp2)
        line.delete(s.lnTp2)
        s.lnTp2 := na
    true

initArrays(Setup s) =>
    if na(s.lvlPx)
        s.lvlPx := array.new<float>()
        s.lvlBar := array.new<int>()
        s.lvlUsed := array.new<bool>()
        s.lvlLines := array.new<line>()
        s.labels := array.new<label>()
    true

resetSetup(Setup s) =>
    clearDraw(s)
    s.dir := 0
    s.phase := 0
    s.startBar := 0
    s.endBar := 0
    s.origin := na
    s.extreme := na
    s.spikeSize := na
    s.pairId := 0
    s.pairCss := na
    s.corrPx := na
    s.corrBar := 0
    s.corrHadBounce := false
    s.corrPending := false
    s.entry := na
    s.entryBar := 0
    s.sl := na
    s.tpL2 := na
    s.tp1 := na
    s.tp2 := na
    if not na(s.lvlPx)
        array.clear(s.lvlPx)
        array.clear(s.lvlBar)
        array.clear(s.lvlUsed)
    true

nearPx(float a, float b) =>
    math.abs(a - b) <= math.max(syminfo.mintick * 4, (high - low) * 0.02)

rebuildLevels(Setup s, int newest, int oldest) =>
    initArrays(s)
    array.clear(s.lvlPx)
    array.clear(s.lvlBar)
    array.clear(s.lvlUsed)
    float px = na
    int b = 0
    if oldest >= newest
        if s.dir == 1
            float runHigh = high[oldest]
            float corrLow = na
            int corrBar = 0
            for i = oldest to newest
                if high[i] >= runHigh
                    if not na(corrLow)
                        px := corrLow
                        b := corrBar
                        corrLow := na
                    runHigh := high[i]
                else if na(corrLow) or low[i] <= corrLow
                    corrLow := low[i]
                    corrBar := bar_index - i
        else
            float runLow = low[oldest]
            float corrHigh = na
            int corrBar = 0
            for i = oldest to newest
                if low[i] <= runLow
                    if not na(corrHigh)
                        px := corrHigh
                        b := corrBar
                        corrHigh := na
                    runLow := low[i]
                else if na(corrHigh) or high[i] >= corrHigh
                    corrHigh := high[i]
                    corrBar := bar_index - i
    if not na(px)
        array.push(s.lvlPx, px)
        array.push(s.lvlBar, b)
        array.push(s.lvlUsed, false)
    true

fillSpike(Setup s, int dir, int newest, int oldest) =>
    initArrays(s)
    s.dir := dir
    s.startBar := bar_index - oldest
    s.endBar := bar_index - newest
    s.origin := dir == 1 ? windowLow(newest, oldest) : windowHigh(newest, oldest)
    s.extreme := dir == 1 ? windowHigh(newest, oldest) : windowLow(newest, oldest)
    s.spikeSize := math.abs(s.extreme - s.origin)
    rebuildLevels(s, newest, oldest)
    true

zzNewest(int endBar) =>
    math.max(bar_index - endBar, 0)

zzOldest(int startBar, int endBar) =>
    math.max(bar_index - startBar, zzNewest(endBar))

pairCssOf(int id) =>
    int i = int(math.abs(id)) % 8
    color c = #29B6F6
    if i == 1
        c := #FFD54F
    else if i == 2
        c := #CE93D8
    else if i == 3
        c := #26A69A
    else if i == 4
        c := #FF8A65
    else if i == 5
        c := #5C6BC0
    else if i == 6
        c := #EC407A
    else if i == 7
        c := #9CCC65
    c

fillZzSpike(Setup s, int dir, int startBar, int endBar, float origin, float extreme) =>
    initArrays(s)
    s.dir := dir
    s.startBar := startBar
    s.endBar := endBar
    s.origin := origin
    s.extreme := extreme
    s.spikeSize := math.abs(extreme - origin)
    s.corrPx := na
    s.corrBar := 0
    s.corrHadBounce := false
    s.corrPending := false
    if not na(s.lvlPx)
        array.clear(s.lvlPx)
        array.clear(s.lvlBar)
        array.clear(s.lvlUsed)
    true

updateCorrExtreme(Setup s) =>
    if s.phase == 2 and bar_index > s.endBar
        if s.dir == 1
            if na(s.corrPx) or low < s.corrPx
                s.corrPx := low
                s.corrBar := bar_index
                if s.corrPending
                    s.corrPending := false
                    s.corrHadBounce := true
        else
            if na(s.corrPx) or high > s.corrPx
                s.corrPx := high
                s.corrBar := bar_index
                if s.corrPending
                    s.corrPending := false
                    s.corrHadBounce := true
    true

zzSpikeValid(int dir, int startBar, int endBar, float origin, float extreme, float atrNow) =>
    int newest = zzNewest(endBar)
    int oldest = zzOldest(startBar, endBar)
    int len = oldest - newest + 1
    bool ok = endBar > startBar and validateSpike(dir, newest, oldest, atrNow)
    ok := ok and len <= maxSpikeBars
    ok := ok and math.abs(extreme - origin) >= atrNow * minLegAtr
    ok

cssOf(int dir) =>
    dir == 1 ? bullCss : bearCss

pairOf(Setup s) =>
    na(s.pairCss) ? cssOf(s.dir) : s.pairCss

fade(color c, int transp) =>
    color.new(c, transp)

drawLabel(Setup s, int x, float y, string txt, color c, string style) =>
    label lb = label.new(x, y, txt, xloc.bar_index, yloc.price, c, style, color.white, size.small)
    array.push(s.labels, lb)
    true

redrawSetup(Setup s) =>
    clearDraw(s)
    initArrays(s)
    if s.dir == 0 or s.phase == 0
        true
    else
        bool showSetup = displayMode == "Setup"
        bool showSignal = displayMode == "Signal"
        bool inTrade = s.phase == 3 or s.phase == 4
        bool show = showSetup or (showSignal and inTrade)
        color c = pairOf(s)
        if show and (showSetup or inTrade)
            if showSetup or s.phase >= 2
                float top = math.max(s.origin, s.extreme)
                float bot = math.min(s.origin, s.extreme)
                int x2 = s.phase >= 4 ? math.max(s.endBar, s.entryBar) : math.max(s.endBar, bar_index)
                s.bSpike := box.new(s.startBar, top, x2, bot, border_color = fade(c, 60), bgcolor = fade(c, boxTransp), border_width = 1)
                int midX = math.round(math.avg(s.startBar, s.endBar))
                float midY = math.avg(s.origin, s.extreme)
                drawLabel(s, midX, midY, "L1", fade(c, 0), s.dir == 1 ? label.style_label_up : label.style_label_down)
            if inTrade
                int x1e = s.entryBar
                int x2e = bar_index
                string ext = s.phase >= 4 ? extend.none : extend.right
                s.lnEntry := line.new(x1e, s.entry, x2e, s.entry, xloc.bar_index, ext, fade(c, 0), line.style_solid, 2)
                s.lnSl := line.new(x1e, s.sl, x2e, s.sl, xloc.bar_index, ext, color.new(color.red, 0), line.style_dotted, 2)
                s.lnL2 := line.new(x1e, s.tpL2, x2e, s.tpL2, xloc.bar_index, ext, fade(c, 0), line.style_solid, 2)
                if showTpRr
                    s.lnTp1 := line.new(x1e, s.tp1, x2e, s.tp1, xloc.bar_index, ext, color.new(color.orange, 20), line.style_dashed, 1)
                    s.lnTp2 := line.new(x1e, s.tp2, x2e, s.tp2, xloc.bar_index, ext, color.new(color.orange, 0), line.style_dashed, 1)
                drawLabel(s, x1e, s.entry, "Entry", fade(c, 0), label.style_label_left)
                drawLabel(s, x1e, s.sl, "SL", color.new(color.red, 0), label.style_label_left)
                drawLabel(s, x1e, s.tpL2, "L2", fade(c, 0), label.style_label_left)
        true

extendOpenDraw(Setup s) =>
    if s.dir == 0 or s.phase == 0 or s.phase == 4
        true
    else
        if not na(s.bSpike) and s.phase != 4
            box.set_right(s.bSpike, bar_index)
        if not na(s.lvlLines) and array.size(s.lvlLines) > 0 and (s.phase == 1 or s.phase == 2)
            for i = 0 to array.size(s.lvlLines) - 1
                line.set_x2(array.get(s.lvlLines, i), bar_index)
        if s.phase == 3
            if not na(s.lnEntry)
                line.set_x2(s.lnEntry, bar_index)
            if not na(s.lnSl)
                line.set_x2(s.lnSl, bar_index)
            if not na(s.lnL2)
                line.set_x2(s.lnL2, bar_index)
            if not na(s.lnTp1)
                line.set_x2(s.lnTp1, bar_index)
            if not na(s.lnTp2)
                line.set_x2(s.lnTp2, bar_index)
        true

archiveDraw(Setup s) =>
    if not na(s.bSpike)
        box.set_right(s.bSpike, bar_index)
    if not na(s.lnEntry)
        line.set_extend(s.lnEntry, extend.none)
        line.set_x2(s.lnEntry, bar_index)
    if not na(s.lnSl)
        line.set_extend(s.lnSl, extend.none)
        line.set_x2(s.lnSl, bar_index)
    if not na(s.lnL2)
        line.set_extend(s.lnL2, extend.none)
        line.set_x2(s.lnL2, bar_index)
    if not na(s.lnTp1)
        line.set_extend(s.lnTp1, extend.none)
        line.set_x2(s.lnTp1, bar_index)
    if not na(s.lnTp2)
        line.set_extend(s.lnTp2, extend.none)
        line.set_x2(s.lnTp2, bar_index)
    true

enterTrade(Setup s, float px) =>
    s.entry := px
    s.entryBar := bar_index
    s.phase := 3
    s.sl := s.origin
    float risk = math.max(math.abs(s.entry - s.sl), syminfo.mintick)
    if s.dir == 1
        s.tpL2 := s.entry + s.spikeSize * 0.9
        s.tp1 := s.entry + risk
        s.tp2 := s.entry + risk * rrRatio
    else
        s.tpL2 := s.entry - s.spikeSize * 0.9
        s.tp1 := s.entry - risk
        s.tp2 := s.entry - risk * rrRatio
    true

capHist() =>
    if array.size(hist) > 80
        clearDraw(array.get(hist, 0))
        array.shift(hist)
    true

clearHist() =>
    if array.size(hist) > 0
        for i = 0 to array.size(hist) - 1
            clearDraw(array.get(hist, i))
        array.clear(hist)
    true

legSizeOk(float y1, float y2, float atrNow) =>
    math.abs(y2 - y1) >= atrNow * minLegAtr

trimZzLegs() =>
    if array.size(zzLegs) > maxLegsKeep
        ZzLeg old = array.shift(zzLegs)
        if not na(old.ln)
            line.delete(old.ln)
        if not na(old.lb)
            label.delete(old.lb)
    true

redrawLastZzLeg() =>
    int n = array.size(zzLegs)
    int p = array.size(zzPts)
    if n > 0 and p >= 2
        ZzLeg lg = array.get(zzLegs, n - 1)
        ZzPt a = array.get(zzPts, p - 2)
        ZzPt b = array.get(zzPts, p - 1)
        if not na(lg.ln)
            line.set_xy1(lg.ln, a.bar, a.px)
            line.set_xy2(lg.ln, b.bar, b.px)
    true

pushZzLeg(ZzPt a, ZzPt b, float atrNow) =>
    int dir = b.px > a.px ? 1 : b.px < a.px ? -1 : 0
    bool ok = dir != 0 and legSizeOk(a.px, b.px, atrNow)
    if ok
        color c = fade(cssOf(dir), 0)
        line ln = showLegs ? line.new(a.bar, a.px, b.bar, b.px, xloc.bar_index, extend.none, c, line.style_solid, 2) : na
        array.push(zzLegs, ZzLeg.new(dir, a.bar, b.bar, a.px, b.px, ln, na))
        trimZzLegs()
    true

addZzPt(int b, float p, bool isHigh, float atrNow) =>
    int sz = array.size(zzPts)
    if sz > 0
        ZzPt last = array.get(zzPts, sz - 1)
        if last.isHigh == isHigh
            bool better = isHigh ? p >= last.px : p <= last.px
            if better
                array.set(zzPts, sz - 1, ZzPt.new(b, p, isHigh))
                redrawLastZzLeg()
            false
        else
            array.push(zzPts, ZzPt.new(b, p, isHigh))
            pushZzLeg(last, array.get(zzPts, array.size(zzPts) - 1), atrNow)
            true
    else
        array.push(zzPts, ZzPt.new(b, p, isHigh))
        true

confirmZzLeg(int dir, int startBar, int endBar, float origin, float extreme, float atrNow) =>
    if array.size(zzPts) == 0
        addZzPt(startBar, origin, dir == 1 ? false : true, atrNow)
    addZzPt(endBar, extreme, dir == 1 ? true : false, atrNow)

// ================================================================================================
// State
// ================================================================================================

bool spikeAlert = false
bool bosAlert = false
bool entryBuyAlert = false
bool entrySellAlert = false
bool tpAlert = false
bool slAlert = false

atrVal = ta.atr(atrLen)
float zzDevPx = zzDeviation * syminfo.mintick

bool zzJustConfirmed = false
int zzConfDir = 0
int zzConfStartBar = 0
int zzConfEndBar = 0
float zzConfOrig = na
float zzConfExt = na

if bar_index > zzDepth
    if zzDir == 0
        zzDir := close >= open ? 1 : -1
        zzStartBar := bar_index
        zzStartPx := zzDir == 1 ? low : high
        zzExtBar := bar_index
        zzExtPx := zzDir == 1 ? high : low
    else if zzDir == 1
        if high >= zzExtPx
            zzExtPx := high
            zzExtBar := bar_index
        float rise = zzExtPx - zzStartPx
        float retr = zzExtPx - low
        bool depthOk = bar_index - zzExtBar >= zzDepth
        bool backOk = bar_index - zzExtBar >= zzBackstep
        bool devOk = rise >= zzDevPx and retr >= zzDevPx
        if depthOk and backOk and devOk
            zzJustConfirmed := true
            zzConfDir := 1
            zzConfStartBar := zzStartBar
            zzConfEndBar := zzExtBar
            zzConfOrig := zzStartPx
            zzConfExt := zzExtPx
            confirmZzLeg(1, zzStartBar, zzExtBar, zzStartPx, zzExtPx, atrVal)
            zzDir := -1
            zzStartBar := zzExtBar
            zzStartPx := zzExtPx
            zzExtBar := bar_index
            zzExtPx := low
    else
        if low <= zzExtPx
            zzExtPx := low
            zzExtBar := bar_index
        float drop = zzStartPx - zzExtPx
        float retr = high - zzExtPx
        bool depthOk = bar_index - zzExtBar >= zzDepth
        bool backOk = bar_index - zzExtBar >= zzBackstep
        bool devOk = drop >= zzDevPx and retr >= zzDevPx
        if depthOk and backOk and devOk
            zzJustConfirmed := true
            zzConfDir := -1
            zzConfStartBar := zzStartBar
            zzConfEndBar := zzExtBar
            zzConfOrig := zzStartPx
            zzConfExt := zzExtPx
            confirmZzLeg(-1, zzStartBar, zzExtBar, zzStartPx, zzExtPx, atrVal)
            zzDir := 1
            zzStartBar := zzExtBar
            zzStartPx := zzExtPx
            zzExtBar := bar_index
            zzExtPx := high
    if zzJustConfirmed and showL2Proj
        if not na(zzL2proj)
            line.delete(zzL2proj)
            zzL2proj := na
        if not na(zzL2lbl)
            label.delete(zzL2lbl)
            zzL2lbl := na
        if array.size(zzLegs) >= 3
            int nzz = array.size(zzLegs)
            ZzLeg zLast = array.get(zzLegs, nzz - 1)
            ZzLeg zCorr = array.get(zzLegs, nzz - 2)
            ZzLeg zFirst = array.get(zzLegs, nzz - 3)
            if zLast.dir == zFirst.dir and zCorr.dir != zLast.dir
                float size1 = math.abs(zFirst.y2 - zFirst.y1) * 0.9
                float tgt = zLast.dir == 1 ? zLast.y1 + size1 : zLast.y1 - size1
                color zc = fade(cssOf(zLast.dir), 0)
                zzL2proj := line.new(zLast.x1, tgt, math.max(zLast.x2, bar_index), tgt, xloc.bar_index, extend.right, zc, line.style_dashed, 2)
                zzL2lbl := label.new(math.max(zLast.x2, bar_index), tgt, "L2 target", xloc.bar_index, yloc.price, zc, label.style_label_left, color.white, size.small)
    color lc = fade(cssOf(zzDir == 0 ? 1 : zzDir), 0)
    if showLegs
        if na(zzLive)
            zzLive := line.new(zzStartBar, zzStartPx, zzExtBar, zzExtPx, xloc.bar_index, extend.none, lc, line.style_solid, 2)
        else
            line.set_xy1(zzLive, zzStartBar, zzStartPx)
            line.set_xy2(zzLive, zzExtBar, zzExtPx)
            line.set_color(zzLive, lc)
    else if not na(zzLive)
        line.delete(zzLive)
        zzLive := na
    if showL2Proj and not na(zzL2proj)
        line.set_x2(zzL2proj, bar_index)

initArrays(cur)

if cur.phase == 3
    bool afterEntry = bar_index > cur.entryBar
    bool hitSl = afterEntry and (cur.dir == 1 ? low <= cur.sl : high >= cur.sl)
    bool hitL2 = cur.dir == 1 ? high >= cur.tpL2 : low <= cur.tpL2
    if hitSl or hitL2
        if hitL2
            tpAlert := true
        if hitSl and not hitL2
            slAlert := true
        statTrades += 1
        if tpAlert
            statWins += 1
        float exitPx = tpAlert ? cur.tpL2 : cur.sl
        float signedMove = cur.dir == 1 ? exitPx - cur.entry : cur.entry - exitPx
        statPnl += signedMove * lotSize * goldOzPerLot
        cur.phase := 4
        redrawSetup(cur)
        archiveDraw(cur)
        if onlyLast
            clearHist()
        array.push(hist, cur)
        capHist()
        cur := Setup.new()
        initArrays(cur)

if cur.phase == 2
    bool broken = cur.dir == 1 ? low < cur.origin : high > cur.origin
    bool expired = bar_index - cur.endBar > maxWaitBars
    if broken or expired
        resetSetup(cur)

bool newComplete = false
if zzJustConfirmed and (cur.phase == 0 or cur.phase == 1)
    if zzSpikeValid(zzConfDir, zzConfStartBar, zzConfEndBar, zzConfOrig, zzConfExt, atrVal)
        if onlyLast
            clearHist()
        fillZzSpike(cur, zzConfDir, zzConfStartBar, zzConfEndBar, zzConfOrig, zzConfExt)
        if cur.pairId == 0
            pairSeq += 1
            cur.pairId := pairSeq
            cur.pairCss := pairCssOf(pairSeq)
        cur.phase := 2
        spikeAlert := true
        bosAlert := true
        newComplete := true
        redrawSetup(cur)
    else if cur.phase == 1 and cur.dir == zzConfDir
        resetSetup(cur)

if not newComplete and (cur.phase == 0 or cur.phase == 1) and zzDir != 0
    if zzSpikeValid(zzDir, zzStartBar, zzExtBar, zzStartPx, zzExtPx, atrVal)
        if cur.phase == 0 and onlyLast
            clearHist()
        fillZzSpike(cur, zzDir, zzStartBar, zzExtBar, zzStartPx, zzExtPx)
        if cur.pairId == 0
            pairSeq += 1
            cur.pairId := pairSeq
            cur.pairCss := pairCssOf(pairSeq)
        cur.phase := 1
        redrawSetup(cur)
    else if cur.phase == 1
        resetSetup(cur)

updateCorrExtreme(cur)

if cur.phase == 2 and not na(cur.corrPx) and bar_index > cur.endBar
    bool stillValid = cur.dir == 1 ? low >= cur.origin : high <= cur.origin
    bool finishedOpp = zzJustConfirmed and zzConfDir != cur.dir
    bool enterNow = false
    if finishedOpp
        if cur.corrHadBounce
            enterNow := true
        else
            cur.corrPending := true
    else if zzJustConfirmed and zzConfDir == cur.dir and cur.corrPending
        float resumeSize = math.abs(zzConfExt - zzConfOrig)
        bool largeResume = resumeSize >= atrVal * minLegAtr and resumeSize >= cur.spikeSize * 0.35
        if largeResume
            enterNow := true
        else
            cur.corrPending := false
            cur.corrHadBounce := true
    if enterNow and stillValid
        enterTrade(cur, cur.corrPx)
        if cur.dir == 1
            entryBuyAlert := true
        else
            entrySellAlert := true
        redrawSetup(cur)

extendOpenDraw(cur)

plotshape(showEntryMarks and entryBuyAlert, "Buy", shape.triangleup, location.belowbar, bullCss, size = size.small)
plotshape(showEntryMarks and entrySellAlert, "Sell", shape.triangledown, location.abovebar, bearCss, size = size.small)
plotshape(tpAlert, "L2 Win", shape.circle, location.abovebar, color.new(#00E676, 0), size = size.tiny, display = display.all)

if barstate.islast
    int lost = statTrades - statWins
    float wrPct = statTrades > 0 ? statWins / statTrades * 100.0 : 0.0
    float equity = startCap + statPnl
    color pnlCss = statPnl >= 0 ? color.new(#00E676, 0) : color.new(#FF5252, 0)
    table.cell(wrTbl, 0, 0, "معاملات", text_color = color.white, text_halign = text.align_left)
    table.cell(wrTbl, 1, 0, str.tostring(statTrades), text_color = color.white, text_halign = text.align_right)
    table.cell(wrTbl, 0, 1, "موفق L2", text_color = color.new(#00E676, 0), text_halign = text.align_left)
    table.cell(wrTbl, 1, 1, str.tostring(statWins), text_color = color.new(#00E676, 0), text_halign = text.align_right)
    table.cell(wrTbl, 0, 2, "ناموفق", text_color = color.new(#FF5252, 0), text_halign = text.align_left)
    table.cell(wrTbl, 1, 2, str.tostring(lost), text_color = color.new(#FF5252, 0), text_halign = text.align_right)
    table.cell(wrTbl, 0, 3, "وین ریت", text_color = color.white, text_halign = text.align_left)
    table.cell(wrTbl, 1, 3, str.tostring(wrPct, "#.0") + " %", text_color = color.white, text_halign = text.align_right)
    table.cell(wrTbl, 0, 4, "لات طلا", text_color = color.white, text_halign = text.align_left)
    table.cell(wrTbl, 1, 4, str.tostring(lotSize, "#.00"), text_color = color.white, text_halign = text.align_right)
    table.cell(wrTbl, 0, 5, "سود کل $", text_color = pnlCss, text_halign = text.align_left)
    table.cell(wrTbl, 1, 5, str.tostring(statPnl, "#.2"), text_color = pnlCss, text_halign = text.align_right)
    table.cell(wrTbl, 0, 6, "مانده $", text_color = color.white, text_halign = text.align_left)
    table.cell(wrTbl, 1, 6, str.tostring(equity, "#.2"), text_color = color.white, text_halign = text.align_right)

alertcondition(spikeAlert, "SP2L Spike", "SP2L spike detected")
alertcondition(bosAlert, "SP2L Spike Complete", "SP2L spike completed — waiting for HL/LH retest")
alertcondition(entryBuyAlert, "SP2L Buy", "SP2L buy entry — HL retest")
alertcondition(entrySellAlert, "SP2L Sell", "SP2L sell entry — LH retest")
alertcondition(tpAlert, "SP2L L2 Target", "SP2L second-leg target hit")
alertcondition(slAlert, "SP2L Stop", "SP2L stop-loss hit")
